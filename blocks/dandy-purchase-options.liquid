    { "type": "text", "id": "tier_3_title", "label": "Title", "default": "Buy 3, Get 2 FREE" },
    { "type": "textarea", "id": "tier_3_subtitle", "label": "Subtitle (one-time)", "default": "90 gummies\nSave $60 (1 Pouch Free)" },
