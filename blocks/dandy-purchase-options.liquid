{%- liquid
  assign product = closest.product
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign use_currency = settings.currency_code_enabled_product_pages
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif

  assign default_tab = block.settings.default_tab
  if has_plans == false
    assign default_tab = 'one_time'
  endif
  if product.requires_selling_plan and has_plans
    assign default_tab = 'subscribe'
  endif

  assign default_tier = block.settings.default_tier | plus: 0

  assign base_variant = product.variants[0]
  assign base_alloc = base_variant.selling_plan_allocations[0]
  assign save_pct = ''
  if base_alloc and base_variant.price > base_alloc.price
    assign save_pct = base_variant.price | minus: base_alloc.price | times: 100.0 | divided_by: base_variant.price | round | append: '%'
  endif

  comment
    Largest percent off across the three subscribe tiers (plan price against the variant compare-at).
    Feeds the [max] token on the Subscribe toggle tab; never typed in.
  endcomment
  assign max_sub = 0
  for i in (1..3)
    assign mk = 'tier_' | append: i
    assign mk_variant = mk | append: '_variant_id'
    assign mk_plan = mk | append: '_plan_index'
    assign mk_title = mk | append: '_title'
    if block.settings[mk_title] == blank
      continue
    endif
    assign m_idx = i | minus: 1
    assign mv = product.variants[m_idx]
    assign m_id = block.settings[mk_variant] | strip
    if m_id != blank
      for candidate in product.variants
        assign candidate_id = candidate.id | append: ''
        if candidate_id == m_id
          assign mv = candidate
        endif
      endfor
    endif
    if mv == blank
      continue
    endif
    assign m_plan_idx = block.settings[mk_plan] | plus: 0 | minus: 1
    assign m_alloc = mv.selling_plan_allocations[m_plan_idx] | default: mv.selling_plan_allocations[0]
    if m_alloc != blank
      assign m_cmp = m_alloc.compare_at_price | default: mv.price
      if mv.compare_at_price > m_cmp
        assign m_cmp = mv.compare_at_price
      endif
      if m_cmp > m_alloc.price
        assign m_pct = m_cmp | minus: m_alloc.price | times: 100.0 | divided_by: m_cmp | round
        if m_pct > max_sub
          assign max_sub = m_pct
        endif
      endif
    endif
  endfor
  assign max_sub_str = ''
  if max_sub > 0
    assign max_sub_str = max_sub | append: '%'
  endif

  comment
    Subscribe toggle tab: the computed "Up to N% off"; the old "Save 20%" style text when no tier has a compare-at price.
  endcomment
  assign save_badge = block.settings.save_badge
  if save_badge contains '[max]' and max_sub_str == ''
    assign save_badge = block.settings.save_badge_fallback
  endif
  assign save_badge = save_badge | replace: '[max]', max_sub_str | replace: '[discount]', save_pct | strip
  assign subscribe_title = block.settings.subscribe_panel_title | replace: '[discount]', save_pct | strip
  assign subscribe_tab_label = block.settings.subscribe_tab_label | replace: '[discount]', save_pct | strip
  assign layout = block.settings.layout | default: 'tabs'
  assign sub_note = block.settings.sub_note | strip
-%}

<dandy-purchase-options
  class="dandy-purchase"
  data-form-id="{{ form_id }}"
  data-default-tier="{{ default_tier }}"
  data-layout="{{ layout }}"
  data-sub-note="{{ sub_note | escape }}"
  data-dandy-block="purchase-{{ block.id }}"
  {%- if block.settings.bundle_gate %} data-bundle-gate{% endif %}
  {{ block.shopify_attributes }}
>
  <input
    type="hidden"
    name="selling_plan"
    form="{{ form_id }}"
    value=""
    data-selling-plan-input
    disabled
  >

  <style>
    .dandy-purchase .dandy-tab__badge { width: auto; min-width: 112px; padding-inline: 8px; max-width: 100%; box-sizing: border-box; }
    {%- if block.settings.bundle_gate %}
    /* Bundle gate (snippets/dandy-bundle-gate.liquid): without html.dandy-bundles-on only Pack 1 shows,
       and the theme's quantity stepper sits above the add to cart button. */
    html:not(.dandy-bundles-on) .dandy-purchase[data-bundle-gate] .dandy-tier:not([data-dandy-tier="1"]) { display: none; }
    html:not(.dandy-bundles-on) .dandy-pdp:has(.dandy-purchase[data-bundle-gate]) .product-form-buttons > .quantity-selector-wrapper { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 12px; }
    html:not(.dandy-bundles-on) .dandy-pdp:has(.dandy-purchase[data-bundle-gate]) .product-form-buttons > .quantity-selector-wrapper::before { content: 'Quantity'; font-family: var(--dandy-font-body); font-weight: 700; font-size: 18px; }
    html:not(.dandy-bundles-on) .dandy-pdp:has(.dandy-purchase[data-bundle-gate]) .quantity-selector { display: inline-flex; align-items: center; width: 148px; height: 48px; flex: 0 0 auto; border: 2px solid var(--dandy-ink, #241914); border-radius: 4px; background: #fff; }
    html:not(.dandy-bundles-on) .dandy-pdp:has(.dandy-purchase[data-bundle-gate]) .quantity-selector button { flex: 0 0 44px; height: 100%; display: grid; place-items: center; color: var(--dandy-ink, #241914); }
    html:not(.dandy-bundles-on) .dandy-pdp:has(.dandy-purchase[data-bundle-gate]) .quantity-selector input { flex: 1 1 auto; width: 100%; min-width: 0; height: 100%; border: 0; background: transparent; color: var(--dandy-ink, #241914); text-align: center; font-family: var(--dandy-font-body); font-size: 18px; font-weight: 700; -moz-appearance: textfield; }
    html:not(.dandy-bundles-on) .dandy-pdp:has(.dandy-purchase[data-bundle-gate]) .quantity-selector input::-webkit-inner-spin-button,
    html:not(.dandy-bundles-on) .dandy-pdp:has(.dandy-purchase[data-bundle-gate]) .quantity-selector input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    {%- endif %}
  </style>
  <fieldset class="dandy-purchase__fieldset">
    <legend class="visually-hidden">{{ block.settings.legend }}</legend>

    {%- if has_plans and layout == 'toggle' -%}
      <div class="dandy-toggle" role="radiogroup" aria-label="{{ block.settings.legend | escape }}">
        <label class="dandy-toggle__row{% if default_tab == 'subscribe' %} is-active{% endif %}">
          <input
            type="radio"
            class="dandy-toggle__input"
            name="dandy-purchase-mode-{{ block.id }}"
            value="subscribe"
            data-dandy-tab="subscribe"
            {% if default_tab == 'subscribe' %}checked{% endif %}
          >
          <span class="dandy-toggle__text">
            <span class="dandy-toggle__label">{{ subscribe_tab_label | escape }}</span>
            {%- if block.settings.toggle_sub_note != blank -%}
              <span class="dandy-toggle__note">{{ block.settings.toggle_sub_note | escape }}</span>
            {%- endif -%}
          </span>
        </label>
        {%- unless product.requires_selling_plan -%}
          <label class="dandy-toggle__row{% if default_tab == 'one_time' %} is-active{% endif %}">
            <input
              type="radio"
              class="dandy-toggle__input"
              name="dandy-purchase-mode-{{ block.id }}"
              value="one_time"
              data-dandy-tab="one_time"
              {% if default_tab == 'one_time' %}checked{% endif %}
            >
            <span class="dandy-toggle__text">
              <span class="dandy-toggle__label">{{ block.settings.one_time_tab_label | escape }}</span>
            </span>
          </label>
        {%- endunless -%}
      </div>
    {%- elsif has_plans -%}
      <div class="dandy-tabs{% if save_badge == blank %} dandy-tabs--plain{% endif %}" role="tablist" aria-label="{{ block.settings.legend | escape }}">
        <span class="dandy-tab-wrap{% if default_tab == 'one_time' %} is-active{% endif %}">
          <button
            type="button"
            class="dandy-tab dandy-tab--left{% if default_tab == 'one_time' %} is-active{% endif %}"
            role="tab"
            data-dandy-tab="one_time"
            aria-selected="{% if default_tab == 'one_time' %}true{% else %}false{% endif %}"
          >{{ block.settings.one_time_tab_label | escape }}</button>
        </span>
        <span class="dandy-tab-wrap dandy-tab-wrap--badged{% if default_tab == 'subscribe' %} is-active{% endif %}">
          {%- if save_badge != blank -%}
            <span class="dandy-tab__badge" aria-hidden="true">{{ save_badge | escape }}</span>
          {%- endif -%}
          <button
            type="button"
            class="dandy-tab dandy-tab--right{% if default_tab == 'subscribe' %} is-active{% endif %}"
            role="tab"
            data-dandy-tab="subscribe"
            aria-selected="{% if default_tab == 'subscribe' %}true{% else %}false{% endif %}"
          >{{ subscribe_tab_label | escape }}</button>
        </span>
      </div>
    {%- endif -%}

    {%- unless product.requires_selling_plan and has_plans -%}
      <div class="dandy-panel{% if block.settings.one_time_panel_title == blank %} dandy-panel--bare{% endif %}{% if default_tab == 'one_time' %} is-active{% endif %}" data-dandy-panel="one_time">
        {%- if block.settings.one_time_panel_title != blank -%}
          <p class="dandy-panel__title">{{ block.settings.one_time_panel_title | escape }}</p>
          <hr class="dandy-panel__divider">
        {%- endif -%}
        <div class="dandy-tiers">
          {%- for i in (1..3) -%}
            {%- liquid
              assign k = 'tier_' | append: i
              assign key_title = k | append: '_title'
              assign key_sub = k | append: '_subtitle'
              assign key_image = k | append: '_image'
              assign key_badge = k | append: '_badge'
              assign key_badge_style = k | append: '_badge_style'
              assign key_perks = k | append: '_perks'
              assign key_variant = k | append: '_variant_id'

              assign t_title = block.settings[key_title]
              assign t_sub = block.settings[key_sub]
              assign t_image = block.settings[key_image]
              assign t_badge = block.settings[key_badge]
              assign t_badge_style = block.settings[key_badge_style]
              assign t_perks = block.settings[key_perks] | newline_to_br | split: '<br />'
              assign t_variant_id = block.settings[key_variant] | strip

              assign idx = i | minus: 1
              assign v = product.variants[idx]
              if t_variant_id != blank
                for candidate in product.variants
                  assign candidate_id = candidate.id | append: ''
                  if candidate_id == t_variant_id
                    assign v = candidate
                  endif
                endfor
              endif

              comment
                [save] and [pct] in a subtitle or badge are computed from this tier's price and struck price
                (percent rounded to the whole percent), never typed in. A tokened line or badge is dropped when
                the tier has no struck price.
              endcomment
              assign tok_save = ''
              assign tok_pct = ''
              assign tok_price = 0
              assign tok_compare = 0
              if v != blank
                assign tok_price = v.price
                assign tok_compare = v.compare_at_price | default: 0
              endif
              if tok_compare > tok_price
                assign tok_cents = tok_compare | minus: tok_price
                assign tok_save = tok_cents | money_without_trailing_zeros
                assign tok_pct = tok_cents | times: 100.0 | divided_by: tok_compare | round
              endif
              if tok_save == ''
                if t_badge contains '[save]' or t_badge contains '[pct]'
                  assign t_badge = ''
                endif
              endif
              assign t_badge = t_badge | replace: '[save]', tok_save | replace: '[pct]', tok_pct

              assign t_selected = false
              if i == default_tier
                assign t_selected = true
              endif
            -%}
            {%- if t_title != blank and v != blank -%}
              {%- capture price_label -%}{%- if use_currency -%}{{ v.price | money_with_currency }}{%- else -%}{{ v.price | money }}{%- endif -%}{%- endcapture -%}
              <button
                type="button"
                class="dandy-tier{% if t_badge != blank %} dandy-tier--badged{% endif %}{% if t_perks.size > 0 %} dandy-tier--perks{% endif %}{% if t_selected %} is-selected{% endif %}{% unless v.available %} is-unavailable{% endunless %}"
                data-dandy-tier="{{ i }}"
                data-variant-id="{{ v.id }}"
                data-plan-id=""
                data-price-cents="{{ v.price }}"
                data-price-label="{{ price_label | strip_html | strip | escape }}"
                aria-pressed="{% if t_selected %}true{% else %}false{% endif %}"
                {% unless v.available %}disabled{% endunless %}
              >
                {%- if t_badge != blank -%}
                  <span class="dandy-tier__badge dandy-tier__badge--{{ t_badge_style }}">{{ t_badge | escape }}</span>
                {%- endif -%}
                <span class="dandy-tier__media" aria-hidden="true">
                  {%- if t_image != blank -%}
                    {{ t_image | image_url: width: 400 | image_tag: widths: '174, 261, 348', sizes: '87px', alt: '', loading: 'eager', fetchpriority: 'low' }}
                  {%- endif -%}
                </span>
                <span class="dandy-tier__info">
                  <span class="dandy-tier__title">{{ t_title | escape }}</span>
                  {%- if t_sub != blank -%}
                    {%- assign sub_lines = t_sub | strip | newline_to_br | split: '<br />' -%}
                    <span class="dandy-tier__sub">
                      {%- for line in sub_lines -%}
                        {%- assign line_text = line | strip -%}
                        {%- if tok_save == '' -%}
                          {%- if line_text contains '[save]' or line_text contains '[pct]' -%}{%- assign line_text = '' -%}{%- endif -%}
                        {%- endif -%}
                        {%- assign line_text = line_text | replace: '[save]', tok_save | replace: '[pct]', tok_pct -%}
                        {%- if line_text != blank -%}
                          <span class="dandy-tier__sub-line">{{ line_text | escape }}</span>
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                  {%- endif -%}
                </span>
                <span class="dandy-tier__prices">
                  <span class="dandy-tier__price">
                    {%- if v.available == false -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- else -%}
                      {{ price_label }}
                    {%- endif -%}
                  </span>
                  {%- if v.compare_at_price > v.price -%}
                    <s class="dandy-tier__compare">
                      {%- if use_currency -%}{{ v.compare_at_price | money_with_currency }}{%- else -%}{{ v.compare_at_price | money }}{%- endif -%}
                    </s>
                  {%- endif -%}
                </span>
                {%- if t_perks.size > 0 -%}
                  <span class="dandy-tier__perks">
                    {%- for p in t_perks -%}
                      {%- assign pt = p | strip -%}
                      {%- if pt != blank -%}
                        <span class="dandy-tier__perk">
                          {%- if block.settings.perk_icon != blank -%}
                            {{ block.settings.perk_icon | image_url: width: 112 | image_tag: alt: '', width: 14, height: 14, loading: 'lazy' }}
                          {%- endif -%}
                          <span>{{ pt | escape }}</span>
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endunless -%}

    {%- if has_plans -%}
      <div class="dandy-panel{% if subscribe_title == blank %} dandy-panel--bare{% endif %}{% if default_tab == 'subscribe' %} is-active{% endif %}" data-dandy-panel="subscribe">
        {%- if subscribe_title != blank -%}
          <p class="dandy-panel__title">{{ subscribe_title | escape }}</p>
          <hr class="dandy-panel__divider">
        {%- endif -%}
        <div class="dandy-tiers">
          {%- for i in (1..3) -%}
            {%- liquid
              assign k = 'tier_' | append: i
              assign key_title = k | append: '_title'
              assign key_sub = k | append: '_sub_subtitle'
              assign key_image = k | append: '_image'
              assign key_badge = k | append: '_badge'
              assign key_badge_style = k | append: '_badge_style'
              assign key_perks = k | append: '_sub_perks'
              assign key_badge = k | append: '_sub_badge'
              assign key_variant = k | append: '_variant_id'
              assign key_plan = k | append: '_plan_index'

              assign t_title = block.settings[key_title]
              assign t_sub = block.settings[key_sub]
              assign t_image = block.settings[key_image]
              assign t_badge = block.settings[key_badge]
              assign t_badge_style = block.settings[key_badge_style]
              assign t_perks = block.settings[key_perks] | newline_to_br | split: '<br />'
              assign t_variant_id = block.settings[key_variant] | strip

              assign idx = i | minus: 1
              assign v = product.variants[idx]
              if t_variant_id != blank
                for candidate in product.variants
                  assign candidate_id = candidate.id | append: ''
                  if candidate_id == t_variant_id
                    assign v = candidate
                  endif
                endfor
              endif

              assign plan_idx = block.settings[key_plan] | plus: 0 | minus: 1
              assign alloc = v.selling_plan_allocations[plan_idx]
              if alloc == blank
                assign alloc = v.selling_plan_allocations[0]
              endif

              comment
                [save] and [pct] in a subtitle or badge are computed from this tier's price and struck price
                (percent rounded to the whole percent), never typed in. A tokened line or badge is dropped when
                the tier has no struck price.
              endcomment
              assign tok_save = ''
              assign tok_pct = ''
              assign tok_price = 0
              assign tok_compare = 0
              if v != blank and alloc != blank
                assign tok_price = alloc.price
                comment
                  The subscribe tier strikes the variant's real compare-at price when it has one;
                  otherwise Shopify's allocation compare-at (the one-time price).
                endcomment
                assign tok_compare = alloc.compare_at_price | default: v.price
                if v.compare_at_price > tok_compare
                  assign tok_compare = v.compare_at_price
                endif
              endif
              if tok_compare > tok_price
                assign tok_cents = tok_compare | minus: tok_price
                assign tok_save = tok_cents | money_without_trailing_zeros
                assign tok_pct = tok_cents | times: 100.0 | divided_by: tok_compare | round
              endif
              if tok_save == ''
                if t_badge contains '[save]' or t_badge contains '[pct]'
                  assign t_badge = ''
                endif
              endif
              assign t_badge = t_badge | replace: '[save]', tok_save | replace: '[pct]', tok_pct

              assign t_selected = false
              if i == default_tier
                assign t_selected = true
              endif
            -%}
            {%- if t_title != blank and v != blank and alloc != blank -%}
              {%- assign compare_price = tok_compare -%}
              {%- capture price_label -%}{%- if use_currency -%}{{ alloc.price | money_with_currency }}{%- else -%}{{ alloc.price | money }}{%- endif -%}{%- endcapture -%}
              {%- assign plan_days = '' -%}
              {%- if alloc.selling_plan.name contains ' days' -%}
                {%- assign plan_days = alloc.selling_plan.name | split: ' days' | first | split: ' ' | last -%}
              {%- endif -%}
              <button
                type="button"
                class="dandy-tier dandy-tier--sub{% if t_badge != blank %} dandy-tier--badged{% endif %}{% if t_perks.size > 0 %} dandy-tier--perks{% endif %}{% if t_selected %} is-selected{% endif %}{% unless v.available %} is-unavailable{% endunless %}"
                data-dandy-tier="{{ i }}"
                data-variant-id="{{ v.id }}"
                data-plan-id="{{ alloc.selling_plan.id }}"
                data-plan-days="{{ plan_days | escape }}"
                data-price-cents="{{ alloc.price }}"
                data-price-label="{{ price_label | strip_html | strip | escape }}"
                aria-pressed="{% if t_selected %}true{% else %}false{% endif %}"
                {% unless v.available %}disabled{% endunless %}
              >
                {%- if t_badge != blank -%}
                  <span class="dandy-tier__badge dandy-tier__badge--{{ t_badge_style }}">{{ t_badge | escape }}</span>
                {%- endif -%}
                <span class="dandy-tier__media" aria-hidden="true">
                  {%- if t_image != blank -%}
                    {{ t_image | image_url: width: 400 | image_tag: widths: '174, 261, 348', sizes: '87px', alt: '', loading: 'eager', fetchpriority: 'low' }}
                  {%- endif -%}
                </span>
                <span class="dandy-tier__info">
                  <span class="dandy-tier__title">{{ t_title | escape }}</span>
                  {%- if t_sub != blank -%}
                    {%- assign sub_lines = t_sub | replace: '[plan]', alloc.selling_plan.name | strip | newline_to_br | split: '<br />' -%}
                    <span class="dandy-tier__sub">
                      {%- for line in sub_lines -%}
                        {%- assign line_text = line | strip -%}
                        {%- if tok_save == '' -%}
                          {%- if line_text contains '[save]' or line_text contains '[pct]' -%}{%- assign line_text = '' -%}{%- endif -%}
                        {%- endif -%}
                        {%- assign line_text = line_text | replace: '[save]', tok_save | replace: '[pct]', tok_pct -%}
                        {%- if line_text != blank -%}
                          <span class="dandy-tier__sub-line">{{ line_text | escape }}</span>
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                  {%- endif -%}
                </span>
                <span class="dandy-tier__prices">
                  <span class="dandy-tier__price">
                    {%- if v.available == false -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- else -%}
                      {{ price_label }}
                    {%- endif -%}
                  </span>
                  {%- if compare_price > alloc.price -%}
                    <s class="dandy-tier__compare">
                      {%- if use_currency -%}{{ compare_price | money_with_currency }}{%- else -%}{{ compare_price | money }}{%- endif -%}
                    </s>
                  {%- endif -%}
                </span>
                {%- if t_perks.size > 0 -%}
                  <span class="dandy-tier__perks">
                    {%- for p in t_perks -%}
                      {%- assign pt = p | strip -%}
                      {%- if pt != blank -%}
                        <span class="dandy-tier__perk">
                          {%- if block.settings.perk_icon != blank -%}
                            {{ block.settings.perk_icon | image_url: width: 112 | image_tag: alt: '', width: 14, height: 14, loading: 'lazy' }}
                          {%- endif -%}
                          <span>{{ pt | escape }}</span>
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </fieldset>
</dandy-purchase-options>

<script>
  if (!customElements.get('dandy-purchase-options')) {
    customElements.define('dandy-purchase-options', class extends HTMLElement {
      connectedCallback() {
        this.planInput = this.querySelector('[data-selling-plan-input]');
        // Bundle gate: without html.dandy-bundles-on only Pack 1 is on offer, bought in any quantity.
        this.gated = this.hasAttribute('data-bundle-gate') && !document.documentElement.classList.contains('dandy-bundles-on');
        this.tier = this.gated ? '1' : (this.dataset.defaultTier || '1');
        if (!this.gated) {
          // A campaign link that names the pack it sold (bundle=, qty= or variant=) opens on that pack.
          const params = new URLSearchParams(window.location.search);
          const wanted = params.get('bundle') || params.get('qty');
          const variant = params.get('variant');
          const byVariant = variant && this.querySelector('[data-dandy-tier][data-variant-id="' + variant.replace(/\D/g, '') + '"]');
          if (/^[123]$/.test(wanted || '')) this.tier = wanted;
          else if (byVariant) this.tier = byVariant.dataset.dandyTier;
        }
        if (this.gated) {
          const redecorate = (event) => {
            if (event.target.closest && event.target.closest('.quantity-selector')) setTimeout(() => this.decorate(), 0);
          };
          ['click', 'input', 'change', 'focusout'].forEach((type) => document.addEventListener(type, redecorate));
        }
        this.tab = this.querySelector('.dandy-panel.is-active')?.dataset.dandyPanel || 'one_time';
        this.addEventListener('click', this.onClick.bind(this));
        this.addEventListener('change', this.onClick.bind(this));
        this.apply(false);
        // The theme re-renders the add to cart button after a variant change, which drops the price.
        // Watch the product details column and put the price and the subscription note back.
        const host = this.closest('.dandy-pdp__details') || this.parentElement;
        if (host && 'MutationObserver' in window) {
          this.observer = new MutationObserver(() => this.decorate());
          this.observer.observe(host, { childList: true, subtree: true, characterData: true });
        }
        // The buy form renders after this block, so the first sync can find no form and the hidden
        // variant input keeps the product's first variant until a tap. Re-apply once the document is parsed.
        if (!this.form) {
          const retry = () => this.apply(false);
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', retry, { once: true });
          else setTimeout(retry, 0);
        }
      }

      get form() {
        return document.getElementById(this.dataset.formId);
      }

      onClick(event) {
        const tab = event.target.closest('[data-dandy-tab]');
        if (tab) {
          if (tab.type === 'radio' && !tab.checked) return;
          if (this.tab === tab.dataset.dandyTab && event.type === 'change') return;
          this.tab = tab.dataset.dandyTab;
          this.apply(true);
          return;
        }
        const tier = event.target.closest('[data-dandy-tier]');
        if (tier && !tier.disabled && !(this.gated && tier.dataset.dandyTier !== '1')) {
          this.tier = tier.dataset.dandyTier;
          this.apply(true);
        }
      }

      apply(commit) {
        this.querySelectorAll('[data-dandy-tab]').forEach((el) => {
          const active = el.dataset.dandyTab === this.tab;
          el.classList.toggle('is-active', active);
          if (el.type === 'radio') el.checked = active;
          else el.setAttribute('aria-selected', String(active));
          el.parentElement.classList.toggle('is-active', active);
        });

        let panel = null;
        this.querySelectorAll('[data-dandy-panel]').forEach((el) => {
          const active = el.dataset.dandyPanel === this.tab;
          el.classList.toggle('is-active', active);
          if (active) panel = el;
        });
        if (!panel) panel = this.querySelector('.dandy-panel');
        if (!panel) return;

        const tiers = panel.querySelectorAll('[data-dandy-tier]');
        if (this.gated) this.tier = '1';
        let current = panel.querySelector('[data-dandy-tier="' + this.tier + '"]:not([disabled])');
        if (!current && !this.gated) current = Array.from(tiers).find((el) => !el.disabled);
        if (!current) return;
        this.tier = current.dataset.dandyTier;

        tiers.forEach((el) => {
          const selected = el === current;
          el.classList.toggle('is-selected', selected);
          el.setAttribute('aria-pressed', String(selected));
        });

        this.current = current;
        this.sync(current, commit);
        this.decorate();
      }

      // Add to cart button carries the selected card's price (read from the card, never typed in);
      // on subscribe a delivery note sits under the button with the selected plan's day count.
      decorate() {
        const tier = this.current;
        const form = this.form;
        if (!tier || !form) return;

        const button = form.querySelector('button[name="add"]');
        const content = button && button.querySelector('.add-to-cart-text__content');
        if (content) {
          let price = tier.dataset.priceLabel || '';
          // Bundle gate: the button carries the total for the stepper's quantity (price label is "$49.99").
          const qtyInput = this.gated && (form.closest('.buy-buttons-block') || form).querySelector('input[name="quantity"]');
          const qty = qtyInput ? Math.max(1, parseInt(qtyInput.value, 10) || 1) : 1;
          const cents = Number(tier.dataset.priceCents) || 0;
          if (qty > 1 && cents && /^\$[\d,.]+$/.test(price)) {
            price = '$' + ((cents * qty) / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          }
          const label = price && !button.disabled && !tier.disabled ? '\u00b7 ' + price : '';
          let el = content.querySelector('[data-dandy-atc-price]');
          if (!el) {
            el = document.createElement('span');
            el.setAttribute('data-dandy-atc-price', '');
            el.className = 'dandy-atc-price';
            content.appendChild(document.createTextNode(' '));
            content.appendChild(el);
          }
          if (el.textContent !== label) el.textContent = label;
        }

        const anchor = form.closest('.buy-buttons-block') || form;
        const days = tier.dataset.planDays || '';
        const template = this.dataset.subNote || '';
        let text = '';
        if (tier.dataset.planId && template && (days || template.indexOf('[days]') === -1)) {
          text = template.replace('[days]', days);
        }
        let note = anchor.parentElement && anchor.parentElement.querySelector(':scope > [data-dandy-sub-note]');
        if (!text) {
          if (note && !note.hidden) note.hidden = true;
          return;
        }
        if (!note) {
          note = document.createElement('p');
          note.setAttribute('data-dandy-sub-note', '');
          note.className = 'dandy-sub-note';
        }
        if (note.previousElementSibling !== anchor) anchor.insertAdjacentElement('afterend', note);
        if (note.textContent !== text) note.textContent = text;
        if (note.hidden) note.hidden = false;
      }

      sync(tier, commit) {
        const form = this.form;
        if (!form) return;

        let variantInput = form.querySelector('[name="id"]');
        if (!variantInput) {
          variantInput = document.createElement('input');
          variantInput.type = 'hidden';
          variantInput.name = 'id';
          form.appendChild(variantInput);
        }
        if (variantInput.value !== tier.dataset.variantId) {
          variantInput.value = tier.dataset.variantId;
          if (commit) variantInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        if (this.planInput) {
          const planId = tier.dataset.planId || '';
          this.planInput.value = planId;
          this.planInput.disabled = planId === '';
        }
      }
    });
  }
</script>

