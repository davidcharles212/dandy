    { "type": "select", "id": "tier_3_badge_style", "label": "Badge color", "options": [ { "value": "orange", "label": "Orange" }, { "value": "dark", "label": "Dark" } ], "default": "dark" },
    { "type": "text", "id": "tier_3_sub_badge", "label": "Badge (subscribe)", "default": "BEST VALUE (SAVE $24)" },
    { "type": "textarea", "id": "tier_3_perks", "label": "Perks (one-time)", "default": "$1.06 per gummy\nFree shipping", "info": "One per line." },
    { "type": "textarea", "id": "tier_3_sub_perks", "label": "Perks (subscribe)", "default": "$1.06 per gummy\nFree shipping", "info": "One per line." },
    { "type": "text", "id": "tier_3_variant_id", "label": "Variant ID", "info": "Optional. Defaults to the 3rd variant." },
    { "type": "select", "id": "tier_3_plan_index", "label": "Selling plan", "options": [ { "value": "1", "label": "1st plan" }, { "value": "2", "label": "2nd plan" }, { "value": "3", "label": "3rd plan" } ], "default": "3" },
    { "type": "text", "id": "legend", "label": "Accessible group label", "default": "Purchase options" }
  ],
  "presets": [{ "name": "Dandy purchase options" }]
}
{% endschema %}