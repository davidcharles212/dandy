{%- comment -%}
  Dandy capsule offer: port of the gummy "1, 2, 3" offer box (dandy-gummy-offer)
  into the Ecom Landers PDP block system. 30-count jars only, tiers 1 / 2 / 3.
  Strength is a real link between the two capsule products (SEO-clean, works
  without JS). With JS, both products' tiers are server-rendered and the link
  becomes an in-page toggle (history.replaceState keeps the URL bookmarkable).
  Prices come from real variants; a tier whose variant is missing or
  unavailable is hidden rather than faked.

  Merged product (2026-09-13): when the product carries a "Strength" option,
  both strengths are variants of one product at one URL. The strength links
  become ?variant= links to the default tier of that strength, and the current
  strength comes from the selected variant. The two-product mode stays in
  place so the block keeps working on stores that have not merged.

  Reader rate: a shopper who arrives through /discount/CODE carries a
  discount_code cookie. When it matches the configured code, the notice shows
  and each tier shows the voucher price with the pre-voucher price struck
  through. Shopify truncates a percentage discount to the cent, so the voucher
  price is price - floor(price * percent / 100), which matches checkout.
{%- endcomment -%}
{%- liquid
  assign product = closest.product
  assign caps = block.settings.capsules_per_jar | default: 30
  assign reader_percent = block.settings.reader_percent | default: 0
  assign merged = false
  if product.options_by_name['Strength']
    assign merged = true
  endif
  assign is_90 = false
  if merged
    if product.selected_or_first_available_variant.option1 contains '90'
      assign is_90 = true
    endif
  elsif product.handle contains '90'
    assign is_90 = true
  endif
  assign strength_label = block.settings.strength_50_label
  if is_90
    assign strength_label = block.settings.strength_90_label
  endif
  assign default_tier = block.settings.default_tier | plus: 0

  assign url_50 = block.settings.strength_50_url
  assign url_90 = block.settings.strength_90_url
  assign handle_50 = url_50 | split: '/products/' | last | split: '?' | first | split: '#' | first
  assign handle_90 = url_90 | split: '/products/' | last | split: '?' | first | split: '#' | first
  assign sibling = blank
  if merged
    comment
      Strength links point at the default tier of each strength on this product,
      so they render the right strength server-side without JS.
    endcomment
    assign default_title = 'tier_' | append: block.settings.default_tier | append: '_variant_title'
    assign default_title = block.settings[default_title]
    assign url_50 = product.url
    assign url_90 = product.url
    for v in product.variants
      assign v_rest = v.option2 | append: ' / ' | append: v.option3
      if v_rest == default_title
        if v.option1 contains '90'
          assign url_90 = product.url | append: '?variant=' | append: v.id
        else
          assign url_50 = product.url | append: '?variant=' | append: v.id
        endif
      endif
    endfor
  elsif is_90 and handle_50 != blank
    assign sibling = all_products[handle_50]
  elsif is_90 == false and handle_90 != blank
    assign sibling = all_products[handle_90]
  endif
  if sibling.handle == blank or sibling.handle == product.handle
    assign sibling = blank
  endif
  assign current_strength = '50'
  if is_90
    assign current_strength = '90'
  endif
  assign strengths = '50,90' | split: ','
  assign product_50 = product
  assign product_90 = sibling
  if merged
    assign product_90 = product
  elsif is_90
    assign product_50 = sibling
    assign product_90 = product
  endif
  assign title_50 = product_50.title
  assign title_90 = product_90.title
  if merged
    assign title_50 = product.title | append: ' · 50 mg'
    assign title_90 = product.title | append: ' · 90 mg'
  endif
-%}
{{ 'dandy-capsule-offer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dandy-capsule-offer.js' | asset_url }}" defer></script>

<dandy-capsule-offer
  class="co"
  data-dandy-block="capsule-offer-{{ block.id }}"
  data-cutoff-hour="{{ block.settings.cutoff_hour }}"
  data-caps="{{ caps }}"
  data-default-tier="{{ block.settings.default_tier }}"
  data-cart-url="{{ routes.cart_url }}"
  data-product-url="{{ product.url }}"
  data-strength="{{ current_strength }}"
  data-url-50="{{ url_50 }}"
  data-url-90="{{ url_90 }}"
  {%- if merged %} data-merged{% endif -%}
  {%- if product_50 != blank %} data-title-50="{{ title_50 | escape }}" data-product-url-50="{{ product_50.url }}"{% endif -%}
  {%- if product_90 != blank %} data-title-90="{{ title_90 | escape }}" data-product-url-90="{{ product_90.url }}"{% endif -%}
  {%- if block.settings.reader_code != blank and reader_percent > 0 %} data-reader-code="{{ block.settings.reader_code | escape }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.reader_code != blank and reader_percent > 0 and block.settings.reader_notice != blank -%}
    <div class="co-reader" data-co-reader role="status" hidden>
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m3.5 8.5 3 3 6-7"/></svg>
      <span>{{ block.settings.reader_notice }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.show_strength_switch -%}
    <fieldset class="co-strength">
      <legend class="co-strength__legend">{{ block.settings.strength_legend }}</legend>
      <div class="co-strength__grid">
        <a class="co-strength__card{% unless is_90 %} is-current{% endunless %}" href="{{ url_50 }}" data-co-strength="50"{% unless is_90 %} aria-current="page"{% endunless %}>
          <span class="co-strength__radio" aria-hidden="true"></span>
          <span class="co-strength__mg">50<small>mg</small></span>
          <span class="co-strength__name">{{ block.settings.strength_50_label }}</span>
          <span class="co-strength__desc">{{ block.settings.strength_50_desc }}</span>
        </a>
        <a class="co-strength__card{% if is_90 %} is-current{% endif %}" href="{{ url_90 }}" data-co-strength="90"{% if is_90 %} aria-current="page"{% endif %}>
          <span class="co-strength__radio" aria-hidden="true"></span>
          <span class="co-strength__mg">90<small>mg</small></span>
          <span class="co-strength__name">{{ block.settings.strength_90_label }}</span>
          <span class="co-strength__desc">{{ block.settings.strength_90_desc }}</span>
        </a>
      </div>
      {%- comment -%} Compact picker: the cards carry strength and name only; the chosen strength's description sits in one line under them. {%- endcomment -%}
      {%- if block.settings.strength_50_desc != blank or block.settings.strength_90_desc != blank -%}
        <p class="co-strength__hint" data-co-hint data-hint-50="{{ block.settings.strength_50_desc | escape }}" data-hint-90="{{ block.settings.strength_90_desc | escape }}">
          {%- if is_90 %}{{ block.settings.strength_90_desc }}{% else %}{{ block.settings.strength_50_desc }}{% endif -%}
        </p>
      {%- endif -%}
      {%- if block.settings.strength_90_notice != blank -%}
        <div class="co-strength__notice" data-co-notice-90{% unless is_90 %} hidden{% endunless %}>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 3.5a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5zM6.75 7.5h2v4h-2v-4z"/></svg>
          <div class="co-strength__notice-text">{{ block.settings.strength_90_notice }}</div>
        </div>
      {%- endif -%}
    </fieldset>
  {%- endif -%}

  {%- if block.settings.dispatch_headline != blank -%}
  <div class="co-dispatch">
    <span class="co-dot" aria-hidden="true"></span>
    <div>
      <b data-co-dispatch>{{ block.settings.dispatch_headline | replace: '[when]', 'TODAY' }}</b>
      <span>{{ block.settings.dispatch_sub }}</span>
    </div>
  </div>
  {%- endif -%}

  {%- for strength in strengths -%}
    {%- liquid
      if strength == '50'
        assign sp = product_50
        assign tier_suffix = '-50'
      else
        assign sp = product_90
        assign tier_suffix = '-90'
      endif
      if sp == blank
        continue
      endif
      assign v1 = blank
      assign v2 = blank
      assign anchor_price = 0
      assign v3 = blank
      for v in sp.variants
        assign v_title = v.title
        if merged
          unless v.option1 contains strength
            continue
          endunless
          assign v_title = v.option2 | append: ' / ' | append: v.option3
        endif
        if v_title == block.settings.tier_1_variant_title
          assign v1 = v
        elsif v_title == block.settings.tier_2_variant_title
          assign v2 = v
        elsif v_title == block.settings.tier_3_variant_title
          assign v3 = v
        endif
      endfor
      if v1 != blank
        assign anchor_price = v1.price
      endif
    -%}
  <fieldset class="co-tiers" data-co-tiers="{{ strength }}"{% if strength != current_strength %} hidden{% endif %}>
    <legend class="co-sr-only">{{ block.settings.tiers_legend }}</legend>
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign v = v1
          when 2
            assign v = v2
          else
            assign v = v3
        endcase
        if v == blank or v.available != true
          continue
        endif
        assign jars = i
        assign days = caps | times: jars
        assign save = 0
        assign save_str = ''
        if v.compare_at_price > v.price
          assign save = v.compare_at_price | minus: v.price
          assign save_str = save | money_without_trailing_zeros
        endif
        assign reader_off = v.price | times: reader_percent | divided_by: 100
        assign reader_price = v.price | minus: reader_off
        comment
          The big figure is the price per jar (rounded to the cent); the single-jar price is the struck anchor,
          so the ladder reads $64.99, $54.99, $43.33. The bundle total stays visible in smaller type.
        endcomment
        assign per_jar = v.price | times: 1.0 | divided_by: jars | round
        assign reader_per_jar = reader_price | times: 1.0 | divided_by: jars | round
        assign title_key = 'tier_' | append: i | append: '_title'
        assign badge_key = 'tier_' | append: i | append: '_badge'
        assign ship_key = 'tier_' | append: i | append: '_shipping'
        assign cta_key = 'tier_' | append: i | append: '_cta'
        assign img_key = 'tier_' | append: i | append: '_image_asset'
        assign hero_key = 'tier_' | append: i | append: '_hero'
        assign ribbon_key = 'tier_' | append: i | append: '_ribbon'
        assign t_title = block.settings[title_key]
        assign t_badge = block.settings[badge_key] | replace: '[save]', save_str
        assign t_ship = block.settings[ship_key]
        assign t_cta = block.settings[cta_key]
        assign t_img = block.settings[img_key] | replace: '{strength}', tier_suffix
        assign t_hero = block.settings[hero_key]
        assign t_ribbon = block.settings[ribbon_key]
        assign is_free_ship = false
        if t_ship contains 'FREE' or t_ship contains 'Free'
          assign is_free_ship = true
        endif
      -%}
      <label class="co-tier{% if t_hero %} co-tier--hero{% endif %}" data-co-tier-card>
        <input
          type="radio"
          name="capsule-offer-{{ block.id }}-{{ strength }}"
          value="{{ i }}"
          data-co-tier
          data-variant-id="{{ v.id }}"
          data-price="{{ v.price }}"
          data-reader-price="{{ reader_price }}"
          data-label="{{ t_title | escape }}"
          data-cta="{{ t_cta | escape }}"
          {% if default_tier == i %}checked{% endif %}
          {% if strength != current_strength %}disabled{% endif %}
        >
        {%- if t_hero and t_ribbon != blank -%}
          <span class="co-ribbon">{{ t_ribbon }}</span>
        {%- endif -%}
        <span class="co-tier-body">
          <span class="co-radio" aria-hidden="true"></span>
          <span class="co-pack co-pack--{{ i }}" aria-hidden="true">
            {%- if t_img != blank -%}
              <img src="{{ t_img | asset_url }}" alt="" width="600" height="600" loading="{% if strength == current_strength %}eager{% else %}lazy{% endif %}">
            {%- endif -%}
          </span>
          <span class="co-title">{{ t_title }}{% if t_badge != blank %}<span class="co-badge">{{ t_badge }}</span>{% endif %}</span>
          <span class="co-price">
            {%- comment -%} Regular prices render first; the reader rate swaps the spans in place when the voucher is active. {%- endcomment -%}
            <span class="co-price__now"><span data-co-now data-regular="{{ per_jar | money }}" data-reader="{{ reader_per_jar | money }}">{{ per_jar | money }}</span><small>/jar</small></span>
            {%- assign show_anchor = false -%}
            {%- if anchor_price > per_jar -%}{%- assign show_anchor = true -%}{%- endif -%}
            <s data-co-was data-regular="{% if show_anchor %}{{ anchor_price | money }}{% endif %}" data-reader="{% if anchor_price > 0 %}{{ anchor_price | money }}{% endif %}"{% unless show_anchor %} hidden{% endunless %}>{% if show_anchor %}{{ anchor_price | money }}{% endif %}</s>
          </span>
          <span class="co-detail">
            {%- comment -%} Price per capsule, rounded to the cent. The bundle total lives only on the button. {%- endcomment -%}
            {%- assign per_cap = v.price | times: 1.0 | divided_by: days | round -%}
            {%- assign reader_per_cap = reader_price | times: 1.0 | divided_by: days | round -%}
            <span class="co-daily co-total" data-co-daily data-regular="{{ block.settings.per_day_prefix }} {{ per_cap | money }}/capsule" data-reader="{{ block.settings.per_day_prefix }} {{ reader_per_cap | money }}/capsule">{{ block.settings.per_day_prefix }} {{ per_cap | money }}/capsule</span>
            <span class="co-shipping{% if is_free_ship %} co-shipping--free{% endif %}">{{ t_ship }}</span>
          </span>
        </span>
      </label>
    {%- endfor -%}
  </fieldset>
  {%- endfor -%}

  <form class="co-form" action="{{ routes.cart_add_url }}" method="post" data-co-form>
    <input type="hidden" name="id" value="" data-co-id>
    <input type="hidden" name="quantity" value="1">
    <button type="submit" class="co-cta" data-co-cta>
      <span data-co-cta-text>{{ block.settings.tier_3_cta }}</span><span data-co-cta-price></span>
    </button>
    {%- if block.settings.reassurance != blank -%}
      <p class="co-reassurance">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="2"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
        <span>{{ block.settings.reassurance }}</span>
      </p>
    {%- endif -%}
    {%- if block.settings.eta_show -%}
      {%- comment -%} One light dispatch line; JS names the day (today before the Central cutoff, else the next weekday). {%- endcomment -%}
      <p class="co-eta" data-co-eta>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6.5h11v9H3zM14 10h4l3 3v2.5h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
        <span data-co-eta-text>Orders by 2 PM CT ship the same day</span>
      </p>
    {%- endif -%}
    <p class="co-message" data-co-message role="status" hidden></p>
    <noscript>Please enable JavaScript to choose your bundle.</noscript>
  </form>

  {%- if block.settings.guarantee_heading != blank -%}
    <div class="co-guarantee">
      <svg viewBox="0 0 24 24" width="32" height="32" fill="color-mix(in srgb, var(--dandy-accent, #164020) 10%, white)" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 20 6v6c0 5-8 9-8 9s-8-4-8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg>
      <div>
        <h2>{{ block.settings.guarantee_heading }}</h2>
        {%- if block.settings.guarantee_text != blank -%}<p>{{ block.settings.guarantee_text }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <ul class="co-trust" aria-label="Shipping and quality">
    <li>
      {%- if block.settings.trust_1 != blank -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>
        <span><b>{{ block.settings.trust_1 }}</b>{%- if block.settings.trust_1_sub != blank -%}<small>{{ block.settings.trust_1_sub }}</small>{%- endif -%}</span>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6.5h11v9H3zM14 10h4l3 3v2.5h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
        <span><b data-co-proof-dispatch>Ships Today</b><small>{{ block.settings.trust_1_sub }}</small></span>
      {%- endif -%}
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 3h5M10 3v6.2L5.2 18a2 2 0 0 0 1.8 3h10a2 2 0 0 0 1.8-3L14 9.2V3"/><path d="M7.5 15.5h9"/></svg>
      <span><b>{{ block.settings.trust_2 }}</b></span>
    </li>
    <li>
      <span class="co-flag" aria-hidden="true">🇺🇸</span>
      <span><b>{{ block.settings.trust_3 }}</b></span>
    </li>
  </ul>

  {%- if block.settings.show_sticky -%}
    {%- comment -%}
      Phone sticky bar. It appears only once the bundle cards have scrolled above the screen, and its button
      scrolls back to them rather than adding to cart, so every shopper chooses a bundle with the cards in view.
      JS moves it to <body> so no containment context on the product grid can break position: fixed.
    {%- endcomment -%}
    {%- assign sticky_img = block.settings.tier_3_image_asset | replace: '{strength}', '-50' -%}
    <div class="co-sticky" data-co-sticky hidden>
      <span class="co-sticky__pack" aria-hidden="true">{%- if sticky_img != blank -%}<img src="{{ sticky_img | asset_url }}" alt="" width="600" height="600" loading="lazy">{%- endif -%}</span>
      <span class="co-sticky__text">
        <b data-co-sticky-title>{{ block.settings.sticky_title }}</b>
        <span data-co-sticky-sub></span>
      </span>
      <button type="button" class="co-sticky__cta" data-co-sticky-cta>{{ block.settings.sticky_cta }}</button>
    </div>
  {%- endif -%}
</dandy-capsule-offer>

{% schema %}
{
  "name": "Dandy capsule offer",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Strength switch (in-page with JS, link without)" },
    { "type": "checkbox", "id": "show_strength_switch", "label": "Show strength switch", "default": true },
    { "type": "text", "id": "strength_legend", "label": "Legend", "default": "1. Pick your strength" },
    { "type": "text", "id": "strength_50_label", "label": "50 mg name", "default": "Everyday ease" },
    { "type": "text", "id": "strength_50_desc", "label": "50 mg description", "default": "Daily tension, stiff mornings, first-timers." },
    { "type": "url", "id": "strength_50_url", "label": "50 mg page" },
    { "type": "text", "id": "strength_90_label", "label": "90 mg name", "default": "Heavy-duty" },
    { "type": "text", "id": "strength_90_desc", "label": "90 mg description", "default": "Heavy physical wear, demanding days, or experienced routines." },
    { "type": "richtext", "id": "strength_90_notice", "label": "90 mg notice (shown only while 90 mg is selected)", "default": "<p><strong>First time with Dandy?</strong> 90 mg is high-potency. We recommend starting with 50 mg, or take with food.</p>" },
    { "type": "url", "id": "strength_90_url", "label": "90 mg page" },

    { "type": "header", "content": "Reader rate (via /discount/CODE link)" },
    { "type": "text", "id": "reader_code", "label": "Discount code", "default": "DISPATCH10" },
    { "type": "range", "id": "reader_percent", "label": "Percent off (must match the Shopify discount)", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 10 },
    { "type": "text", "id": "reader_notice", "label": "Notice", "default": "Daily Health Dispatch Reader Rate Active (-10% Auto-Applied at Checkout)" },

    { "type": "header", "content": "Dispatch line" },
    { "type": "text", "id": "dispatch_headline", "label": "Headline ([when] becomes TODAY / TOMORROW / MONDAY)", "default": "ORDER NOW — SHIPS [when]" },
    { "type": "text", "id": "dispatch_sub", "label": "Sub line", "default": "Orders placed by 2 PM CT ship same-day" },
    { "type": "range", "id": "cutoff_hour", "label": "Same-day cutoff (hour, Central, 24h)", "min": 8, "max": 20, "step": 1, "default": 14 },

    { "type": "header", "content": "Tiers (30-count jars)" },
    { "type": "text", "id": "tiers_legend", "label": "Accessible legend", "default": "Choose your jar bundle" },
    { "type": "range", "id": "capsules_per_jar", "label": "Capsules per jar", "min": 10, "max": 60, "step": 5, "default": 30 },
    { "type": "select", "id": "default_tier", "label": "Selected by default", "options": [ { "value": "1", "label": "1 jar" }, { "value": "2", "label": "2 jars" }, { "value": "3", "label": "3 jars" } ], "default": "3" },
    { "type": "text", "id": "per_day_prefix", "label": "Per-day prefix", "default": "Just" },

    { "type": "text", "id": "tier_1_variant_title", "label": "Tier 1 variant title", "default": "30-count / Single" },
    { "type": "text", "id": "tier_1_title", "label": "Tier 1 title", "default": "1 Jar" },
    { "type": "text", "id": "tier_1_badge", "label": "Tier 1 badge ([save] = amount saved)" },
    { "type": "text", "id": "tier_1_shipping", "label": "Tier 1 shipping line", "default": "+ $5.95 Shipping" },
    { "type": "text", "id": "tier_1_cta", "label": "Tier 1 button", "default": "ADD TO CART" },
    { "type": "text", "id": "tier_1_image_asset", "label": "Tier 1 image (assets/ filename; {strength} becomes -50 or -90)", "default": "dandy-cap-tier-1{strength}.webp" },
    { "type": "checkbox", "id": "tier_1_hero", "label": "Tier 1 is the hero tier", "default": false },
    { "type": "text", "id": "tier_1_ribbon", "label": "Tier 1 ribbon" },

    { "type": "text", "id": "tier_2_variant_title", "label": "Tier 2 variant title", "default": "30-count / 2-pack" },
    { "type": "text", "id": "tier_2_title", "label": "Tier 2 title", "default": "2 Jars" },
    { "type": "text", "id": "tier_2_badge", "label": "Tier 2 badge", "default": "SAVE [save]" },
    { "type": "text", "id": "tier_2_shipping", "label": "Tier 2 shipping line", "default": "FREE SHIPPING" },
    { "type": "text", "id": "tier_2_cta", "label": "Tier 2 button", "default": "ADD TO CART" },
    { "type": "text", "id": "tier_2_image_asset", "label": "Tier 2 image", "default": "dandy-cap-tier-2{strength}.webp" },
    { "type": "checkbox", "id": "tier_2_hero", "label": "Tier 2 is the hero tier", "default": false },
