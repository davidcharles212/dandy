{% stylesheet %}
  .dandy-rating {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  a.dandy-rating--link,
  a.dandy-rating--link:hover,
  a.dandy-rating--link:focus {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .dandy-rating.dandy-rating--link .dandy-rating__text {
    padding-bottom: 4px;
    border-bottom: 1px solid color-mix(in srgb, #241914 30%, transparent);
    transition: border-color 0.2s ease;
  }

  .dandy-rating--link:hover .dandy-rating__text,
  .dandy-rating--link:focus-visible .dandy-rating__text {
    border-bottom-color: #241914;
  }

  .dandy-rating--link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .dandy-rating--link .dandy-rating__text {
    display: block;
  }

  .dandy-rating__stars {
    display: block;
    flex: none;
    width: 80px;
    height: 16px;
    line-height: 0;
  }

  .dandy-rating__stars svg {
    display: block;
    width: 80px;
    height: 16px;
  }

  .dandy-rating .dandy-rating__text {
    margin: -0.28623em 0;
    padding: 0;
    color: #241914;
    font-family: var(--dandy-font-body, inherit);
    font-optical-sizing: none;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .dandy-pdp__details > .dandy-rating + .dandy-product-header {
    margin-block-start: 20px;
  }

  @media screen and (min-width: 1100px) {
    .dandy-rating .dandy-rating__text {
      font-size: 16px;
    }

    .dandy-pdp__details > .dandy-rating + .dandy-product-header {
      margin-block-start: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dandy rating",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Rated 4.8/5 | 1,400+ Happy Buyers" },
    { "type": "text", "id": "stars_label", "label": "Star rating label (screen readers)", "default": "Rated 4.8 out of 5 stars" },
    { "type": "text", "id": "link", "label": "Link (optional, e.g. #dpr to jump to the reviews)" },
    { "type": "text", "id": "link_label", "label": "Link label (screen readers)", "default": "Jump to customer reviews" }
  ],
  "presets": [{ "name": "Dandy rating" }]
}
{% endschema %}