{%- if block.settings.link != blank -%}
  <script>
    if (!window.__dandyRatingLink) {
      window.__dandyRatingLink = true;
      document.addEventListener('click', function (e) {
        var a = e.target.closest('[data-dandy-rating-link]');
        if (!a) return;
        var id = (a.getAttribute('href') || '').replace(/^#/, '');
        var t = id && document.getElementById(id);
        if (!t) return;
        e.preventDefault();
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        t.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        if (history.replaceState) history.replaceState(null, '', '#' + id);
      });
    }
  </script>
  <a href="{{ block.settings.link }}" class="dandy-rating dandy-rating--link" aria-label="{{ block.settings.link_label | default: 'Jump to customer reviews' | escape }}" data-dandy-rating-link {{ block.shopify_attributes }}>
