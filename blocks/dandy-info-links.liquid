{%- liquid
  assign bullet = block.settings.bullet_icon
  assign bullet_url = ''
  if bullet != blank
    assign bullet_url = bullet | image_url: width: 112
  elsif block.settings.bullet_icon_asset != blank
    assign bullet_url = block.settings.bullet_icon_asset | asset_url
  endif
-%}
<div
  class="dandy-info-links{% if bullet_url != blank %} dandy-info-links--bullets{% endif %}"
  {% if bullet_url != blank %}style="--dandy-bullet: url('{{ bullet_url }}');"{% endif %}
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Dandy info links",
  "tag": null,
  "blocks": [{ "type": "popup-link" }],
  "settings": [
    { "type": "image_picker", "id": "bullet_icon", "label": "List checkmark", "info": "Shown in Figma's red (#A02508) next to each bullet point in the popups." },
    { "type": "text", "id": "bullet_icon_asset", "label": "List checkmark (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." }
  ],
  "presets": [
    {
      "name": "Dandy info links",
      "blocks": {
        "link_1": { "type": "popup-link", "settings": { "heading": "What is Kratom?" } },
        "link_2": { "type": "popup-link", "settings": { "heading": "Why Dandy?" } }
      },
      "block_order": ["link_1", "link_2"]
    }
  ]
}
{% endschema %}