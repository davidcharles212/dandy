<div class="dandy-trust" {{ block.shopify_attributes }}>
  <ul class="dandy-trust__items">
    {%- for i in (1..2) -%}
      {%- liquid
        assign text_key = 'item_' | append: i | append: '_text'
        assign icon_key = 'item_' | append: i | append: '_icon'
        assign icon_asset_key = 'item_' | append: i | append: '_icon_asset'
        assign item_text = block.settings[text_key]
        assign item_icon = block.settings[icon_key]
        assign item_icon_asset = block.settings[icon_asset_key]
        if i == 1
          assign fallback_icon = 'dandy-icon-shield.svg'
        else
          assign fallback_icon = 'dandy-icon-delivery.svg'
        endif
      -%}
      {%- if item_text != blank -%}
        <li class="dandy-trust__item dandy-trust__item--{{ i }}">
          <span class="dandy-trust__icon" aria-hidden="true">
            {%- if item_icon != blank -%}
              {{- item_icon | image_url: width: 72 | image_tag: alt: '', loading: 'lazy' -}}
            {%- elsif item_icon_asset != blank -%}
              <img src="{{ item_icon_asset | asset_url }}" alt="" loading="lazy">
            {%- else -%}
              {{- fallback_icon | inline_asset_content -}}
            {%- endif -%}
          </span>
          <span class="dandy-trust__text dandy-trim">{{ item_text }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  {%- if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
    <ul class="dandy-trust__payments" aria-label="{{ 'blocks.payment_methods' | t | escape }}">
      {%- for type in shop.enabled_payment_types -%}
        <li class="dandy-trust__payment">{{ type | payment_type_svg_tag: class: 'dandy-trust__payment-icon' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Dandy trust badges",
  "tag": null,
  "settings": [
    { "type": "text", "id": "item_1_text", "label": "Badge 1 text", "default": "30-Day Guarantee" },
    { "type": "image_picker", "id": "item_1_icon", "label": "Badge 1 icon", "info": "Optional. Defaults to the shield icon." },
    { "type": "text", "id": "item_1_icon_asset", "label": "Badge 1 icon (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." },
    { "type": "text", "id": "item_2_text", "label": "Badge 2 text", "default": "Fast Shipping" },
    { "type": "image_picker", "id": "item_2_icon", "label": "Badge 2 icon", "info": "Optional. Defaults to the delivery icon." },
    { "type": "text", "id": "item_2_icon_asset", "label": "Badge 2 icon (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "presets": [{ "name": "Dandy trust badges" }]
}
{% endschema %}
