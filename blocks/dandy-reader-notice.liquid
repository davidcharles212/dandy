{%- comment -%}
  Daily Dispatch reader notice for the gummy PDP. Hidden by default; the inline script shows it only when the
  shopper carries the reader voucher: the Shopify discount_code cookie set by a /discount/CODE link, or a
  ?discount=CODE parameter on the page URL (the same test the capsule page's offer block uses).
  Prices on this page are not swapped; the voucher applies at checkout and the cart drawer itemises it.
{%- endcomment -%}
{%- if block.settings.code != blank and block.settings.text != blank -%}
<dandy-reader-notice
  class="dandy-reader"
  data-dandy-block="reader-{{ block.id }}"
  data-reader-code="{{ block.settings.code | strip | upcase | escape }}"
  role="status"
  hidden
  {{ block.shopify_attributes }}
>
  <span class="dandy-reader__icon" aria-hidden="true">{{ 'dandy-icon-star.svg' | inline_asset_content }}</span>
  <span class="dandy-reader__text">{{ block.settings.text | escape }}</span>
</dandy-reader-notice>
{%- style -%}
  .dandy-pdp__details > .dandy-reader { --dandy-space: 16px; --dandy-space-mobile: 12px; }
  .dandy-reader {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border: 1px solid var(--dandy-orange-25, rgba(244, 81, 43, 0.25));
    border-radius: 8px;
    background: var(--dandy-orange-10, rgba(244, 81, 43, 0.1));
    color: var(--dandy-orange, #f4512b);
    font-variation-settings: 'opsz' 32;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    text-wrap: pretty;
  }
  .dandy-reader[hidden] { display: none; }
  .dandy-reader__icon { flex: 0 0 16px; display: inline-flex; }
  .dandy-reader__icon svg { width: 16px; height: 16px; }
  .dandy-reader__icon svg path { fill: currentColor; }
  @media screen and (min-width: 1100px) {
    .dandy-reader { font-size: 16px; padding: 12px 16px; }
  }
{%- endstyle -%}
<script>
  if (!customElements.get('dandy-reader-notice')) {
    customElements.define('dandy-reader-notice', class extends HTMLElement {
      connectedCallback() {
        const code = (this.dataset.readerCode || '').trim().toUpperCase();
        if (!code) return;
        let cookie = '';
        try {
          const match = document.cookie.match(/(?:^|;\s*)discount_code=([^;]*)/);
          cookie = match ? decodeURIComponent(match[1]) : '';
        } catch (error) {
          console.error('[dandy] unreadable discount_code cookie', error);
        }
        const param = new URLSearchParams(window.location.search).get('discount') || '';
        const active = cookie.trim().toUpperCase() === code || param.trim().toUpperCase() === code;
        this.hidden = !active;
      }
    });
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "Dandy reader notice",
  "tag": null,
  "settings": [
    { "type": "text", "id": "code", "label": "Discount code", "default": "DISPATCH10", "info": "Shown only when the shopper's discount_code cookie or ?discount= parameter matches this code." },
    { "type": "text", "id": "text", "label": "Notice", "default": "Daily Health Dispatch Reader Rate Active (-10% Auto-Applied)" }
  ],
  "presets": [{ "name": "Dandy reader notice" }]
}
{% endschema %}
