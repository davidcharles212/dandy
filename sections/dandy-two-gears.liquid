<section class="dandy-two-gears dandy-section" aria-labelledby="DandyGearsHeading-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="dandy-container">
    <div class="dandy-two-gears__header">
      <span class="dandy-kicker">{{ section.settings.eyebrow }}</span>
      <h2 id="DandyGearsHeading-{{ section.id }}" class="dandy-heading">{{ section.settings.heading }}</h2>
      <p class="dandy-lede">{{ section.settings.text }}</p>
    </div>
    <div class="dandy-two-gears__grid">
      <article class="dandy-gear dandy-gear--bright">
        <div class="dandy-gear__asset dandy-gear__asset--image">
          <img src="{{ 'dandy2-life-morning.webp' | asset_url }}" alt="Holding one Dandy gummy over morning coffee in a sunlit kitchen" width="1400" height="1096" loading="lazy">
        </div>
        <div class="dandy-gear__copy">
          <span class="dandy-label">{{ section.settings.bright_label }}</span>
          <h3>{{ section.settings.bright_heading }}</h3>
          <p>{{ section.settings.bright_text }}</p>
        </div>
      </article>
      <article class="dandy-gear dandy-gear--warm">
        <div class="dandy-gear__asset dandy-gear__asset--image">
          <img src="{{ 'dandy2-life-evening.webp' | asset_url }}" alt="Winding down with a book at dusk, Dandy pouch on the side table" width="1100" height="1100" loading="lazy">
        </div>
        <div class="dandy-gear__copy">
          <span class="dandy-label">{{ section.settings.warm_label }}</span>
          <h3>{{ section.settings.warm_heading }}</h3>
          <p>{{ section.settings.warm_text }}</p>
        </div>
      </article>
    </div>
    {% if section.settings.note != blank %}<p class="dandy-two-gears__note">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Dandy two gears",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW PEOPLE TALK ABOUT KRATOM" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ONE PLANT. TWO GEARS." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The experience can shift with product, serving, sensitivity, food, and context. Think direction, not a guaranteed destination." },
    { "type": "text", "id": "bright_label", "label": "Bright label", "default": "BRIGHT GEAR" },
    { "type": "text", "id": "bright_heading", "label": "Bright heading", "default": "CLEAR. UPBEAT. SWITCHED ON." },
    { "type": "textarea", "id": "bright_text", "label": "Bright text", "default": "The get-moving side of the conversation: clear focus, good energy, and an easier social rhythm." },
    { "type": "text", "id": "warm_label", "label": "Warm label", "default": "WARM GEAR" },
    { "type": "text", "id": "warm_heading", "label": "Warm heading", "default": "WARM. LOOSE. SETTLED." },
    { "type": "textarea", "id": "warm_text", "label": "Warm text", "default": "The shoulders-down side: body ease, a softer edge, and a smooth sense of unwinding." },
    { "type": "textarea", "id": "note", "label": "Context note", "default": "Experiences vary. Follow the exact product label and do not drive or operate machinery if impaired." }
  ],
  "presets": [{ "name": "Dandy two gears" }]
}
{% endschema %}
