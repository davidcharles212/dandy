<section
  class="dandy-page-hero"
  data-copy-status="{{ section.settings.copy_status }}"
  data-claim-ids="{{ section.settings.claim_ids }}"
  aria-labelledby="DandyPageHeading-{{ section.id }}"
>
  <div class="dandy-container dandy-container--wide dandy-page-hero__inner">
    <span class="dandy-kicker">{{ section.settings.eyebrow }}</span>
    <h1 id="DandyPageHeading-{{ section.id }}" class="dandy-display">
      {{ section.settings.heading | default: page.title }}
    </h1>
    {% if section.settings.text != blank %}<p class="dandy-hero__lede">{{ section.settings.text }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Dandy page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dandy guide" },
    { "type": "text", "id": "heading", "label": "Heading override" },
    { "type": "textarea", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "claim_ids", "label": "Internal claim IDs" },
    {
      "type": "select",
      "id": "copy_status",
      "label": "Internal copy status",
      "options": [
        { "value": "aggressive-draft", "label": "Aggressive draft" },
        { "value": "missing-final-legal", "label": "Missing final legal" },
        { "value": "approved", "label": "Approved" }
      ],
      "default": "aggressive-draft"
    }
  ],
  "presets": [{ "name": "Dandy page hero" }]
}
{% endschema %}
