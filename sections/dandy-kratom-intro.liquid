<section class="dandy-kratom-intro dandy-section" aria-labelledby="DandyIntroHeading-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="dandy-container dandy-kratom-intro__grid">
    <div class="dandy-kratom-intro__poster dandy-kratom-intro__poster--image">
      <img src="{{ 'dandy2-leaves-wide.webp' | asset_url }}" alt="Dandy pouch resting on a bed of fresh kratom leaves" width="1200" height="669" loading="lazy">
    </div>
    <div class="dandy-kratom-intro__copy">
      <span class="dandy-kicker">{{ section.settings.eyebrow }}</span>
      <h2 id="DandyIntroHeading-{{ section.id }}" class="dandy-heading">{{ section.settings.heading }}</h2>
      <div class="dandy-kratom-intro__text rte">{{ section.settings.text }}</div>
      <a class="dandy-button dandy-button--secondary" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dandy kratom intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT IS KRATOM?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "START WITH THE PLANT." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Kratom comes from the leaves of <em>Mitragyna speciosa</em>, a tropical tree in the coffee family. People reach for it in different moments—when they want a brighter gear, a warmer gear, or simply a change of pace.</p><p>Dandy makes the format easier to understand: clearly labeled, thoughtfully portioned, and ready without a chemistry set.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "WHAT IS KRATOM?" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Dandy kratom intro" }]
}
{% endschema %}
