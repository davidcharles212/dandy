<section
  class="dandy-final-cta"
  data-copy-status="{{ section.settings.copy_status }}"
  data-claim-ids="{{ section.settings.claim_ids }}"
  aria-labelledby="DandyFinalHeading-{{ section.id }}"
>
  <div class="dandy-container dandy-container--wide dandy-final-cta__inner">
    <span class="dandy-kicker">{{ section.settings.eyebrow }}</span>
    <h2 id="DandyFinalHeading-{{ section.id }}" class="dandy-heading">{{ section.settings.heading }}</h2>
    <p class="dandy-body">{{ section.settings.text }}</p>
    <div class="dandy-actions">
      <a class="dandy-button dandy-button--secondary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
        {{ section.settings.primary_label }}
      </a>
      {% if section.settings.secondary_label != blank %}
        <a class="dandy-text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }} →</a>
      {% endif %}
    </div>
    {% render 'dandy-guarantee-line', context: 'final-cta' %}
  </div>
</section>

{% schema %}
{
  "name": "Dandy final CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fine and Dandy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready for a clearer kind of kratom?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Start with the gummy, see every term, and choose only what makes sense for you." },
    { "type": "text", "id": "primary_label", "label": "Primary action", "default": "Try Dandy gummies" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary action", "default": "Read the FAQ" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "claim_ids", "label": "Internal claim IDs", "default": "C-09 C-13 C-15" },
    {
      "type": "select",
      "id": "copy_status",
      "label": "Internal copy status",
      "options": [
        { "value": "aggressive-draft", "label": "Aggressive draft" },
        { "value": "approved", "label": "Approved" }
      ],
      "default": "aggressive-draft"
    }
  ],
  "presets": [{ "name": "Dandy final CTA" }]
}
{% endschema %}
