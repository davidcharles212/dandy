<script>
  (() => {
    // format rail: keep the dots in step with the swipe
    const rail = document.querySelector('[data-d2-frail]');
    const dots = document.querySelector('[data-d2-fdots]');
    if (rail && dots) {
      const items = [...rail.children];
      const marks = [...dots.children];
      rail.addEventListener('scroll', () => {
        const mid = rail.scrollLeft + rail.clientWidth / 2;
        let best = 0, dist = Infinity;
        items.forEach((el, i) => {
          const c = el.offsetLeft + el.offsetWidth / 2;
          if (Math.abs(c - mid) < dist) { dist = Math.abs(c - mid); best = i; }
        });
        marks.forEach((m, i) => m.classList.toggle('is-on', i === best));
      }, { passive: true });
    }
    const bar = document.querySelector('[data-d2-home-sticky]');
    const hero = document.querySelector('.dandy2-home .hhero');
    if (!bar || !hero || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(([en]) => { bar.hidden = en.isIntersecting; }, { rootMargin: '-80px 0px 0px 0px' }).observe(hero);
  })();
</script>

