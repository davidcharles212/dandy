<section class="dandy-quality dandy-section" aria-labelledby="DandyQualityHeading-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="dandy-container dandy-quality__grid">
    <div class="dandy-quality__copy">
      <span class="dandy-kicker">{{ section.settings.eyebrow }}</span>
      <h2 id="DandyQualityHeading-{{ section.id }}" class="dandy-heading">{{ section.settings.heading }}</h2>
      <p class="dandy-lede">{{ section.settings.text }}</p>
      {% if section.settings.link_label != blank %}<a class="dandy-button" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{% endif %}
    </div>
    <div class="dandy-quality__proof">
      <div class="dandy-quality__document" aria-hidden="true">
        <span>DANDY / BATCH REPORT</span>
        <strong>BAG → BATCH → REPORT</strong>
        <div></div><div></div><div></div>
        <small>Identity · date · scope</small>
      </div>
      <ol class="dandy-quality__steps">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>
            <span>0{{ forloop.index }}</span>
            <div><strong>{{ block.settings.heading }}</strong><p>{{ block.settings.text }}</p></div>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dandy quality",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BATCH TO BAG" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "KNOW WHAT'S IN THE BAG." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Good proof should be simple to follow. Find the batch on the bag, match it to the report, and see what the report actually covers." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "QUALITY & TESTING" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Proof step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "FIND THE BATCH" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The product and its paperwork should share an identity." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Dandy quality" }]
}
{% endschema %}
