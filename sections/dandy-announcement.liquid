{% if section.settings.text != blank %}
  <div
    class="dandy-announcement"
    data-copy-status="{{ section.settings.copy_status }}"
    data-claim-ids="{{ section.settings.claim_ids }}"
    {{ section.shopify_attributes }}
  >
    {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
      {{ section.settings.text }}
    {% if section.settings.link != blank %}</a>{% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Dandy announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "default": "FREE SHIPPING ON 3+ PACKS · SUBSCRIBE & SAVE 20%"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "text",
      "id": "claim_ids",
      "label": "Internal claim IDs",
      "default": "C-09 C-16"
    },
    {
      "type": "select",
      "id": "copy_status",
      "label": "Internal copy status",
      "options": [
        { "value": "aggressive-draft", "label": "Aggressive draft" },
        { "value": "approved", "label": "Approved" }
      ],
      "default": "aggressive-draft"
    }
  ],
  "presets": [{ "name": "Dandy announcement" }]
}
{% endschema %}
