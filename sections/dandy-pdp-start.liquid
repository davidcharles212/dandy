{%- render 'dandy-fonts' -%}

<div class="dps" style="--dps-bg: {{ section.settings.background_color }};">
  <div class="dps__intro">
    <h2 class="dps__heading">
      {%- if section.settings.heading_accent != blank -%}
        <span class="dps__accent">{{ section.settings.heading_accent | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading_accent != blank and section.settings.heading != blank -%}{{ ' ' }}{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <span class="dps__rest">{{ section.settings.heading | escape }}</span>
      {%- endif -%}
    </h2>
    {%- if section.settings.body != blank -%}
      <p class="dps__body">{{ section.settings.body | escape }}</p>
    {%- endif -%}
  </div>

  <div class="dps__cards">
    {%- for block in section.blocks -%}
      {%- assign text_mobile = block.settings.text_mobile | default: block.settings.text -%}
      <article
        class="dps__card"
        style="--dps-ov: {{ block.settings.overlay | divided_by: 100.0 }}; --dps-ov-m: {{ block.settings.overlay_mobile | divided_by: 100.0 }}; --dps-tw-m: {{ block.settings.text_width_mobile }}px;"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {%- assign focal = block.settings.image.presentation.focal_point | default: '50% 50%' -%}
          {%- assign img_style = 'object-position: ' | append: focal -%}
          {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '450, 700, 1000, 1400', sizes: '(min-width: 1280px) 674px, (min-width: 750px) 90vw, 656px', alt: '', loading: 'lazy', class: 'dps__img', style: img_style }}
        {%- elsif block.settings.image_asset != blank -%}
          <img src="{{ block.settings.image_asset | asset_url }}" sizes="(min-width: 1280px) 674px, (min-width: 750px) 90vw, 656px" alt="" loading="lazy" class="dps__img">
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <p class="dps__pill"><span>{{ block.settings.label | escape }}</span></p>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="dps__desc dps__desc--desktop">{{ block.settings.text | escape }}</p>
        {%- endif -%}
        {%- if text_mobile != blank -%}
          <p class="dps__desc dps__desc--mobile">{{ text_mobile | escape }}</p>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .dps {
    position: relative;
    z-index: 1;
    padding: 0 16px 40px;
    background: var(--dps-bg, var(--dandy-pdp-cream, #fff9f0));
    color: #241914;
    font-family: var(--dandy-font-body, sans-serif);
    font-optical-sizing: none;
    -webkit-font-smoothing: antialiased;
  }

  .dps *,
  .dps *::before,
  .dps *::after {
    box-sizing: border-box;
  }

  .dps :where(h2, p) {
    margin: 0;
    padding: 0;
  }

  .dps__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 560px;
    margin: 0 auto;
  }

  .dps .dps__heading {
    max-width: 245.77px;
    margin: -4.57px 0 -5.06px;
    color: #241914;
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 44px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dps__accent {
    display: block;
    color: var(--dandy-accent, #f4512b);
  }

  .dps .dps__body {
    margin: -4.58px 0;
    color: #241914;
    font-variation-settings: 'opsz' 32;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.8px;
    letter-spacing: -0.16px;
  }

  .dps__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    max-width: 560px;
    margin: 32.16px auto 0;
  }

  .dps__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 160px;
    overflow: hidden;
    padding: 12px;
    border-radius: 8px 8px 32px 8px;
    background: #241914;
    isolation: isolate;
  }

  .dps__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(270deg, rgb(0 0 0 / 0) 33.48%, rgb(0 0 0 / var(--dps-ov-m, 0.31)) 77.53%);
    pointer-events: none;
  }

  .dps__img {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dps .dps__pill {
    position: relative;
    z-index: 2;
    align-self: flex-start;
    padding: 8px 10px;
    border-radius: 4px;
    background: var(--dandy-accent, #f4512b);
    line-height: 0;
  }

  .dps__pill span {
    display: block;
    margin: -1.83px 0 -2.02px;
    color: var(--dandy-pdp-cream, #fff9f0);
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 16px;
    line-height: 17.6px;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dps .dps__desc {
    position: relative;
    z-index: 2;
    max-width: var(--dps-tw-m, 146px);
    margin: -4.58px 0;
    color: var(--dandy-pdp-cream, #fff9f0);
    font-variation-settings: 'opsz' 32;
    font-weight: 500;
    font-size: 16px;
    line-height: 20.8px;
    letter-spacing: -0.16px;
  }

  .dps__desc--desktop {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .dps {
      padding: 0 32px 70px;
    }

    .dps__intro {
      align-items: center;
      gap: 24px;
      max-width: 776.29px;
      text-align: center;
    }

    .dps .dps__heading {
      max-width: none;
      margin: -5.48px 0 -6.07px;
      font-size: 48px;
      line-height: 52.8px;
    }

    .dps__accent {
      display: inline;
    }

    .dps .dps__body {
      margin: -5.15px 0;
      color: rgb(36 25 20 / 0.8);
      font-size: 18px;
      line-height: 23.4px;
      letter-spacing: -0.18px;
    }

    .dps__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      max-width: 1408px;
      margin-top: 39.65px;
    }

    .dps__card {
      height: auto;
      aspect-ratio: 337 / 172;
      padding: 20px;
    }

    .dps__card::before {
      background: linear-gradient(270deg, rgb(0 0 0 / 0) 33.48%, rgb(0 0 0 / var(--dps-ov, 0.31)) 77.53%);
    }

    .dps .dps__pill {
      padding: 10.4px 13px;
    }

    .dps__pill span {
      margin: -2.28px 0 -2.53px;
      font-size: 20px;
      line-height: 22px;
    }

    .dps .dps__desc {
      max-width: 146px;
    }

    .dps__desc--desktop {
      display: block;
    }

    .dps__desc--mobile {
      display: none;
    }
  }

  @media screen and (min-width: 1280px) {
    .dps__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dandy start low",
  "tag": "section",
  "class": "dandy-pdp-start-section",
  "settings": [
    { "type": "text", "id": "heading_accent", "label": "Heading (orange part)", "default": "Start low." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your sweet spot." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text",
      "default": "Everyone responds differently. Start with half, give it time and only take more if you need it."
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFF9F0" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." },
        { "type": "text", "id": "label", "label": "Label", "default": "Start with half" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Take half a gummy your first time." },
        { "type": "textarea", "id": "text_mobile", "label": "Text (mobile)", "info": "Optional. Uses the text above when empty." },
        { "type": "range", "id": "text_width_mobile", "label": "Text width (mobile)", "min": 60, "max": 160, "step": 1, "unit": "px", "default": 99 },
        { "type": "range", "id": "overlay", "label": "Shade (desktop)", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 31 },
        { "type": "range", "id": "overlay_mobile", "label": "Shade (mobile)", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 31 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Dandy start low",
      "blocks": [
        { "type": "step", "settings": { "label": "Start with half", "text": "Take half a gummy your first time.", "text_width_mobile": 99, "overlay": 31, "overlay_mobile": 31 } },
        { "type": "step", "settings": { "label": "Wait 45 minutes", "text": "Let it settle in before deciding on more.", "text_mobile": "Give it time to settle before deciding on more.", "text_width_mobile": 134, "overlay": 36, "overlay_mobile": 36 } },
        { "type": "step", "settings": { "label": "Check in", "text": "Notice your energy, mood and focus.", "text_width_mobile": 109, "overlay": 31, "overlay_mobile": 0 } },
        { "type": "step", "settings": { "label": "Make it yours", "text": "Use intentionally and take regular breaks.", "text_width_mobile": 121, "overlay": 31, "overlay_mobile": 0 } }
      ]
    }
  ]
}
{% endschema %}