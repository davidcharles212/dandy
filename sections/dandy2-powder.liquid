<script>
(() => {
  const root = document.querySelector('[data-d2-powder]');
  if (!root) return;
  const SHIP = 5.95;
  const P = {
    '100': { unit: 34.99, g: 100, packs: { 1: 34.99, 3: 69.98, 5: 104.97 } },
    '250': { unit: 54.99, g: 250, packs: { 1: 54.99, 3: 109.98, 5: 164.97 } }
  };
  const m = (n) => '$' + n.toFixed(2);
  const sizes = [...root.querySelectorAll('[data-d2-psize]')];
  const qtys = [...root.querySelectorAll('[data-d2-pqty]')];
  const set = (sel, txt) => { const n = root.querySelector(sel); if (n) n.textContent = txt; };
  // real add to cart: resolve the visible selection to a Shopify variant
  const form = root.querySelector('[data-d2-pbuyform]');
  const idField = root.querySelector('[data-d2-pidfield]');
  const note = root.querySelector('[data-d2-ppreviewnote]');
  let vmap = [];
  try { vmap = JSON.parse(root.querySelector('[data-d2-pvariantmap]')?.textContent || '[]'); } catch {}
  const findV = (...tokens) => vmap.find(v => tokens.every(t => v.title.toLowerCase().includes(t)) && v.available && v.price > 0);
  if (form) form.addEventListener('submit', (e) => {
    if (form.dataset.buyable === 'true') return;
    e.preventDefault();
    if (!note) return;
    note.hidden = false;
    note.textContent = 'Preview only, this size has no purchasable variant in Shopify yet.';
  });
  const sync = () => {
    const size = sizes.find(i => i.checked)?.value || '100';
    const qty = Number(qtys.find(i => i.checked)?.value || 1);
    const cfg = P[size];
    // quantity cards always show this size's real ladder prices
    set('[data-d2-p1]', m(cfg.packs[1]));
    set('[data-d2-p3]', m(cfg.packs[3]));
    set('[data-d2-p5]', m(cfg.packs[5]));
    const product = cfg.packs[qty];
    const freeShip = qty >= 3;
    const total = freeShip ? product : product + SHIP;
    const cta = root.querySelector('[data-d2-pcta]');
    if (cta) cta.textContent = `Add ${qty > 1 ? qty + ' × ' : ''}${size} g · ${m(product)}`;
    set('[data-d2-pcharge]', freeShip
      ? `Charged today: ${m(total)} · free shipping · one-time, nothing renews`
      : `Charged today: ${m(total)} (${m(product)} + ${m(SHIP)} shipping) · one-time, nothing renews`);
    set('[data-d2-precap]', `${qty} × ${size} g pouch`);
    set('[data-d2-precap-total]', m(total));
    set('[data-d2-pstick-label]', `${qty} × ${size} g pouch`);
    set('[data-d2-pstick-total]', m(total));
    // variant titles are e.g. "100 g / Single", "250 g / 3-pack"
    const v = findV(`${size} g`, qty === 1 ? 'single' : `${qty}-pack`);
    if (form && idField && v) {
      idField.value = v.id;
      form.dataset.buyable = 'true';
    } else if (form) {
      form.dataset.buyable = 'false';
    }
    if (note) note.hidden = true;
  };
  root.addEventListener('change', sync);
  sync();
  // sticky bar once the buy box scrolls away
  const grid = root.querySelector('.dandy2-pdp__grid');
  const bar = root.querySelector('[data-d2-psticky]');
  if (grid && bar && 'IntersectionObserver' in window) {
    new IntersectionObserver(([en]) => { bar.hidden = en.isIntersecting; }, { rootMargin: '-120px 0px 0px 0px' }).observe(grid);
  }
  // Rocky lunges at the CTA on scroll-in and on hover
  const rocky = root.querySelector('[data-d2-ctarocky]');
  const cta = root.querySelector('[data-d2-pcta]');
  if (rocky && cta && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let scrolled = false, done = false;
    addEventListener('scroll', () => { scrolled = true; }, { once: true, passive: true });
    const io = new IntersectionObserver(([en]) => {
      if (done || !scrolled || !en.isIntersecting) return;
      done = true; io.disconnect();
      rocky.classList.add('is-in');
      setTimeout(() => rocky.classList.remove('is-in'), 4200);
    }, { threshold: 0.9 });
    io.observe(cta);
    cta.addEventListener('mouseenter', () => rocky.classList.add('is-in'));
    cta.addEventListener('mouseleave', () => rocky.classList.remove('is-in'));
  }
  // how-to video: autoplay the loop unless the visitor prefers reduced motion
  const vid = root.querySelector('[data-d2-howto]');
  const tog = root.querySelector('[data-d2-howto-toggle]');
  if (vid && tog) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setLabel = () => { tog.textContent = vid.paused ? 'Play' : 'Pause'; };
    if (reduce) { vid.pause(); } else {
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([en]) => { en.isIntersecting ? vid.play().catch(() => {}) : vid.pause(); }, { threshold: 0.4 }).observe(vid);
      } else { vid.play().catch(() => {}); }
    }
    tog.addEventListener('click', () => { vid.paused ? vid.play() : vid.pause(); setLabel(); });
    vid.addEventListener('play', setLabel); vid.addEventListener('pause', setLabel);
    setLabel();
  }
  // gallery
  const gmain = root.querySelector('.gallery__main img');
  const thumbs = [...root.querySelectorAll('.gallery__thumb')];
  thumbs.forEach(t => t.addEventListener('click', () => {
    thumbs.forEach(x => x.setAttribute('aria-current', String(x === t)));
    if (!gmain) return;
    gmain.src = t.dataset.full; gmain.alt = t.dataset.alt || '';
    if (t.dataset.fit) gmain.setAttribute('data-fit', t.dataset.fit); else gmain.removeAttribute('data-fit');
  }));
})();
</script>

