<section
  class="dandy-section"
  data-copy-status="{{ section.settings.copy_status }}"
  data-claim-ids="{{ section.settings.claim_ids }}"
  aria-labelledby="DandyIconGridHeading-{{ section.id }}"
>
  <div class="dandy-container dandy-container--wide">
    <div class="dandy-section__intro">
      <div>
        <span class="dandy-kicker">{{ section.settings.eyebrow }}</span>
        <h2 id="DandyIconGridHeading-{{ section.id }}" class="dandy-heading">{{ section.settings.heading }}</h2>
      </div>
      <p class="dandy-body">{{ section.settings.text }}</p>
    </div>
    <div class="dandy-content-grid">
      {% for block in section.blocks %}
        <article class="dandy-card dandy-content-card" {{ block.shopify_attributes }}>
          {% render 'dandy-icon', name: block.settings.icon %}
          <h3>{{ block.settings.heading }}</h3>
          <div>{{ block.settings.text }}</div>
          {% if block.settings.link_label != blank %}
            <a class="dandy-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dandy icon grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Dandy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Less mystery. More useful detail." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every module is built to answer a real shopping question with product data, proof, or plain language." },
    { "type": "text", "id": "claim_ids", "label": "Internal claim IDs", "default": "C-01 C-09 C-10 C-11" },
    {
      "type": "select",
      "id": "copy_status",
      "label": "Internal copy status",
      "options": [
        { "value": "aggressive-draft", "label": "Aggressive draft" },
        { "value": "approved", "label": "Approved" }
      ],
      "default": "aggressive-draft"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "lab", "label": "Lab" },
            { "value": "package", "label": "Package" },
            { "value": "check", "label": "Check" },
            { "value": "berry", "label": "Berry" },
            { "value": "calendar", "label": "Calendar" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Know the format" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Explain what the shopper receives without vague package math.</p>" },
        { "type": "text", "id": "link_label", "label": "Optional link label" },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Dandy icon grid" }]
}
{% endschema %}
