{% comment %}
  DANDY 2026 REDESIGN, PDP (namespaced; part of the fresh-theme track).
  Built from the parsed Figma design system + certified DR program.
  Renders only on dandy2 templates. Preview-safe: the CTA never submits.
{% endcomment %}
{{ 'dandy2.css' | asset_url | stylesheet_tag }}
{%- assign image_url = 'dandy2-life-morning.webp' | asset_url | prepend: request.origin -%}
{%- render 'dandy2-schema', kind: 'product', p_name: 'Mixed Berry Kratom Gummies', p_desc: 'Kratom gummies portioned to an exact 35 mg of mitragynine each. Lab-tested every batch.', p_image: image_url, p_low: '24.99', p_high: '59.99', p_count: 2 -%}
{%- render 'dandy2-schema', kind: 'faq' -%}

{%- comment -%}
  Trust-page URLs in ONE place. The real page records don't exist in Shopify yet, so
  these point at the dandy2 template previews. When David creates pages with handles
  batch-reports / shipping / what-is-kratom, change these three lines only.
{%- endcomment -%}
{%- assign url_coa = '/pages/contact?view=dandy2-coa' -%}
{%- assign url_ship = '/pages/contact?view=dandy2-shipping' -%}
{%- assign url_kratom = '/pages/contact?view=dandy2-kratom' -%}
<script src="{{ 'dandy2.js' | asset_url }}" defer></script>

{% capture d2_lock %}<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10.5" width="16" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>{% endcapture %}
{% capture d2_check %}<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{% endcapture %}
{% capture d2_gcheck %}<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#064C26" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{% endcapture %}

<dandy2-pdp class="dandy2-pdp" data-copy-status="{{ section.settings.copy_status }}">
  {% render 'dandy2-chrome-header' %}

  <main class="dandy2-pdp__grid" id="DandyBuyBox">
    <section class="gallery" aria-label="Product photos">
      <div class="gallery__main"><img src="{{ 'dandy2-life-morning.webp' | asset_url }}" alt="Holding one Dandy gummy over morning coffee, pouch on the counter" width="1400" height="1096" loading="eager"></div>
      <div class="gallery__thumbs">
        <button type="button" class="gallery__thumb" aria-current="true" data-full="{{ 'dandy2-life-morning.webp' | asset_url }}" data-alt="Holding one Dandy gummy over morning coffee, pouch on the counter"><img src="{{ 'dandy2-life-morning.webp' | asset_url }}" alt="" width="80" height="80"></button>
        <button type="button" class="gallery__thumb" data-full="{{ 'dandy2-life-paw.webp' | asset_url }}" data-alt="Close-up of raccoon paws holding a sugared mixed-berry gummy"><img src="{{ 'dandy2-life-paw.webp' | asset_url }}" alt="" width="80" height="80"></button>
        <button type="button" class="gallery__thumb" data-full="{{ 'dandy2-life-evening.webp' | asset_url }}" data-alt="Winding down with a book at dusk, Dandy pouch on the side table"><img src="{{ 'dandy2-life-evening.webp' | asset_url }}" alt="" width="80" height="80"></button>
        <button type="button" class="gallery__thumb" data-full="{{ 'dandy2-life-bag.webp' | asset_url }}" data-alt="Dandy pouch in a tote bag with headphones, sunglasses, and keys"><img src="{{ 'dandy2-life-bag.webp' | asset_url }}" alt="" width="80" height="80"></button>
        <button type="button" class="gallery__thumb" data-fit="contain" data-full="{{ 'dandy-gummy-facts-1200.webp' | asset_url }}" data-alt="Supplement facts panel"><img src="{{ 'dandy-gummy-facts-1200.webp' | asset_url }}" alt="" width="80" height="80"></button>
      </div>
    </section>

    <section class="offer" aria-label="Purchase options">
      <div class="headrow">
        <div class="headrow__copy">
          <p class="ratingline" data-copy-status="aggressive-draft">Rated <b>4.8/5</b> by 1,475 verified customers</p>
          <p class="eyebrow">Mixed Berry Kratom Gummies · 35 mg</p>
          <h1 class="title">Bright energy,<br>easy unwinding.</h1>
        </div>
        <img class="headrow__rocky" src="{{ 'dandy2-rocky-catch.webp' | asset_url }}" alt="Rocky the Dandy raccoon catching a gummy" width="343" height="520" loading="eager">
      </div>
      <p class="desc">One berry gummy, two gears, switched-on days or settled evenings. You pick.</p>
      <ul class="benefits" data-copy-status="aggressive-draft">
        <li><i>☀</i><b>Bright energy</b><span>A clean daytime lift, not espresso jitters stacked on coffee.</span></li>
        <li><i>◎</i><b>Clear focus</b><span>35&nbsp;mg exactly, every gummy. Portioned, steady, predictable.</span></li>
        <li><i>☾</i><b>Easy unwind</b><span>The evening gear, settle down without a pour.</span></li>
      </ul>
      <p class="trustline">Every batch lab-tested, <a href="{{ url_coa }}">read the COA</a> · 30-day guarantee · 35 mg exactly</p>

      <div class="doors">
        <button type="button" class="door is-on" data-d2-door="sub" aria-pressed="true">Keep it coming<small>$1.60/gummy · save 20%</small></button>
        <button type="button" class="door" data-d2-door="one" aria-pressed="false">Just once<small>packs &amp; trial</small></button>
      </div>

      <div class="doorpane" data-d2-pane="sub">
        <div class="subhero">
          <span class="subhero__stamp">20%<small>OFF</small></span>
          <img class="subhero__img" src="{{ 'dandy2-leaves-wide.webp' | asset_url }}" alt="Dandy pouch on a bed of fresh kratom leaves" width="1200" height="669" loading="lazy">
          <div class="subhero__main">
            <div class="subhero__row"><span class="subhero__name">One pouch, every 30 days</span><span class="subhero__price"><s>$59.99</s>$47.99</span></div>
            <p class="subhero__meta">30 gummies · $1.60/gummy, the best price without buying in bulk</p>
            <ul class="subhero__list">
              <li>{{ d2_gcheck }} Free shipping, every time</li>
              <li>{{ d2_gcheck }} One pouch every 30 days, never the panic reorder</li>
              <li>{{ d2_gcheck }} Skip, pause, or cancel in two clicks</li>
            </ul>
            <p class="subhero__psst" data-copy-status="aggressive-draft">Psst, don&rsquo;t tell the raccoon we&rsquo;re selling gummies this cheap.</p>
          </div>
        </div>
      </div>

      <div class="doorpane" data-d2-pane="one" hidden>
        <div class="qgrid">
          <label class="qcard"><input type="radio" name="d2one-{{ section.id }}" value="1" data-d2-one><span class="qcard__n">1 pouch</span><span class="qcard__p">$59.99</span><span class="qcard__m">30 gummies · $2.00/gummy · + $5.95 shipping</span></label>
          <label class="qcard"><input type="radio" name="d2one-{{ section.id }}" value="3" data-d2-one checked><span class="qcard__free">Most popular</span><span class="qcard__n">Buy 2,<br>get 1 free</span><span class="qcard__p"><s>$179.97</s>$119.98</span><span class="qcard__m">90 gummies · $1.33/gummy · free shipping</span></label>
          <label class="qcard"><input type="radio" name="d2one-{{ section.id }}" value="5" data-d2-one><span class="qcard__free">Best value</span><span class="qcard__n">Buy 3,<br>get 2 free</span><span class="qcard__p"><s>$299.95</s>$179.97</span><span class="qcard__m">150 gummies · $1.20/gummy · free shipping</span></label>
        </div>
        <label class="trialrow"><input type="radio" name="d2one-{{ section.id }}" value="trial" data-d2-one>Just want a taste? <b>10-count trial, $24.99</b> · one-time · + $5.95 shipping</label>
      </div>

      {%- assign d2_plan_id = '' -%}
      {%- for g in product.selling_plan_groups -%}{%- for sp in g.selling_plans -%}{%- if d2_plan_id == '' -%}{%- assign d2_plan_id = sp.id -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
      {%- comment -%}
        The default door is the subscription, so the form only starts buyable if a
        selling plan exists; the JS sync() re-derives this per selection on load.
      {%- endcomment -%}
      {%- assign d2_buyable = false -%}
      {%- if product.selected_or_first_available_variant.available and product.price > 0 and d2_plan_id != '' -%}{%- assign d2_buyable = true -%}{%- endif -%}
      {%- assign d2_default_v = product.selected_or_first_available_variant -%}
      {%- for v in product.variants -%}{%- if v.title == '30-count / Single' and v.available -%}{%- assign d2_default_v = v -%}{%- endif -%}{%- endfor -%}
      <script type="application/json" data-d2-variantmap>
        [{% for v in product.variants %}{"id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | default: false }}, "price": {{ v.price | default: 0 }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
      </script>
      <form class="buyform" action="{{ routes.cart_url }}/add" method="post" data-d2-buyform data-buyable="{{ d2_buyable }}" data-plan="{{ d2_plan_id }}">
        <input type="hidden" name="id" value="{{ d2_default_v.id }}" data-d2-idfield>
        <input type="hidden" name="quantity" value="1" data-d2-qtyfield>
        <input type="hidden" name="selling_plan" value="" data-d2-planfield disabled>
      <div class="ctawrap" data-copy-status="aggressive-draft">
        <img class="ctarocky" data-d2-ctarocky src="{{ 'dandy2-rocky-press.webp' | asset_url }}" alt="Rocky the raccoon reaching for the button, if you don’t press it, he will" width="640" height="384" loading="lazy">
        <button type="submit" class="cta" data-d2-cta>START SUBSCRIPTION, $47.99</button>
      </div>
      <label class="bump" data-copy-status="aggressive-draft">
        <input type="checkbox" data-d2-bump>
        <span class="bump__box" aria-hidden="true"></span>
        <span class="bump__txt"><b>Add the 10-count trial, $24.99</b><span>Handy for a bag or a desk drawer. One-time, added to this order.</span></span>
        <img class="bump__img" src="{{ 'dandy-gummy-10.png' | asset_url }}" alt="" width="120" height="120" loading="lazy">
      </label>
      <p class="previewnote" data-d2-previewnote hidden></p>
      </form>
      {% render 'dandy2-trustbadges' %}
      <div class="shiprow" data-copy-status="aggressive-draft">
        <img class="shiprow__truck" src="{{ 'dandy2-truck.webp' | asset_url }}" alt="Illustration of the Dandy delivery truck, driven by the raccoon" width="900" height="600" loading="lazy">
        <p class="shiprow__txt" data-d2-cutoff>Order before <b>1 PM EST</b>, ships next day</p>
      </div>
      <p class="gseal" data-copy-status="pending-legal"><span class="gseal__mark">30<small>DAY</small></span><span class="gseal__txt"><b>Money-back guarantee</b><span>Don&rsquo;t get on with it? We refund it.</span></span></p>
    </section>
  </main>

