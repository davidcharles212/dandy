{% comment %} DANDY 2026, generic content page (FAQ / About / Returns / Subscription policy).
  Content comes from section settings + blocks so one section serves several templates. {% endcomment %}
{{ 'dandy2.css' | asset_url | stylesheet_tag }}
<div class="dandy2-pdp dandy2-doc" data-copy-status="{{ section.settings.copy_status }}">
  {% render 'dandy2-chrome-header' %}
  <main class="doc" id="DandyMain">
    <header class="doc__head">
      <h1 class="belowfold__title belowfold__title--open belowfold__title--center">{{ section.settings.heading }}</h1>
      {% if section.settings.lede != blank %}<p class="doc__lede">{{ section.settings.lede }}</p>{% endif %}
    </header>
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'prose' %}
          <section class="doc__block" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
            <div class="doc__rte">{{ block.settings.body }}</div>
          </section>
        {% when 'qa' %}
          <section class="doc__block doc__block--band" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
            <div class="faq">
              {% for i in (1..6) %}
                {% assign qk = 'q' | append: i %}{% assign ak = 'a' | append: i %}
                {% if block.settings[qk] != blank %}
                  <details><summary>{{ block.settings[qk] }}</summary><p>{{ block.settings[ak] }}</p></details>
                {% endif %}
              {% endfor %}
            </div>
          </section>
      {% endcase %}
    {% endfor %}
    <section class="doc__block doc__block--cta">
      <h2>{{ section.settings.cta_heading | default: 'Still got a question?' }}</h2>
      <p>We answer everything, including the awkward ones.</p>
      <a class="cta" href="/pages/contact">Email us</a>
    </section>
  </main>
  {% render 'dandy2-chrome-footer' %}
</div>
{% schema %}
{
  "name": "Dandy 2026 doc page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page title" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "cta_heading", "label": "Closing heading" },
    { "type": "select", "id": "copy_status", "label": "Internal copy status",
      "options": [ { "value": "aggressive-draft", "label": "Aggressive draft" }, { "value": "approved", "label": "Approved" } ],
      "default": "aggressive-draft" }
  ],
  "blocks": [
    { "type": "prose", "name": "Prose", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "richtext", "id": "body", "label": "Body" } ] },
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "text", "id": "q1", "label": "Q1" }, { "type": "textarea", "id": "a1", "label": "A1" },
      { "type": "text", "id": "q2", "label": "Q2" }, { "type": "textarea", "id": "a2", "label": "A2" },
      { "type": "text", "id": "q3", "label": "Q3" }, { "type": "textarea", "id": "a3", "label": "A3" },
      { "type": "text", "id": "q4", "label": "Q4" }, { "type": "textarea", "id": "a4", "label": "A4" },
      { "type": "text", "id": "q5", "label": "Q5" }, { "type": "textarea", "id": "a5", "label": "A5" },
      { "type": "text", "id": "q6", "label": "Q6" }, { "type": "textarea", "id": "a6", "label": "A6" } ] }
  ],
  "presets": [{ "name": "Dandy 2026 doc page" }]
}
{% endschema %}
