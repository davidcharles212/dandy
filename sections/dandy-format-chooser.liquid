<section
  id="format-guide"
  class="dandy-section dandy-format-chooser"
  data-copy-status="{{ section.settings.copy_status }}"
  data-claim-ids="{{ section.settings.claim_ids }}"
  aria-labelledby="DandyFormatHeading-{{ section.id }}"
>
  <div class="dandy-container dandy-container--wide dandy-format-chooser__grid">
    <div>
      <span class="dandy-kicker">{{ section.settings.eyebrow }}</span>
      <h2 id="DandyFormatHeading-{{ section.id }}" class="dandy-heading">{{ section.settings.heading }}</h2>
      <p class="dandy-body">{{ section.settings.text }}</p>
      <div class="dandy-format-chooser__cards">
        {% for block in section.blocks %}
          <article id="{{ block.settings.heading | handleize }}" class="dandy-format-card" {{ block.shopify_attributes }}>
            {% render 'dandy-icon', name: block.settings.icon %}
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
            <a class="dandy-text-link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
              {{ block.settings.link_label }} →
            </a>
          </article>
        {% endfor %}
      </div>
    </div>
    <div class="dandy-format-chooser__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag: widths: '720, 960, 1400, 1800', sizes: '(min-width: 1024px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image_alt
        }}
      {% else %}
        <picture>
          <source type="image/webp" srcset="{{ 'dandy-format-960.webp' | asset_url }} 960w, {{ 'dandy-format-1600.webp' | asset_url }} 1600w">
          <img src="{{ 'dandy-format-1400.jpg' | asset_url }}" width="1400" height="788" loading="lazy" alt="{{ section.settings.image_alt | escape }}">
        </picture>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dandy format chooser",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Dandy gummy and powder pouches held against a blue sky" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Choose your format" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple gummy or flexible powder?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Same commitment to clarity, two very different rituals. Compare what is factual about each format and choose the one that fits."
    },
    { "type": "text", "id": "claim_ids", "label": "Internal claim IDs", "default": "C-09 C-10" },
    {
      "type": "select",
      "id": "copy_status",
      "label": "Internal copy status",
      "options": [
        { "value": "aggressive-draft", "label": "Aggressive draft" },
        { "value": "approved", "label": "Approved" }
      ],
      "default": "aggressive-draft"
    }
  ],
  "blocks": [
    {
      "type": "format",
      "name": "Format",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "berry", "label": "Berry" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "package", "label": "Package" }
          ],
          "default": "berry"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Gummies" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pre-portioned, portable, and ready when you are. No measuring or mixing." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop gummies" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Dandy format chooser" }]
}
{% endschema %}
