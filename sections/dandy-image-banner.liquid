{% liquid
  if section.settings.asset == 'compare'
    assign image_jpg = 'dandy-compare-hero-2200.jpg'
    assign image_avif = 'dandy-compare-hero-1600.avif'
    assign image_small = 'dandy-compare-hero-720.webp'
    assign image_medium = 'dandy-compare-hero-1280.webp'
    assign image_large = 'dandy-compare-hero-2200.webp'
  else
    assign image_jpg = 'dandy-final-hero-2200.jpg'
    assign image_avif = 'dandy-final-hero-1600.avif'
    assign image_small = 'dandy-final-hero-720.webp'
    assign image_medium = 'dandy-final-hero-1280.webp'
    assign image_large = 'dandy-final-hero-2200.webp'
  endif
%}
<section class="dandy-image-banner dandy-image-banner--{{ section.settings.asset }}" aria-labelledby="DandyBannerHeading-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="dandy-image-banner__media" aria-hidden="true">
    <picture>
      <source type="image/avif" srcset="{{ image_avif | asset_url }}">
      <source type="image/webp" srcset="{{ image_small | asset_url }} 720w, {{ image_medium | asset_url }} 1280w, {{ image_large | asset_url }} 2200w" sizes="100vw">
      <img src="{{ image_jpg | asset_url }}" width="2200" height="1237" loading="lazy" alt="">
    </picture>
  </div>
  <div class="dandy-image-banner__content-wrap">
    <div class="dandy-image-banner__content">
      <span class="dandy-kicker">{{ section.settings.eyebrow }}</span>
      <h2 id="DandyBannerHeading-{{ section.id }}" class="dandy-heading">{{ section.settings.heading }}</h2>
      <p class="dandy-lede">{{ section.settings.text }}</p>
      <div class="dandy-actions">
        {% if section.settings.primary_label != blank %}<a class="dandy-button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="dandy-button dandy-button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dandy image banner",
  "settings": [
    {
      "type": "select",
      "id": "asset",
      "label": "Image",
      "options": [
        { "value": "final", "label": "Gummies against sky" },
        { "value": "compare", "label": "Gummy and powder" }
      ],
      "default": "final"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR NEW GO-TO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "GOOD DAYS LOOK DANDY." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Mixed berry, precisely portioned, and ready when you are." },
    { "type": "text", "id": "primary_label", "label": "Primary action", "default": "SHOP GUMMIES" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary action" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Dandy image banner" }]
}
{% endschema %}
