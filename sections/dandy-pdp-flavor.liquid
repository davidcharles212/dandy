{%- render 'dandy-fonts' -%}

<div class="dpx" style="--dpx-bg: {{ section.settings.background_color }};">
  <div class="dpx__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="dpx__heading dpx__heading--desktop">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.heading_mobile != blank -%}
      <h2 class="dpx__heading dpx__heading--mobile">{{ section.settings.heading_mobile | escape | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="dpx__body">{{ section.settings.body | escape | newline_to_br }}</p>
    {%- endif -%}
  </div>

  <dandy-pdp-flavor class="dpx__slider">
    <div class="dpx__viewport" data-dpx-viewport tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <article class="dpx__card" {{ block.shopify_attributes }}>
          <div class="dpx__media">
            {%- if block.settings.image != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 1023px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 456 }} 456w, {{ block.settings.image_mobile | image_url: width: 684 }} 684w"
                    sizes="228px"
                  >
                {%- endif -%}
                {{ block.settings.image | image_url: width: 1248 | image_tag: widths: '456, 684, 832, 1248', sizes: '(min-width: 1024px) 416px, 228px', alt: block.settings.title, loading: 'lazy', class: 'dpx__img' }}
              </picture>
            {%- endif -%}
          </div>
          <div class="dpx__text">
            {%- if block.settings.title != blank -%}
              <h3 class="dpx__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="dpx__desc">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="dpx__track" aria-hidden="true">
      <div class="dpx__rail" data-dpx-rail><span class="dpx__thumb" data-dpx-thumb></span></div>
    </div>
  </dandy-pdp-flavor>
</div>

<script>
  (() => {
    if (customElements.get('dandy-pdp-flavor')) return;

    class DandyPdpFlavor extends HTMLElement {
      connectedCallback() {
        this.viewport = this.querySelector('[data-dpx-viewport]');
        this.rail = this.querySelector('[data-dpx-rail]');
        this.thumb = this.querySelector('[data-dpx-thumb]');
        if (!this.viewport || !this.rail || !this.thumb) return;
        this.onScroll = () => {
          cancelAnimationFrame(this.raf);
          this.raf = requestAnimationFrame(() => this.update());
        };
        this.viewport.addEventListener('scroll', this.onScroll, { passive: true });
        this.resizeObserver = new ResizeObserver(this.onScroll);
        this.resizeObserver.observe(this.viewport);
        this.update();
      }

      disconnectedCallback() {
        this.viewport?.removeEventListener('scroll', this.onScroll);
        this.resizeObserver?.disconnect();
        cancelAnimationFrame(this.raf);
      }

      update() {
        const { scrollLeft, scrollWidth, clientWidth } = this.viewport;
        const max = Math.max(0, scrollWidth - clientWidth);
        const railWidth = this.rail.clientWidth;
        const width = Math.max(24, railWidth * Math.min(1, clientWidth / scrollWidth));
        this.thumb.style.width = `${width}px`;
        this.thumb.style.transform = `translateX(${(railWidth - width) * (max > 0 ? scrollLeft / max : 0)}px)`;
      }
    }

    customElements.define('dandy-pdp-flavor', DandyPdpFlavor);
  })();
</script>

{% stylesheet %}
  .dpx {
    position: relative;
    z-index: 1;
    padding: 50.5px 0 40px;
    background: var(--dpx-bg, #f4512b);
    color: #fff9f0;
    font-family: var(--dandy-font-body, sans-serif);
    font-optical-sizing: none;
    -webkit-font-smoothing: antialiased;
  }

  .dpx *,
  .dpx *::before,
  .dpx *::after {
    box-sizing: border-box;
  }

  .dpx :where(h2, h3, p, picture) {
    margin: 0;
    padding: 0;
  }

  .dpx__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 16px;
  }

  .dpx__heading--desktop {
    display: none;
  }

  .dpx .dpx__heading {
    margin: -4.57px 0 -5.06px;
    color: #fff9f0;
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 44px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dpx .dpx__body {
    margin: -4.58px 0;
    color: #fff9f0;
    font-variation-settings: 'opsz' 32;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.8px;
    letter-spacing: -0.16px;
  }

  .dpx__slider {
    display: block;
    margin-top: 27.18px;
  }

  .dpx__viewport {
    display: flex;
    gap: 16px;
    margin-bottom: -4px;
    padding: 0 16px 4px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
  }

  .dpx__viewport::-webkit-scrollbar {
    display: none;
  }

  .dpx__viewport:focus-visible {
    outline: 2px solid #fff9f0;
    outline-offset: 4px;
  }

  .dpx__card {
    display: flex;
    flex: 0 0 260px;
    flex-direction: column;
    min-height: 277px;
    padding: 16px;
    border-radius: 8px 8px 32px 8px;
    background: #fff9f0;
    box-shadow: 4px 4px 0 #a02508;
    color: #241914;
    scroll-snap-align: start;
  }

  .dpx__media {
    flex: none;
    width: 100%;
    aspect-ratio: 228 / 150;
    overflow: hidden;
    background: rgb(36 25 20 / 0.06);
  }

  .dpx__media picture,
  .dpx__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .dpx__img {
    object-fit: cover;
  }

  .dpx__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 16px;
  }

  .dpx .dpx__title {
    margin: -2.28px 0 -2.53px;
    color: #241914;
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 22px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dpx .dpx__desc {
    margin: -4.01px 0;
    color: rgb(36 25 20 / 0.8);
    font-variation-settings: 'opsz' 32;
    font-weight: 400;
    font-size: 14px;
    line-height: 18.2px;
    letter-spacing: -0.14px;
  }

  .dpx__track {
    height: 14px;
    margin: 24px 16px 0;
    padding: 4px 5px;
    border-radius: 32px;
    background: #d64827;
  }

  .dpx__rail {
    position: relative;
    height: 6px;
    overflow: hidden;
    border-radius: 32px;
    background: #a02508;
  }

  .dpx__thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 70px;
    height: 6px;
    border-radius: 32px;
    background: #fff9f0;
  }

  @media screen and (min-width: 1024px) {
    .dpx {
      padding: 45.59px 32px 63.23px;
    }

    .dpx__intro {
      align-items: center;
      gap: 24px;
      max-width: 1068px;
      margin: 0 auto;
      padding: 0;
      text-align: center;
    }

    .dpx__heading--desktop {
      display: block;
    }

    .dpx__heading--mobile {
      display: none;
    }

    .dpx .dpx__heading {
      margin: -5.48px 0 -6.07px;
      font-size: 48px;
      line-height: 52.8px;
    }

    .dpx .dpx__body {
      margin: -5.15px 0;
      font-size: 18px;
      line-height: 23.4px;
      letter-spacing: -0.18px;
    }

    .dpx__slider {
      max-width: 1408px;
      margin: 38.85px auto 0;
    }

    .dpx__viewport {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    .dpx__card {
      min-height: 486px;
      padding: 20px 20px 28px;
    }

    .dpx__media {
      aspect-ratio: 416 / 320.36;
    }

    .dpx__text {
      margin-top: 26.64px;
      padding: 0 8px;
    }

    .dpx .dpx__title {
      margin: -4.57px 0 -5.06px;
      font-size: 40px;
      line-height: 44px;
    }

    .dpx .dpx__desc {
      margin: -5.15px 0;
      font-size: 18px;
      line-height: 23.4px;
      letter-spacing: -0.18px;
    }

    .dpx__track {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dandy flavor",
  "tag": "section",
  "class": "dandy-pdp-flavor-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (desktop)", "default": "Kratom without the grimace" },
    { "type": "textarea", "id": "heading_mobile", "label": "Heading (mobile)", "default": "KRATOM WITHOUT\nTHE GRIMACE." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text",
      "default": "Traditional kratom is famously bitter. Other gummies can hide it beneath a sugary coating, until you bite in.\n\nDandy keeps the mixed-berry flavor going from the first bite to the center, with no bitter powder or foul-tasting core."
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4512B" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Optional. Uses the main image when empty." },
        { "type": "text", "id": "title", "label": "Title", "default": "Berry to the center" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A rich mixed-berry taste that does not disappear the moment you bite in."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Dandy flavor",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Berry to the center",
            "text": "A rich mixed-berry taste that does not disappear the moment you bite in."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "35mg, measured",
            "text": "A precisely portioned serving of mitragynine without forcing down bitter powder."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "No chaser required",
            "text": "One glossy gummy. No scoops, scales, capsules, shots or second drink."
          }
        }
      ]
    }
  ]
}
{% endschema %}