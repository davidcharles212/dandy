</section>

<!-- 9. Reviews -->
<section class="sec sec--flush-top ground-brown proof" id="reviews">
  <div class="ticker ticker--quotes" aria-label="Short customer quotes">
    <div class="ticker__track">
      <ul class="ticker__list"><li>Actually pretty tasty</li><li>Totally pleasant</li><li>Can barely taste the bitterness</li><li>Didn’t make me gag or wince</li><li>Go down easily</li><li>Customer for life</li></ul>
      <ul class="ticker__list" aria-hidden="true"><li>Actually pretty tasty</li><li>Totally pleasant</li><li>Can barely taste the bitterness</li><li>Didn’t make me gag or wince</li><li>Go down easily</li><li>Customer for life</li></ul>
    </div>
  </div>
  <div class="wrap">
    <h2 class="proof__title">Real people, real reviews.</h2>
    <div class="revs-clip" id="revs-clip">
    <div class="revs revs--four" id="revs">
