  assign product_url = section.settings.product_url | default: '/products/extract-capsules'
  assign advanced_url = section.settings.advanced_url
  assign discount_code = section.settings.discount_code | default: 'DISPATCH10'
  assign shipping_url = section.settings.shipping_url | default: '/pages/contact?view=dandy2-shipping'
  comment
    Offer links route through Shopify's discount redirect so the reader voucher is applied without a coupon box.
    The redirect target carries the strength, count and bundle the capsule product page pre-selects (PDP patch on
    claude/capsule-offer-url-tier; until it is live every link lands on the PDP's configured default tier).
    Variant ids are read from the store by title so a re-created variant never leaves a stale id in copy.
    Since 2026-09-13 both strengths are one product (/products/extract-capsules, "Strength" option), so both
    offers link to the same URL and the variant id picks the strength. A separate 90 mg URL in advanced_url
    is only used when the product has no Strength option.
  endcomment
  assign disc_base = '/discount/' | append: discount_code | append: '?redirect='
  assign h50 = product_url | split: '/' | last | split: '?' | first
  assign cap = all_products[h50]
  assign merged = false
  if cap.options_by_name['Strength']
    assign merged = true
    assign advanced_url = product_url
  endif
  assign v50_3 = ''
  assign v90_3 = ''
  for v in cap.variants
    if merged
      assign v_rest = v.option2 | append: ' / ' | append: v.option3
      if v_rest == '30-count / 3-pack'
        if v.option1 contains '90'
          assign v90_3 = v.id
        else
          assign v50_3 = v.id
        endif
      endif
    elsif v.title == '30-count / 3-pack'
      assign v50_3 = v.id
    endif
  endfor
  if merged == false and advanced_url != blank
    assign h90 = advanced_url | split: '/' | last | split: '?' | first
    for v in all_products[h90].variants
      if v.title == '30-count / 3-pack'
        assign v90_3 = v.id
      endif
    endfor
  endif
  assign q50_3 = '?strength=50&count=30&bundle=3'
  assign q90_3 = '?strength=90&count=30&bundle=3'
  if v50_3 != ''
    assign q50_3 = q50_3 | append: '&variant=' | append: v50_3
  endif
  if v90_3 != ''
    assign q90_3 = q90_3 | append: '&variant=' | append: v90_3
  endif
  comment
    The reader discount is already in the catalog price, so offer links go straight to the product (no /discount redirect).
  endcomment
  assign t50_3 = product_url | append: q50_3 | escape
  assign t90_3 = advanced_url | append: q90_3 | escape
-%}
