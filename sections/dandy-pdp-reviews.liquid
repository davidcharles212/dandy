{%- endcapture -%}

<div
  class="dpr{% if section.settings.art_contain %} dpr--contain{% endif %}"
  style="--dpr-bg: {{ section.settings.background_color }}; --dpr-outside: {{ section.settings.outside_color }};"
>
  <div class="dpr__bg" aria-hidden="true"></div>

  {%- if section.settings.pouch_image != blank -%}
    <div class="dpr__pouch" aria-hidden="true">
      <div class="dpr__pouch-frame dpr__pouch-frame--shadow">
        {{ section.settings.pouch_image | image_url: width: 1400 | image_tag: widths: '700, 1050, 1400', sizes: '692px', alt: '', loading: 'lazy' }}
      </div>
      <div class="dpr__pouch-frame">
        {{ section.settings.pouch_image | image_url: width: 2800 | image_tag: widths: '700, 1050, 1400, 2100, 2800', sizes: '692px', alt: '', loading: 'lazy' }}
      </div>
    </div>
  {%- elsif section.settings.pouch_image_asset != blank -%}
    <div class="dpr__pouch" aria-hidden="true">
      <div class="dpr__pouch-frame dpr__pouch-frame--shadow">
        <img src="{{ section.settings.pouch_image_asset | asset_url }}" sizes="692px" alt="" loading="lazy">
      </div>
      <div class="dpr__pouch-frame">
        <img src="{{ section.settings.pouch_image_asset | asset_url }}" sizes="692px" alt="" loading="lazy">
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.pouch_image_mobile != blank -%}
    <div class="dpr__pouch-mobile dpr__pouch-mobile--photo" aria-hidden="true">
      {{ section.settings.pouch_image_mobile | image_url: width: 2400 | image_tag: widths: '500, 1000, 1500, 2000, 2400', sizes: '117vw', alt: '', loading: 'lazy' }}
    </div>
  {%- elsif section.settings.pouch_image_mobile_asset != blank -%}
    <div class="dpr__pouch-mobile dpr__pouch-mobile--photo" aria-hidden="true">
      <img src="{{ section.settings.pouch_image_mobile_asset | asset_url }}" sizes="117vw" alt="" loading="lazy">
    </div>
  {%- endif -%}

  <div class="dpr__inner">
    <div class="dpr__rating dpr__rating--desktop">
      <span class="dpr__stars dpr__stars--rating" role="img" aria-label="{{ section.settings.rating_value | escape }} / 5">{{ dpr_stars }}</span>
      <p class="dpr__rating-text">{{ section.settings.rating_text }}</p>
    </div>

    <div class="dpr__rating dpr__rating--mobile">
      <p class="dpr__rating-value">{{ section.settings.rating_value }}</p>
      <div class="dpr__rating-sub">
        <span class="dpr__stars dpr__stars--rating" role="img" aria-label="{{ section.settings.rating_value | escape }} / 5">{{ dpr_stars }}</span>
        <p class="dpr__rating-caption">{{ section.settings.rating_caption }}</p>
      </div>
    </div>

    <h2 class="dpr__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>

    <dandy-pdp-reviews class="dpr__slider">
      <div class="dpr__viewport" data-dpr-viewport tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          <article class="dpr__card" {{ block.shopify_attributes }}>
            <span class="dpr__stars dpr__stars--card" role="img" aria-label="5 / 5">{{ dpr_stars }}</span>
            {%- if block.settings.headline != blank -%}
              <h3 class="dpr__headline">{{ block.settings.headline | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.quote != blank -%}
              {%- liquid
                assign quote_words = block.settings.quote | strip | split: ' ' | size
                assign clamp_words = section.settings.clamp_words | default: 0 | plus: 0
              -%}
              {%- if clamp_words > 0 and quote_words > clamp_words -%}
                <div class="dpr__body" data-dpr-body>
                  <p class="dpr__quote is-clamped" id="dpr-quote-{{ block.id }}">{{ block.settings.quote | escape | newline_to_br }}</p>
                  <button type="button" class="dpr__more" data-dpr-more aria-expanded="false" aria-controls="dpr-quote-{{ block.id }}" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label | escape }}</button>
                </div>
              {%- else -%}
                <p class="dpr__quote">{{ block.settings.quote | escape | newline_to_br }}</p>
              {%- endif -%}
            {%- endif -%}
            <div class="dpr__author">
              {%- if block.settings.author != blank -%}
                <p class="dpr__name">{{ block.settings.author | escape }}</p>
              {%- endif -%}
              {%- if block.settings.product != blank -%}
                <p class="dpr__product">{{ block.settings.product | escape }}</p>
              {%- endif -%}
              {%- if block.settings.show_verified -%}
                <p class="dpr__verified">
                  {%- if section.settings.verified_icon != blank -%}
                    {{ section.settings.verified_icon | image_url: width: 64 | image_tag: alt: '', width: 16, height: 16, loading: 'lazy', class: 'dpr__verified-icon' }}
                  {%- elsif section.settings.verified_icon_asset != blank -%}
                    <img src="{{ section.settings.verified_icon_asset | asset_url }}" alt="" width="16" height="16" loading="lazy" class="dpr__verified-icon">
                  {%- endif -%}
                  <span class="dpr__verified-text">{{ section.settings.verified_label }}</span>
                </p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="dpr__nav">
        <button type="button" class="dpr__arrow" data-dpr-step="-1" aria-label="{{ 'accessibility.slideshow_previous' | t | escape }}">
          <svg width="35.8" height="35.8" viewBox="-1 -1 35.8 35.8" fill="none" aria-hidden="true" focusable="false" style="display:block;width:35.8px;height:35.8px;margin:-1px;overflow:visible"><circle cx="16.9" cy="16.9" r="16.9" fill="var(--dandy-pdp-cream, #fff9f0)"/><path d="M19.5 15.9249C20.0385 15.9249 20.475 16.3614 20.475 16.8999C20.475 17.4384 20.0385 17.8749 19.5 17.8749L19.5 16.8999L19.5 15.9249ZM11.0106 17.5893C10.6298 17.2086 10.6298 16.5912 11.0106 16.2105L17.2154 10.0056C17.5962 9.62485 18.2135 9.62485 18.5943 10.0056C18.9751 10.3864 18.9751 11.0037 18.5943 11.3845L13.0789 16.8999L18.5943 22.4153C18.9751 22.7961 18.9751 23.4134 18.5943 23.7942C18.2135 24.175 17.5962 24.175 17.2154 23.7942L11.0106 17.5893ZM19.5 16.8999L19.5 17.8749L11.7 17.8749L11.7 16.8999L11.7 15.9249L19.5 15.9249L19.5 16.8999Z" fill="var(--dandy-accent, #f4512b)"/></svg>
        </button>
        <div class="dpr__track">
          <div class="dpr__rail" data-dpr-rail>
            <span class="dpr__thumb" data-dpr-thumb></span>
          </div>
        </div>
        <button type="button" class="dpr__arrow" data-dpr-step="1" aria-label="{{ 'accessibility.slideshow_next' | t | escape }}">
          <svg width="35.8" height="35.8" viewBox="-1 -1 35.8 35.8" fill="none" aria-hidden="true" focusable="false" style="display:block;width:35.8px;height:35.8px;margin:-1px;overflow:visible"><circle cx="16.9" cy="16.9" r="16.9" fill="var(--dandy-pdp-cream, #fff9f0)"/><path d="M14.3 15.9249C13.7616 15.9249 13.325 16.3614 13.325 16.8999C13.325 17.4384 13.7616 17.8749 14.3 17.8749L14.3 16.8999L14.3 15.9249ZM22.7895 17.5893C23.1702 17.2086 23.1702 16.5912 22.7895 16.2105L16.5846 10.0056C16.2039 9.62485 15.5865 9.62485 15.2058 10.0056C14.825 10.3864 14.825 11.0037 15.2058 11.3845L20.7212 16.8999L15.2058 22.4153C14.825 22.7961 14.825 23.4134 15.2058 23.7942C15.5865 24.175 16.2039 24.175 16.5846 23.7942L22.7895 17.5893ZM14.3 16.8999L14.3 17.8749L22.1 17.8749L22.1 16.8999L22.1 15.9249L14.3 15.9249L14.3 16.8999Z" fill="var(--dandy-accent, #f4512b)"/></svg>
        </button>
      </div>
    </dandy-pdp-reviews>
  </div>

  {%- if section.settings.pouch_cutout_mobile != blank -%}
    <div class="dpr__pouch-mobile" aria-hidden="true">
      {{ section.settings.pouch_cutout_mobile | image_url: width: 1600 | image_tag: widths: '430, 860, 1300, 1600', sizes: '117vw', alt: '', loading: 'lazy' }}
    </div>
  {%- elsif section.settings.pouch_cutout_mobile_asset != blank -%}
    <div class="dpr__pouch-mobile" aria-hidden="true">
      <img src="{{ section.settings.pouch_cutout_mobile_asset | asset_url }}" sizes="117vw" alt="" loading="lazy">
    </div>
  {%- endif -%}

  {%- if section.settings.person_image != blank -%}
    <div class="dpr__person" aria-hidden="true">
      {{ section.settings.person_image | image_url: width: 1300 | image_tag: widths: '325, 650, 975, 1300', sizes: '(min-width: 750px) 325px, 262px', alt: '', loading: 'lazy' }}
    </div>
  {%- elsif section.settings.person_image_asset != blank -%}
    <div class="dpr__person" aria-hidden="true">
      <img src="{{ section.settings.person_image_asset | asset_url }}" sizes="(min-width: 750px) 325px, 262px" alt="" loading="lazy">
    </div>
  {%- endif -%}

  {%- if section.settings.badge_2_value != blank or section.settings.badge_2_label != blank -%}
    <div class="dpr__badge dpr__badge--mg">
      <p class="dpr__badge-text">
        <span class="dpr__badge-big">{{ section.settings.badge_2_value | escape }}</span>
        <span class="dpr__badge-small">{{ section.settings.badge_2_label | escape | newline_to_br }}</span>
      </p>
    </div>
  {%- endif -%}

  {%- if section.settings.badge_1_value != blank or section.settings.badge_1_label != blank -%}
    <div class="dpr__badge dpr__badge--cal">
      <p class="dpr__badge-text">
        <span class="dpr__badge-big">{{ section.settings.badge_1_value | escape }}</span>
        <span class="dpr__badge-small">{{ section.settings.badge_1_label | escape | newline_to_br }}</span>
      </p>
    </div>
  {%- endif -%}

  <div class="dpr__cut" aria-hidden="true"></div>
</div>

<script>
  (() => {
    if (customElements.get('dandy-pdp-reviews')) return;
    const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    class DandyPdpReviews extends HTMLElement {
      connectedCallback() {
        this.viewport = this.querySelector('[data-dpr-viewport]');
        this.rail = this.querySelector('[data-dpr-rail]');
        this.thumb = this.querySelector('[data-dpr-thumb]');
        this.arrows = [...this.querySelectorAll('[data-dpr-step]')];
        if (!this.viewport) return;

        this.onScroll = () => {
          cancelAnimationFrame(this.raf);
          this.raf = requestAnimationFrame(() => this.update());
        };
        this.onClick = (event) => {
          const more = event.target.closest('[data-dpr-more]');
          if (more && this.contains(more)) {
            const body = more.closest('[data-dpr-body]');
            const quote = body?.querySelector('.dpr__quote');
            if (!quote) return;
            const open = quote.classList.toggle('is-clamped') === false;
            more.setAttribute('aria-expanded', open ? 'true' : 'false');
            more.textContent = open ? more.dataset.less : more.dataset.more;
            return;
          }
          const arrow = event.target.closest('[data-dpr-step]');
          if (!arrow || !this.contains(arrow)) return;
          const card = this.viewport.querySelector('.dpr__card');
          if (!card) return;
          const gap = parseFloat(getComputedStyle(this.viewport).columnGap) || 0;
          this.viewport.scrollBy({
            left: Number(arrow.dataset.dprStep) * (card.getBoundingClientRect().width + gap),
            behavior: reduceMotion() ? 'auto' : 'smooth',
          });
        };

        this.viewport.addEventListener('scroll', this.onScroll, { passive: true });
        this.addEventListener('click', this.onClick);
        this.resizeObserver = new ResizeObserver(this.onScroll);
        this.resizeObserver.observe(this.viewport);
        this.update();
      }

      disconnectedCallback() {
        this.viewport?.removeEventListener('scroll', this.onScroll);
        this.removeEventListener('click', this.onClick);
        this.resizeObserver?.disconnect();
        cancelAnimationFrame(this.raf);
      }

      update() {
        const { scrollLeft, scrollWidth, clientWidth } = this.viewport;
        const max = Math.max(0, scrollWidth - clientWidth);
        if (this.rail && this.thumb) {
          const railWidth = this.rail.clientWidth;
          const width = Math.max(24, railWidth * Math.min(1, clientWidth / scrollWidth));
          const progress = max > 0 ? scrollLeft / max : 0;
          this.thumb.style.width = `${width}px`;
          this.thumb.style.transform = `translateX(${(railWidth - width) * progress}px)`;
        }
        if (this.arrows.length === 2) {
          this.arrows[0].disabled = scrollLeft <= 1;
          this.arrows[1].disabled = scrollLeft >= max - 1;
        }
      }
    }

    customElements.define('dandy-pdp-reviews', DandyPdpReviews);
  })();
</script>

{% stylesheet %}
  .dpr {
    --dpr-u: calc(100vw / 360);
    position: relative;
    z-index: 1;
    height: auto;
    min-height: calc(362 * var(--dpr-u) + 821px);
    overflow: clip;
    background: var(--dpr-outside, var(--dandy-pdp-cream, #fff9f0));
    color: var(--dandy-pdp-cream, #fff9f0);
    font-family: var(--dandy-font-body, sans-serif);
    font-optical-sizing: none;
    -webkit-font-smoothing: antialiased;
  }

  .dpr *,
  .dpr *::before,
  .dpr *::after {
    box-sizing: border-box;
  }

  .dpr :where(h2, p) {
    margin: 0;
    padding: 0;
  }

  .dpr__bg {
    position: absolute;
    top: calc(362 * var(--dpr-u));
    right: 0;
    bottom: 2px;
    left: 0;
    background: var(--dpr-bg, var(--dandy-accent, #f4512b));
  }

  .dpr__pouch {
    display: none;
  }

  .dpr__pouch-mobile {
    position: absolute;
    top: calc(-168 * var(--dpr-u));
    left: calc(28.65 * var(--dpr-u));
    width: calc(440.68 * var(--dpr-u));
    height: calc(551 * var(--dpr-u));
    overflow: hidden;
    pointer-events: none;
    transform: rotate(12.55deg);
    transform-origin: 0 0;
  }

  .dpr__pouch-mobile img {
    position: absolute;
    top: calc(0.08 * var(--dpr-u));
    left: calc(19.82 * var(--dpr-u));
    display: block;
    width: calc(420.73 * var(--dpr-u));
    height: calc(550.83 * var(--dpr-u));
    object-fit: cover;
  }


  .dpr--contain .dpr__pouch-mobile {
    top: calc(-90 * var(--dpr-u));
    right: calc(-10 * var(--dpr-u));
    left: auto;
    width: calc(260 * var(--dpr-u));
    height: calc(260 * var(--dpr-u));
    overflow: visible;
    transform: rotate(6deg);
  }

  .dpr--contain .dpr__pouch-mobile img {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  .dpr__pouch-mobile--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(168deg, color-mix(in srgb, var(--dandy-accent, #f4512b) 0%, transparent) 78.05%, var(--dandy-accent, #f4512b) 82.66%),
      linear-gradient(163.69deg, var(--dandy-pdp-cream, #fff9f0) 24.48%, color-mix(in srgb, var(--dandy-pdp-cream, #fff9f0) 0%, transparent) 54.23%);
  }

  .dpr__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: calc(241 * var(--dpr-u));
    /* Reserves the seal and person band below the cards; the section now grows with an opened review. */
    padding-bottom: 370px;
  }

  .dpr__stars {
    display: block;
    flex: none;
    line-height: 0;
  }

  .dpr__stars svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .dpr__rating--desktop {
    display: none;
  }

  .dpr__rating--mobile {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    width: max-content;
    margin-right: calc(30 * var(--dpr-u));
    margin-left: auto;
  }

  .dpr__rating-value {
    margin: -5.71px 0 -6.32px;
    color: var(--dandy-pdp-cream, #fff9f0);
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 50px;
    line-height: 55px;
  }

  .dpr__rating-sub {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .dpr__rating--mobile .dpr__stars--rating {
    width: 70px;
    height: 14px;
    color: var(--dandy-pdp-cream, #fff9f0);
  }

  .dpr__rating-caption {
    margin: -4.01px 0;
    color: #ffffff;
    font-weight: 400;
    font-size: 14px;
    line-height: 18.2px;
    letter-spacing: -0.14px;
    text-align: right;
  }

  .dpr .dpr__heading {
   margin: calc(121 * var(--dpr-u) - 75.73px) 16px -5.06px;
    color: var(--dandy-pdp-cream, #fff9f0);
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 44px;
    letter-spacing: 0;
    text-transform: uppercase;
    text-align: left;
  }

  .dpr__slider {
