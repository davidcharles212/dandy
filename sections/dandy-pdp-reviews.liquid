  .dpr__badge {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--dandy-accent, #f4512b);
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    text-align: center;
    text-transform: uppercase;
    transform-origin: 0 0;
