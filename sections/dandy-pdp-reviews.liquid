    }

    .dpr__rating--desktop .dpr__stars--rating {
      width: 91px;
      height: 18.2px;
      color: var(--dandy-pdp-cream, #fff9f0);
    }

    .dpr .dpr__rating-text {
      margin: -5.15px 0;
      color: #ffffff;
      font-weight: 400;
      font-size: 18px;
      line-height: 23.4px;
      letter-spacing: -0.18px;
      text-align: center;
    }

    .dpr .dpr__heading {
      width: 456px;
      max-width: 100%;
      margin: 14.52px 0 -6.07px;
      font-size: 48px;
      line-height: 52.8px;
      text-align: center;
    }

    .dpr__heading br {
      display: none;
    }

    .dpr__slider {
      align-self: stretch;
      margin-top: 40px;
    }

    .dpr__viewport {
      gap: 20px;
      margin: 0 -5px -5px 0;
      padding: 0 5px 5px 0;
      scroll-padding-inline: 0;
    }

    .dpr__card {
      flex: 0 0 calc((100% - 20px) / 2);
      gap: 24px;
      padding: 24px;
      border-radius: 8px 10.4px 40px 8px;
      box-shadow: 5px 5px 0 var(--dandy-accent-deep, #a02508);
    }

    .dpr .dpr__quote,
    .dpr .dpr__name {
      margin: -5.15px 0;
      font-size: 18px;
      line-height: 23.4px;
      letter-spacing: -0.18px;
    }

    .dpr .dpr__headline {
      font-size: 19px;
      line-height: 24px;
    }

    .dpr .dpr__product {
      font-size: 14px;
      line-height: 18px;
    }

    .dpr__author {
      gap: 12px;
    }

    .dpr .dpr__verified {
      gap: 8px;
      min-height: 16px;
    }

    .dpr .dpr__verified-icon {
      width: 16px;
      height: 16px;
    }

    .dpr__nav {
      margin-top: 40px;
