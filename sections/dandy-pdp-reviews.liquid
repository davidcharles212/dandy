    }

    .dpr .dpr__arrow {
      display: block;
    }

    .dpr__track {
      flex: 0 0 328px;
      width: 328px;
    }

    .dpr__thumb {
      width: 148px;
    }

    .dpr__person {
      top: 501px;
      left: calc(50% + 90px);
      width: 325px;
      height: 407px;
    }

    .dpr__badge--cal {
      top: 617.44px;
      left: calc(50% - 322px);
      width: 201.5px;
      height: 201.5px;
      box-shadow: -1.3px 5.2px 15.34px rgb(0 0 0 / 0.08);
    }

    .dpr__badge--cal .dpr__badge-big {
      margin-top: -8.31px;
