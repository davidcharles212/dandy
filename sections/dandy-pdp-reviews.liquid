  .dpr .dpr__badge-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
  }

  .dpr__badge-big,
  .dpr__badge-small {
    display: block;
    letter-spacing: 0;
  }

  .dpr__badge--cal {
    top: auto;
    bottom: 217.36px;
    left: calc(50% - 146px);
    width: 155px;
    height: 155px;
    background: var(--dandy-pdp-cream, #fff9f0);
    box-shadow: -1px 4px 11.8px rgb(0 0 0 / 0.08);
