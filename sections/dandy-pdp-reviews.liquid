    }

    .dpr__cut {
      top: auto;
      height: 100px;
      clip-path: polygon(0 61.05px, 100% 0, 100% 100%, 0 100%);
    }
  }

  @media screen and (min-width: 1024px) {
    .dpr__card {
      flex-basis: calc((100% - 40px) / 3);
    }
  }

  @media screen and (min-width: 1280px) {
    .dpr__card {
      flex-basis: calc((100% - 60px) / 4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dpr__viewport {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dandy reviews",
  "tag": "section",
  "class": "dandy-pdp-reviews-section",
  "settings": [
    { "type": "checkbox", "id": "art_contain", "label": "Product art: fit the whole image (jar cutouts)", "default": false, "info": "Off keeps the original cover-fit slots sized for the gummy pouch art." },
    { "type": "header", "content": "Rating" },
    { "type": "text", "id": "rating_text", "label": "Rating text (desktop)", "default": "Rated 4.9 / 5 | From 1,400+ Reviews" },
    { "type": "text", "id": "rating_value", "label": "Rating number (mobile)", "default": "4.9" },
    { "type": "text", "id": "rating_caption", "label": "Rating caption (mobile)", "default": "From 1,400+ Reviews" },
    { "type": "header", "content": "Heading" },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "THE WORD\nON THE STREET.",
      "info": "The line break only applies on mobile."
    },
    { "type": "header", "content": "Reviews" },
    { "type": "range", "id": "clamp_words", "label": "Fold reviews longer than (words)", "min": 0, "max": 120, "step": 10, "default": 0, "info": "0 shows every review in full. Longer reviews fold to six lines with a Read more toggle." },
    { "type": "text", "id": "more_label", "label": "Read more label", "default": "Read more" },
    { "type": "text", "id": "less_label", "label": "Show less label", "default": "Show less" },
    { "type": "text", "id": "verified_label", "label": "Verified label", "default": "Verified Buyer" },
    { "type": "image_picker", "id": "verified_icon", "label": "Verified icon" },
    { "type": "text", "id": "verified_icon_asset", "label": "Verified icon (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." },
    { "type": "header", "content": "Badges" },
    { "type": "text", "id": "badge_1_value", "label": "Badge 1 number", "default": "20" },
    { "type": "textarea", "id": "badge_1_label", "label": "Badge 1 label", "default": "CALORIES\nPER GUMMY" },
    { "type": "text", "id": "badge_2_value", "label": "Badge 2 number", "default": "35mg" },
    { "type": "textarea", "id": "badge_2_label", "label": "Badge 2 label", "default": "PER GUMMY" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "pouch_image", "label": "Pouch and gummies (desktop)" },
    { "type": "text", "id": "pouch_image_asset", "label": "Pouch and gummies (desktop) (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." },
    { "type": "image_picker", "id": "pouch_image_mobile", "label": "Pouch and gummies (mobile)" },
    { "type": "text", "id": "pouch_image_mobile_asset", "label": "Pouch and gummies (mobile) (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." },
    { "type": "image_picker", "id": "pouch_cutout_mobile", "label": "Pouch and gummies cutout (mobile)" },
    { "type": "text", "id": "pouch_cutout_mobile_asset", "label": "Pouch and gummies cutout (mobile) (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." },
    { "type": "image_picker", "id": "person_image", "label": "Person" },
    { "type": "text", "id": "person_image_asset", "label": "Person (theme asset fallback)", "info": "Filename in assets/, used when no image is picked." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4512B" },
    { "type": "color", "id": "outside_color", "label": "Page background", "default": "#FFF9F0" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "default": "“Clean focus, a noticeably better mood, and none of the coffee edge I was trying to get away from.”"
        },
        { "type": "text", "id": "headline", "label": "Headline", "info": "Optional bold line above the review." },
        { "type": "text", "id": "author", "label": "Name", "default": "Marcus T." },
        { "type": "text", "id": "product", "label": "Product line", "info": "Optional, e.g. 90 mg Heavy-Duty." },
        { "type": "checkbox", "id": "show_verified", "label": "Show verified label", "default": true }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Dandy reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}