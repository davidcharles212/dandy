      height: 908.15px;
      pointer-events: none;
      transform: rotate(12.55deg);
      transform-origin: 0 0;
    }

    .dpr__pouch-frame--shadow {
      top: -508.66px;
      left: -87.92px;
      opacity: 0.22;
      filter: brightness(0) blur(12.45px);
    }

    .dpr__pouch-frame img {
      position: absolute;
      top: 0;
      left: 34.59px;
