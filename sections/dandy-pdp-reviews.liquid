  }

  .dpr__badge--cal .dpr__badge-small {
    margin-bottom: -2.53px;
    font-size: 20px;
    line-height: 22px;
  }

  .dpr__badge--mg {
    top: auto;
    bottom: 120.14px;
    left: calc(50% - 152.39px);
    width: 132.86px;
    height: 132.86px;
    background: #ffedd1;
    box-shadow: -1.28px 5.13px 15.12px rgb(0 0 0 / 0.08);
    transform: rotate(9.36deg);
  }

  .dpr__badge--mg .dpr__badge-big {
    margin-top: -4.48px;
    font-size: 39.25px;
    line-height: 43.18px;
  }

  .dpr__badge--mg .dpr__badge-small {
    margin-bottom: -2.42px;
    font-size: 19.15px;
    line-height: 21.07px;
  }

  .dpr__cut {
    position: absolute;
    top: auto;
    height: 112px;
    right: 0;
    bottom: -2px;
    left: 0;
    background: var(--dpr-outside, var(--dandy-pdp-cream, #fff9f0));
    clip-path: polygon(0 47.5px, 100% 0, 100% 100%, 0 100%);
  }

  @media screen and (min-width: 750px) {
    .dpr {
      height: 930px;
      overflow-x: clip;
      overflow-y: visible;
    }

    .dpr__bg {
      top: 0;
      clip-path: polygon(0 61.05px, 100% 0, 100% 100%, 0 100%);
    }

    .dpr__pouch-mobile,
    .dpr__pouch-photo {
      display: none;
    }

    .dpr__pouch {
      display: block;
    }

    .dpr__pouch-frame {
      position: absolute;
      top: -516px;
      left: -88.74px;
