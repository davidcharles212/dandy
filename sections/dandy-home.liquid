{% comment %}
  Dandy homepage, v3 (2026-09-12): rebuilt from the StefanBrain critique and redesign spec
  (HQ companies/dandy/projects/homepage-botanical-hub/sources/prd-v3-stefanbrain-critique-redesign-20260912.md),
  reconciled in blueprint.md section 13. Copy is a whitelist from that spec; ship only those strings.
  Eight sections between the home header and footer snippets: hero, lineup, clips, dose, transparency,
  reviews, FAQ, welcome. Layout: layout/dandy-home.liquid. Styles: assets/dandy-home.css.
  Behaviour and analytics: assets/dandy-home.js. QA: qa/dandy-home/run.js.
{% endcomment %}

{%- assign hm_review_count = '2,050' -%}
{%- assign hm_reviews_page = pages['reviews'] -%}
{%- if hm_reviews_page.url != blank -%}{%- assign hm_reviews_url = hm_reviews_page.url -%}{%- else -%}{%- assign hm_reviews_url = '/pages/contact?view=reviews' -%}{%- endif -%}

{%- capture stars5 -%}{%- for i in (0..4) -%}<svg class="star" style="--i:{{ i }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z"/></svg>{%- endfor -%}{%- endcapture -%}

{%- capture ico_flask -%}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M9 3h6M10 3v6.2L4.6 18.6A1.8 1.8 0 0 0 6.2 21h11.6a1.8 1.8 0 0 0 1.6-2.4L14 9.2V3"/><path pathLength="1" d="M7.2 15.5h9.6"/></svg>{%- endcapture -%}
{%- capture ico_label -%}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M3.5 11.5V3.5h8l9 9-8 8-9-9z"/><circle pathLength="1" cx="7.5" cy="7.5" r="1.3"/></svg>{%- endcapture -%}
{%- capture ico_shield -%}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M12 3l7 2.8v5.4c0 4.6-3 8.3-7 9.8-4-1.5-7-5.2-7-9.8V5.8L12 3z"/><path pathLength="1" d="M9 12l2 2 4-4"/></svg>{%- endcapture -%}
{%- capture ico_plus -%}<svg class="ico ico--plus" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13M5.5 12h13"/></svg>{%- endcapture -%}
{%- capture ico_minus -%}<svg class="ico ico--minus" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 12h13"/></svg>{%- endcapture -%}
{%- capture ico_chevron -%}<svg class="ico ico--chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture ico_play -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>{%- endcapture -%}

<div class="hm">
{% render 'dandy-home-header' %}

<main id="DandyMain" class="hm__main">

  {% comment %} 1. Hero: headline, photo, facts under the photo, lede, one CTA. Phone order is the markup order; desktop puts the photo beside the copy. {% endcomment %}
  <section class="hero" id="top" aria-labelledby="hm-h1">
    <div class="wrap hero__grid">
      <h1 class="h1 hero__h1" id="hm-h1"><span>Clean daytime lift.</span> <span>Real evening relief.</span> <span>Zero jitters or crash.</span></h1>
      <div class="hero__media">
        <figure class="hero__photo">
          <div class="hero__frame"><picture><source media="(max-width: 860px)" srcset="{{ 'home-hero-lineup-phone-900.webp' | asset_url }} 900w, {{ 'home-hero-lineup-phone-1300.webp' | asset_url }} 1300w" sizes="100vw"><img src="{{ 'home-hero-lineup-1800.webp' | asset_url }}" srcset="{{ 'home-hero-lineup-900.webp' | asset_url }} 900w, {{ 'home-hero-lineup-1800.webp' | asset_url }} 1800w" sizes="(min-width: 861px) 46vw, 100vw" width="1800" height="1200" alt="The Dandy lineup on a wooden tabletop: the Mixed Berry gummy pouch in front, the Extract Capsules jar and the raw leaf powder pouch behind it, and two sugar dusted gummies on the table" fetchpriority="high"></picture></div>
        </figure>
        <ul class="facts hero__facts">
          <li>Exact milligram dosing (35&nbsp;mg)</li>
          <li>Third-party lab tested every batch</li>
          <li>30-day money-back guarantee</li>
        </ul>
      </div>
      <p class="lede hero__lede">Pure, single-origin kratom leaf in three exact, measured formats. A natural botanical ritual to power through long workdays or unwind tight muscles at night, without coffee acid, energy drink jitters, or next-day fog.</p>
      <div class="hero__cta">
        <a class="btn btn--lg" href="#lineup" data-track="homepage_hero_cta_click" data-track-label="choose">Choose your format</a>
      </div>
    </div>
  </section>

  {% comment %} 2. Lineup: three formats side by side on hairlines, cutouts on the ground, no boxes {% endcomment %}
  <section class="lineup sec" id="lineup" aria-labelledby="hm-lineup-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="h2" id="hm-lineup-h">Three formats. One pure leaf.</h2>
        <p class="lede">Whether you want an easy midday gummy, zero-taste capsules, or traditional brewed leaf, pick the ritual that matches your day.</p>
      </div>
      <div class="lineup__grid">

        <article class="fmt fmt--gummies" data-reveal style="--i:0">
          <figure class="fmt__photo"><img src="{{ 'home-lineup-gummies-1000.webp' | asset_url }}" width="1000" height="1000" alt="The Dandy Mixed Berry gummies pouch with two gummies beside it" loading="lazy" decoding="async"></figure>
          <p class="fmt__aud">Most popular for daily lift.</p>
          <h3 class="h3 fmt__h">Mixed Berry Kratom Gummies</h3>
          <p class="fmt__str">35&nbsp;mg mitragynine per gummy</p>
          <p class="fmt__p">Sweet-tart, sugar-dusted pectin gummies that make taking kratom as simple as taking a vitamin. Delivers clean, upbeat daytime stamina within 35 minutes. Zero bitter taste.</p>
          <ul class="fmt__specs">
            <li><b>Best for:</b> midday focus, ditching afternoon espresso, upbeat mood</li>
            <li><b>Taste:</b> crisp natural berry, dusted in cane sugar</li>
            <li><b>Onset:</b> 35 to 45 minutes (lasts 3 to 4 hours)</li>
          </ul>
          <p class="fmt__price">From $24.99</p>
          <a class="btn" href="/products/mixed-berry-kratom-gummies" data-track="format_card_click" data-track-label="/products/mixed-berry-kratom-gummies">Shop gummies{{ ico_chevron }}</a>
        </article>

        <article class="fmt fmt--capsules" data-reveal style="--i:1">
          <figure class="fmt__photo"><img src="{{ 'home-lineup-capsules-1000.webp' | asset_url }}" width="1121" height="1000" alt="The Dandy Extract Capsules amber jar with capsules in front of it" loading="lazy" decoding="async"></figure>
          <p class="fmt__aud">Zero taste, fast routine.</p>
          <h3 class="h3 fmt__h">Extract Capsules</h3>
          <p class="fmt__str">50&nbsp;mg (Balanced) or 90&nbsp;mg (Concentrated)</p>
          <p class="fmt__p">Pure leaf extract packed into 100% tasteless vegetarian capsules. Slides right into your morning vitamin organizer or bedside routine with no prep and zero cleanup.</p>
          <ul class="fmt__specs">
            <li><b>Best for:</b> consistent daily dosing, active recovery, deep evening muscle ease</li>
            <li><b>Taste:</b> 100% tasteless plant cellulose</li>
            <li><b>Dose options:</b> 50&nbsp;mg (daytime focus) or 90&nbsp;mg (evening rest)</li>
          </ul>
          <p class="fmt__alt"><a href="/products/extract-capsules-90mg" data-track="format_card_click" data-track-label="/products/extract-capsules-90mg">Prefer 90&nbsp;mg? Go straight to the Concentrated capsules.</a></p>
          <p class="fmt__price">From $28.99</p>
          <a class="btn btn--ghost" href="/products/extract-capsules-50mg" data-track="format_card_click" data-track-label="/products/extract-capsules-50mg">Shop capsules{{ ico_chevron }}</a>
        </article>

        <article class="fmt fmt--powder" data-reveal style="--i:2">
          <figure class="fmt__photo"><img src="{{ 'home-lineup-powder-1000.webp' | asset_url }}" width="1000" height="1000" alt="The Dandy Premium Kratom Leaf Powder pouch" loading="lazy" decoding="async"></figure>
          <p class="fmt__aud">Traditional brew.</p>
          <h3 class="h3 fmt__h">Raw Leaf Powder</h3>
          <p class="fmt__str">100% pure micronized Mitragyna speciosa</p>
          <p class="fmt__p">Whole harvested leaf, sun-cured and micro-milled into a fine, dissolvable powder for traditional teas, smoothies, or personalized cup brewing.</p>
          <ul class="fmt__specs">
            <li><b>Best for:</b> experienced users who want complete control over their exact gram dosage</li>
            <li><b>Taste:</b> earthy, traditional green tea notes</li>
            <li><b>Sizes:</b> 100&nbsp;g and 250&nbsp;g resealable pouches</li>
          </ul>
          <p class="fmt__price">From $34.99</p>
          <a class="btn btn--ghost" href="/products/premium-kratom-leaf-powder" data-track="format_card_click" data-track-label="/products/premium-kratom-leaf-powder">Shop powder{{ ico_chevron }}</a>
        </article>

      </div>
    </div>
  </section>

  {% comment %} 3. Clips: four real customer clips in phone frames, verbatim captions, one play button each {% endcomment %}
  <section class="clips sec" id="clips" aria-labelledby="hm-clips-h">
    <div class="wrap">
      <div class="head" data-reveal><h2 class="h2" id="hm-clips-h">See how real people use Dandy.</h2></div>
      <div class="clips__grid">
        {%- assign clip_ids = 'ugc-01,ugc-02,ugc-04,ugc-05' | split: ',' -%}
        {%- assign clip_lines = 'Okay, that actually tastes like candy.|I got tired of mixing powder every time. Now I just keep these here.|Some days I want a little lift. Some days I wanna settle in. I like having the same pouch around for both.|I like that the batch number is right on the pouch. You know what you’re getting.' | split: '|' -%}
        {%- for id in clip_ids -%}
        {%- assign n = id | split: '-' | last -%}
        <figure class="ugc{% cycle ' ugc--tilt-l', ' ugc--tilt-r' %}" data-slot="{{ id }}">
          <div class="ugc__frame">
            <video class="ugc__video" playsinline preload="metadata" poster="{{ 'cshop-' | append: id | append: '-poster.jpg' | asset_url }}" width="720" height="1280">
              <source src="{{ 'cshop-' | append: id | append: '.mov' | asset_url }}" type="video/quicktime">
              <source src="{{ 'cshop-' | append: id | append: '.mp4' | asset_url }}" type="video/mp4">
            </video>
            <img class="ugc__fallback" src="{{ 'cshop-' | append: id | append: '-poster.jpg' | asset_url }}" width="720" height="1280" alt="" hidden>
            <p class="ugc__cap" aria-live="off"></p>
            <button class="ugc__play" type="button" aria-label="Play video" data-track="ugc_play" data-track-label="{{ id }}">{{ ico_play }}</button>
          </div>
          <figcaption class="ugc__q">“{{ clip_lines[forloop.index0] }}”</figcaption>
        </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <script type="application/json" id="hm-captions">{"ugc-01":[[5.57,7.3,"Okay, that actually tastes like candy."]],"ugc-02":[[2.56,4.57,"I got tired of mixing powder every time."],[8.73,10.31,"Now I just keep these here."]],"ugc-04":[[1.08,2.73,"Some days I want a little lift."],[6.65,8.79,"Some days I wanna settle in."],[10.0,12.73,"I like having the same pouch around for both."]],"ugc-05":[[6.11,8.78,"I like that the batch number is right on the pouch."],[8.87,10.02,"You know what you're getting."]]}</script>

  {% comment %} 4. Dose: a static two-sided split, light gear on cream, deep gear on ink {% endcomment %}
  <section class="dose sec" id="dose" aria-labelledby="hm-dose-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="h2" id="hm-dose-h">One plant. Two completely different gears.</h2>
        <p class="lede">Kratom is naturally dose-dependent. A lighter serving energizes your day; a larger serving relaxes your body. Here is how to dial in yours.</p>
      </div>
    </div>
    <div class="dose__split">
      <div class="gear gear--light">
        <div class="gear__in">
          <h3 class="gear__title">The light gear</h3>
          <p class="gear__range">15&nbsp;mg to 35&nbsp;mg</p>
          <p class="gear__out">Clean mental lift and stamina</p>
          <p><b>How it feels:</b> alert, upbeat, motivated, and clear-headed. Powers through your 2&nbsp;PM slump without the nervous jitters, stomach acid, or heart flutters of a third cup of coffee.</p>
          <p><b>Serving:</b> half to one Mixed Berry gummy.</p>
        </div>
      </div>
      <div class="gear gear--deep">
        <div class="gear__in">
          <h3 class="gear__title">The deep gear</h3>
          <p class="gear__range">50&nbsp;mg to 90&nbsp;mg</p>
          <p class="gear__out">Physical muscle ease and evening unwind</p>
          <p><b>How it feels:</b> deep tension release, soothing joint comfort, and calm stillness after long, demanding days on your feet.</p>
          <p><b>Serving:</b> one 50&nbsp;mg capsule in the evening.</p>
        </div>
      </div>
    </div>
  </section>

  {% comment %} 5. Transparency: three pillars on hairlines, icons draw in, link to the lab reports {% endcomment %}
  <section class="quality sec" id="quality" aria-labelledby="hm-quality-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="h2" id="hm-quality-h">The Dandy transparency standard.</h2>
        <p class="lede">Most kratom is sold in opaque packaging with mystery blends. We measure every batch down to the exact milligram.</p>
      </div>
      <ul class="quality__list" data-reveal>
        <li style="--i:0">{{ ico_flask }}<b>Four-panel third-party lab testing</b><p>Every single batch is independently screened for mitragynine potency, heavy metals, microbials, and purity. Every pouch carries a QR code linking directly to its certificate of analysis (COA).</p></li>
        <li style="--i:1">{{ ico_label }}<b>100% label honesty</b><p>When Dandy says 35&nbsp;mg, third-party lab instruments confirm 35&nbsp;mg. No synthetic spikes, no adulterants, and no mystery extracts.</p></li>
        <li style="--i:2">{{ ico_shield }}<b>30-day Feel the Shift guarantee</b><p>If you try Dandy and don't feel a noticeable difference in your daytime focus or physical ease, <a href="mailto:support@foreverdandy.com">email us</a>. We refund your purchase immediately. Keep the pouch.</p></li>
      </ul>
      <p class="quality__more"><a href="/pages/contact?view=dandy2-coa" data-track="coa_link_click">View lab reports and certificates of analysis{{ ico_chevron }}</a></p>
    </div>
  </section>

  {% comment %} 6. Reviews: rating line, format counts into the hub, three verified cards (the page's only boxes) {% endcomment %}
  <section class="revs sec" id="reviews" aria-labelledby="hm-revs-h">
    <div class="wrap">
      <div class="head revs__head" data-reveal>
        <h2 class="h2" id="hm-revs-h">Real days. Real relief.</h2>
        <p class="revs__rating"><span class="stars" aria-label="4.8 out of 5 stars">{{ stars5 }}</span><span>4.8 out of 5 rating from {{ hm_review_count }} verified&nbsp;adults</span></p>
        <ul class="facts revs__counts" aria-label="Reviews by format">
          <li><a href="{{ hm_reviews_url }}" data-track="review_filter_click" data-track-label="all">All ({{ hm_review_count }})</a></li>
          <li><a href="{{ hm_reviews_url }}{% if hm_reviews_url contains '?' %}&amp;{% else %}?{% endif %}fmt=gummies" data-track="review_filter_click" data-track-label="gummies">Gummies (1,230)</a></li>
          <li><a href="{{ hm_reviews_url }}{% if hm_reviews_url contains '?' %}&amp;{% else %}?{% endif %}fmt=capsules" data-track="review_filter_click" data-track-label="capsules">Capsules (512)</a></li>
          <li><a href="{{ hm_reviews_url }}{% if hm_reviews_url contains '?' %}&amp;{% else %}?{% endif %}fmt=powder" data-track="review_filter_click" data-track-label="powder">Powder (308)</a></li>
        </ul>
      </div>
      <div class="revs__grid">
        <article class="rev rev--first" data-reveal style="--i:0">
          <span class="stars" aria-label="5 out of 5 stars">{{ stars5 }}</span>
          <h3 class="rev__h">“Replaced my afternoon coffee without the heart flutters.”</h3>
          <p>I love coffee in the morning, but afternoon coffee started giving me acid reflux and racing thoughts. Half a Dandy gummy around 2&nbsp;PM gives me a very clean, steady lift that carries me through my workday and into an evening walk with my wife. No jitters, no crash.</p>
          <footer><span>Robert M., 54, Columbus, OH</span><span>Verified buyer · Mixed Berry Gummies (35&nbsp;mg)</span></footer>
        </article>
        <article class="rev" data-reveal style="--i:1">
          <span class="stars" aria-label="5 out of 5 stars">{{ stars5 }}</span>
          <h3 class="rev__h">“My go-to after hours working in the garden.”</h3>
          <p>I spend hours outside tending to my garden, and my lower back and hips used to scream by 5&nbsp;PM. A friend recommended Dandy capsules. One 50&nbsp;mg capsule takes the edge off the physical stiffness and puts me in a calm, cheerful mood for dinner. And because it's in a capsule, there's zero taste.</p>
          <footer><span>Patricia K., 61, Phoenix, AZ</span><span>Verified buyer · Extract Capsules (50&nbsp;mg)</span></footer>
        </article>
        <article class="rev" data-reveal style="--i:2">
          <span class="stars" aria-label="5 out of 5 stars">{{ stars5 }}</span>
          <h3 class="rev__h">“Remarkably fresh and the lab numbers match.”</h3>
          <p>I've purchased botanical powders online for over five years. Dandy's leaf is remarkably fresh: bright green color, clean aroma, and mixes smoothly into tea. The QR code on the bag pulled up the exact COA showing zero heavy metals. Outstanding quality control.</p>
          <footer><span>David K., 42, Denver, CO</span><span>Verified buyer · Premium Raw Leaf Powder</span></footer>
        </article>
      </div>
      <p class="revs__cta"><a class="btn btn--ghost" href="{{ hm_reviews_url }}" data-track="reviews_gateway_click">Read all {{ hm_review_count }} reviews</a></p>
    </div>
  </section>

  {% comment %} 7. FAQ: hairline accordion, first question open {% endcomment %}
  <section class="faq sec" id="honestly" aria-labelledby="hm-faq-h">
    <div class="wrap wrap--narrow">
      <div class="head" data-reveal><h2 class="h2" id="hm-faq-h">Kratom, honestly.</h2></div>
      <div class="faq__list" data-faq>
        <div class="faq__item">
          <h3 class="faq__q"><button type="button" id="hm-faq-b0" aria-expanded="true" aria-controls="hm-faq-p0" data-track="faq_accordion_toggle" data-track-label="0"><span>What actually is kratom?</span>{{ ico_plus }}{{ ico_minus }}</button></h3>
          <div class="faq__panel is-open" id="hm-faq-p0" role="region" aria-labelledby="hm-faq-b0"><div class="faq__a"><p>Kratom (Mitragyna speciosa) is a tropical tree native to Southeast Asia, biologically related to the coffee plant family. For generations, workers chewed the leaves for daytime endurance and evening physical relief. Dandy refines whole leaf into clean, precisely dosed gummies, capsules, and powder.</p></div></div>
        </div>
        <div class="faq__item">
          <h3 class="faq__q"><button type="button" id="hm-faq-b1" aria-expanded="false" aria-controls="hm-faq-p1" data-track="faq_accordion_toggle" data-track-label="1"><span>Will it get me high or impair my day?</span>{{ ico_plus }}{{ ico_minus }}</button></h3>
          <div class="faq__panel" id="hm-faq-p1" role="region" aria-labelledby="hm-faq-b1"><div class="faq__a"><p>No. At recommended servings (like one 35&nbsp;mg gummy), Dandy provides a clean, alert lift similar to high-grade green tea, paired with calm composure. It does not cause intoxication or mental fogginess.</p></div></div>
        </div>
        <div class="faq__item">
          <h3 class="faq__q"><button type="button" id="hm-faq-b2" aria-expanded="false" aria-controls="hm-faq-p2" data-track="faq_accordion_toggle" data-track-label="2"><span>Is it legal to ship to my state?</span>{{ ico_plus }}{{ ico_minus }}</button></h3>
          <div class="faq__panel" id="hm-faq-p2" role="region" aria-labelledby="hm-faq-b2"><div class="faq__a"><p>Kratom is 100% federally legal in the United States and legal in 34 states. We strictly abide by all state and municipal regulations and do not ship to restricted jurisdictions (including AL, AR, IN, RI, VT, WI).</p></div></div>
        </div>
        <div class="faq__item">
          <h3 class="faq__q"><button type="button" id="hm-faq-b3" aria-expanded="false" aria-controls="hm-faq-p3" data-track="faq_accordion_toggle" data-track-label="3"><span>How do I know what dose to start with?</span>{{ ico_plus }}{{ ico_minus }}</button></h3>
          <div class="faq__panel" id="hm-faq-p3" role="region" aria-labelledby="hm-faq-b3"><div class="faq__a"><p>Start with half a Mixed Berry gummy (about 17.5&nbsp;mg) on a light stomach. Wait 45 minutes to assess how your body responds. Most customers find half to one gummy perfect for daytime focus.</p></div></div>
        </div>
        <div class="faq__item">
          <h3 class="faq__q"><button type="button" id="hm-faq-b4" aria-expanded="false" aria-controls="hm-faq-p4" data-track="faq_accordion_toggle" data-track-label="4"><span>Who should not take kratom?</span>{{ ico_plus }}{{ ico_minus }}</button></h3>
          <div class="faq__panel" id="hm-faq-p4" role="region" aria-labelledby="hm-faq-b4"><div class="faq__a"><p>Dandy is strictly for adults 21 years of age and older. You should not take kratom if you are pregnant, nursing, or planning to become pregnant. If you take prescription medications or have a medical condition, talk to your physician or healthcare provider first. Like caffeine or other functional botanicals, daily habituation can occur with repeated use. We strongly advocate responsible stewardship: start with small servings, take scheduled rest days, and listen to your body.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  {% comment %} 8. Welcome offer: a centred cream-2 block with the native Shopify customer form {% endcomment %}
  <section class="welcome sec" id="welcome" aria-labelledby="hm-welcome-h">
    <div class="wrap">
      <div class="welcome__block" data-reveal data-klaviyo data-company="YiLVXU" data-list="SE5gg9">
        <h2 class="h2" id="hm-welcome-h">Take 10% off your first botanical ritual.</h2>
        <p class="lede">Join our community for transparent batch reports, educational guides, and 10% off your initial order. One email, one code, zero spam.</p>
        {%- form 'customer', id: 'HomeWelcomeForm', class: 'welcome__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="welcome__ok">Check your inbox. Your code is on its way.</p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter,dandy2-10off">
            <p class="welcome__fine">21+ only. Unsubscribe anytime. Offer valid on one-time orders and first subscription cycles.</p>
            <div class="welcome__row">
              <input class="welcome__input" id="HomeWelcomeEmail" type="email" name="contact[email]" placeholder="Enter your email address" aria-label="Enter your email address" required autocomplete="email">
              <button class="btn" type="submit">Get 10% off</button>
            </div>
            {%- if form.errors -%}<p class="welcome__err" role="alert">{{ form.errors.messages.email }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>

</main>

{% render 'dandy-home-footer', count: hm_review_count %}
</div>

{% schema %}
{
  "name": "Dandy home",
  "settings": [],
  "presets": [{ "name": "Dandy home" }]
}
{% endschema %}
