    { "type": "text", "id": "capsules_url", "label": "Capsules 50 mg product URL", "default": "/products/extract-capsules-50mg" },
    { "type": "text", "id": "capsules_90_url", "label": "Capsules 90 mg product URL", "default": "/products/extract-capsules-90mg" },
    { "type": "text", "id": "powder_url", "label": "Powder product URL", "default": "/products/premium-kratom-leaf-powder" },
    { "type": "text", "id": "coa_url", "label": "Lab reports (COA) page URL", "default": "/pages/contact?view=dandy2-coa" },
