<!-- 6. Social proof -->
<section class="proof" id="reviews">
  <div class="wrap">
    <div class="proof__head">
      <h2 class="proof__quote">“Powder, obviously, tastes disgusting. These gummies are <mark class="hi hi--inline">actually pretty tasty.”</mark></h2>
      <p class="proof__by">Tiffany F., verified customer. Switched from powder.</p>
      <a class="proof__line" href="{{ reviews_url }}"><span class="stars" aria-hidden="true">★★★★★</span><span>Rated 4.8/5</span><span class="proof__sep" aria-hidden="true"></span><span>{{ review_count }} happy buyers</span></a>
    </div>
    <div class="proof__body">
      <div class="revs" id="revs">
      <blockquote class="rev rev--photo">
        <img class="rev__photo" src="{{ 'cshop-proof-still.webp' | asset_url }}" alt="An adult holding a Dandy gummy over a desk with the open pouch beside a phone" width="1600" height="1200" loading="lazy">
