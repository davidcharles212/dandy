      <div class="ugc__frame">
        <video class="ugc__video" playsinline muted loop preload="metadata" poster="{{ 'cshop-ugc-05-poster.jpg' | asset_url }}">
          <source src="{{ video_base }}/ugc-05.webm" type="video/webm">
          <source src="{{ video_base }}/ugc-05.mp4" type="video/mp4">
