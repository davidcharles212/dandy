{%- liquid
  assign product_url = section.settings.product_url | default: '/products/mixed-berry-kratom-gummies'
  assign video_base = section.settings.video_base | default: 'https://dandy-cshop-media.indigo-hq.com'
  assign coa_url = section.settings.coa_url | default: '/pages/contact?view=dandy2-coa'
  assign ship_url = section.settings.ship_url | default: '/pages/contact?view=dandy2-shipping'
  assign review_count = section.settings.review_count | default: '1,477'
  assign reviews_url = section.settings.reviews_url | default: '/products/mixed-berry-kratom-gummies#reviews'
-%}
{%- capture ugc_controls -%}
<div class="ugc__controls">
  <button class="ugc__btn ugc__replay" type="button" aria-label="Replay video"><svg viewBox="0 0 24 24"><path d="M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"/></svg></button>
  <button class="ugc__btn ugc__cc" type="button" aria-label="Hide captions" aria-pressed="true"><svg viewBox="0 0 24 24"><path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm3.5 5.2a1.6 1.6 0 0 0-1.6 1.8 1.6 1.6 0 0 0 1.6 1.8c.6 0 1.1-.3 1.4-.8l1.5.7a3.2 3.2 0 0 1-2.9 1.7A3.3 3.3 0 0 1 4.2 12a3.3 3.3 0 0 1 3.3-3.4c1.3 0 2.4.7 2.9 1.8l-1.5.7c-.3-.6-.8-.9-1.4-.9zm8 0a1.6 1.6 0 0 0-1.6 1.8 1.6 1.6 0 0 0 1.6 1.8c.6 0 1.1-.3 1.4-.8l1.5.7a3.2 3.2 0 0 1-2.9 1.7 3.3 3.3 0 0 1-3.3-3.4 3.3 3.3 0 0 1 3.3-3.4c1.3 0 2.4.7 2.9 1.8l-1.5.7c-.3-.6-.8-.9-1.4-.9z"/></svg></button>
  <button class="ugc__btn ugc__sound" type="button" aria-label="Unmute video" aria-pressed="false"><svg class="i-off" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4zm12.5 3l2.5-2.5-1-1L15.5 11 13 8.5l-1 1 2.5 2.5L12 14.5l1 1 2.5-2.5 2.5 2.5 1-1z"/></svg><svg class="i-on" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4zm11 3a3 3 0 0 0-1.7-2.7v5.4A3 3 0 0 0 15 12zm-1.7-6.8v2.1A5 5 0 0 1 17 12a5 5 0 0 1-3.7 4.7v2.1A7 7 0 0 0 19 12a7 7 0 0 0-5.7-6.8z"/></svg></button>
</div>
{%- endcapture -%}

<!-- 0. Trust ticker -->
<div class="ticker" aria-label="Product facts">
  <div class="ticker__track">
    <ul class="ticker__list">
      <li>Mixed Berry Kratom Gummies</li><li>21+ only</li><li>Batch tested</li><li>30-day money-back guarantee</li><li>Good days look Dandy</li>
    </ul>
    <ul class="ticker__list" aria-hidden="true">
      <li>Mixed Berry Kratom Gummies</li><li>21+ only</li><li>Batch tested</li><li>30-day money-back guarantee</li><li>Good days look Dandy</li>
    </ul>
  </div>
</div>

<header class="topbar">
  <a class="topbar__brand" href="/" aria-label="Dandy home"><img src="{{ 'dandy-wordmark.svg' | asset_url }}" alt="Dandy" width="96" height="36"></a>
  <a class="btn btn--sm" href="#offer">Try Mixed Berry Gummies</a>
</header>

<main>

<!-- 1. Hero: giant product macro with berry glaze and pouch -->
<section class="hero" id="top">
  <div class="hero__media">
    <picture class="hero__plate">
      <source media="(min-width: 1900px)" srcset="{{ 'cshop-hero-wide.webp' | asset_url }}" type="image/webp">
      <img src="{{ 'cshop-hero-tall.webp' | asset_url }}" alt="Berry syrup dripping down a cream wall behind the Dandy Mixed Berry pouch on a candy counter" width="1600" height="1986" fetchpriority="high">
    </picture>
    <img class="hero__giant" src="{{ 'cshop-hero-gummy.webp' | asset_url }}" alt="A sugar-coated Dandy Mixed Berry gummy" width="1200" height="970" fetchpriority="high">
    <div class="hero__sparkles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </div>
  <div class="hero__copy">
    <h1>Kratom that tastes like something you want again.</h1>
    <p class="hero__lede">Soft, sugar-coated Mixed Berry Gummies for anyone who is done with powder mouth, bitter chasers, and mixing every time.</p>
    <div class="hero__cta">
      <a class="btn btn--lg" href="#offer">Try Mixed Berry Gummies</a>
      <img class="hero__candy" src="{{ 'cshop-cta-gummy.webp' | asset_url }}" alt="" width="140" height="140" aria-hidden="true">
    </div>
    <p class="hero__trust"><span>21+ only</span><span>Batch tested</span><span>30-day money-back guarantee</span></p>
  </div>
</section>

<!-- 2. Flavor proof and the cost of the old ritual -->
<section class="flavor" id="flavor">
  <div class="wrap">
    <div class="flavor__head">
      <h2>No powder mouth. No bitter chaser. No mixing ceremony.</h2>
      <p>Just a soft, sugar-coated Mixed Berry gummy that tastes genuinely good and gives you a simpler way to keep kratom in your day.</p>
    </div>
  </div>

  <!-- 2b. The part you learned to tolerate (cost of staying) -->
  <div class="wrap cost">
    <figure class="cost__media">
      <img src="{{ 'cshop-old-ritual.webp' | asset_url }}" alt="A kitchen scale, an unwashed scoop, a cloudy glass with green residue and a used napkin on a counter" width="1600" height="1200" loading="lazy">
    </figure>
    <div class="cost__text">
      <h3>The part you learned to tolerate.</h3>
      <p>You’ve got a scale somewhere in a drawer. A scoop that never got washed. And a taste you’ve learned to tolerate.</p>
      <p class="cost__end">That’s the part that ends.</p>
    </div>
  </div>

  <div class="wrap">
    <div class="flavor__grid">
      <figure class="flavor__cell flavor__cell--big">
        <img src="{{ 'cshop-loop-flavor-poster.jpg' | asset_url }}" alt="Thick berry glaze meeting the sugar crust of a Dandy gummy" width="720" height="538" loading="lazy">
        <figcaption>Berry glaze over coarse sugar. Soft all the way through.</figcaption>
      </figure>
      <figure class="flavor__cell">
        <img src="{{ 'cshop-flavor-cutaway.webp' | asset_url }}" alt="A Dandy gummy cut in half showing its glossy berry-red centre" width="2048" height="1536" loading="lazy">
        <figcaption>Glossy berry centre. Nothing chalky, nothing to chase.</figcaption>
      </figure>
      <figure class="flavor__cell">
        <img src="{{ 'cshop-flavor-pull.webp' | asset_url }}" alt="Berry syrup stretching between two halves of a Dandy gummy" width="2048" height="1536" loading="lazy">
        <figcaption>One gummy. 35 mg mitragynine. Nothing to measure.</figcaption>
      </figure>
    </div>
  </div>

  <div class="wrap ugcrow">
    <div class="ugcrow__aside"><h3>The first bite usually says it.</h3><p>Someone who has used kratom for years, tasting a Mixed Berry gummy for the first time. No chaser in the frame.</p>
      <figure class="ugcrow__still"><img src="{{ 'cshop-gummy-bite.webp' | asset_url }}" alt="A Dandy gummy bitten in half on a white surface" width="1600" height="1600" loading="lazy"></figure></div>
    <figure class="ugc" id="ugc-01" data-slot="ugc-01" data-label="UGC-01 | Existing first-bite flavor reaction">
      <div class="ugc__frame">
        <video class="ugc__video" playsinline muted loop preload="metadata" poster="{{ 'cshop-ugc-01-poster.jpg' | asset_url }}">
          <source src="{{ video_base }}/ugc-01.webm" type="video/webm">
          <source src="{{ video_base }}/ugc-01.mp4" type="video/mp4">
        </video>
        <img class="ugc__fallback" src="{{ 'cshop-ugc-01-poster.jpg' | asset_url }}" alt="" hidden>
        <p class="ugc__cap" aria-live="off"></p>
        {{ ugc_controls }}
        <span class="ugc__meta">UGC-01 | Existing first-bite flavor reaction</span>
      </div>
      <figcaption>An experienced kratom user, first bite.</figcaption>
    </figure>
  </div>
</section>

<!-- 3. Format switch -->
<section class="format" id="format">
  <div class="wrap">
    <div class="format__head">
      <h2>Same plant. Much easier ritual.</h2>
      <p>If you already use kratom, you already know the routine. This is the part that gets easier.</p>
    </div>
    <div class="format__cols">
      <article class="fmt fmt--old">
        <img src="{{ 'cshop-powder-column.webp' | asset_url }}" alt="A spoon of powder, a cloudy glass and a used napkin on a desk" width="1280" height="1600" loading="lazy">
        <h3>Powder</h3><p>Measure. Mix. Chase.</p>
      </article>
      <article class="fmt fmt--old">
        <img src="{{ 'cshop-format-capsules.webp' | asset_url }}" alt="A capsule bottle pushed aside by a Dandy gummy" width="1280" height="1600" loading="lazy">
        <h3>Capsules</h3><p>Portable, but not exactly a treat.</p>
      </article>
      <article class="fmt fmt--new">
        <img src="{{ 'cshop-format-gummy.webp' | asset_url }}" alt="A hand holding a Dandy gummy with the pouch in an open desk drawer behind" width="1280" height="1600" loading="lazy">
        <h3>Gummies</h3><p>Grab one. Enjoy the flavor. Keep moving.</p>
      </article>
    </div>
  </div>
  <div class="wrap ugcrow ugcrow--loop">
    <div class="ugcrow__aside">
      <h3>The old routine, then the new one.</h3><p>The spoon, the glass and the napkin leave the desk. The pouch and one gummy take their place.</p>
      <figure class="loop loop--wide" data-loop="format">
        <img class="loop__still" src="{{ 'cshop-loop-format-poster.jpg' | asset_url }}" alt="The Dandy pouch and one gummy on a cleared desk" width="1280" height="800" loading="lazy">
        <video class="loop__video" playsinline muted loop preload="none" poster="{{ 'cshop-loop-format-poster.jpg' | asset_url }}" aria-label="Powder, spoon and glass slide out of a desk scene and the Dandy pouch with one gummy slides in">
          <source src="{{ video_base }}/format-switch-loop.webm" type="video/webm">
          <source src="{{ video_base }}/format-switch-loop.mp4" type="video/mp4">
        </video>
      </figure>
    </div>
    <figure class="ugc" id="ugc-02" data-slot="ugc-02" data-label="UGC-02 | Existing powder-to-gummy format switch">
      <div class="ugc__frame">
        <video class="ugc__video" playsinline muted loop preload="metadata" poster="{{ 'cshop-ugc-02-poster.jpg' | asset_url }}">
          <source src="{{ video_base }}/ugc-02.webm" type="video/webm">
          <source src="{{ video_base }}/ugc-02.mp4" type="video/mp4">
        </video>
        <img class="ugc__fallback" src="{{ 'cshop-ugc-02-poster.jpg' | asset_url }}" alt="" hidden>
        <p class="ugc__cap" aria-live="off"></p>
        {{ ugc_controls }}
        <span class="ugc__meta">UGC-02 | Existing powder-to-gummy format switch</span>
      </div>
      <figcaption>The old routine, then the new one.</figcaption>
    </figure>
  </div>
</section>

<!-- 4. Mechanism: LIFT / FOCUS / SETTLE -->
<section class="mech" id="mechanism">
  <div class="wrap">
    <div class="mech__head">
      <h2>The same plant can meet you in more than one place.</h2>
      <p>Kratom is dose-dependent. Smaller amounts tend to produce energy and focus. Larger amounts lean toward body ease and relaxation. The amount is printed on the pouch, so you know what you are taking.</p>
    </div>
    <div class="mech__stage" data-state="lift">
      <figure class="mech__loop loop" data-loop="mechanism">
        <img class="loop__still" src="{{ 'cshop-loop-mechanism-poster.jpg' | asset_url }}" alt="One Dandy gummy on a saucer" width="1024" height="1280" loading="lazy">
        <video class="loop__video" playsinline muted loop preload="none" poster="{{ 'cshop-loop-mechanism-poster.jpg' | asset_url }}" aria-label="One Dandy gummy moving through a bright morning, a focused desk and a warm evening">
          <source src="{{ video_base }}/mechanism-loop.webm" type="video/webm">
          <source src="{{ video_base }}/mechanism-loop.mp4" type="video/mp4">
        </video>
        <span class="mech__label" aria-hidden="true"><b data-for="lift">Lift</b><b data-for="focus">Focus</b><b data-for="settle">Settle</b></span>
      </figure>
      <div class="states" role="radiogroup" aria-label="Three parts of the day one pouch can fit. An explanation, not a dosing guide.">
        <button class="state" type="button" role="radio" aria-checked="true" data-state="lift">
          <img src="{{ 'cshop-day-morning.webp' | asset_url }}" alt="" width="1280" height="1600" loading="lazy">
          <span class="state__text"><b>Lift</b><small>Smaller amounts</small><p>For the mornings when you want to get moving.</p></span>
        </button>
        <button class="state" type="button" role="radio" aria-checked="false" data-state="focus">
          <img src="{{ 'cshop-day-desk.webp' | asset_url }}" alt="" width="1280" height="1600" loading="lazy">
          <span class="state__text"><b>Focus</b><small>In between</small><p>For the hours when you want to stay with the thing in front of you.</p></span>
        </button>
        <button class="state" type="button" role="radio" aria-checked="false" data-state="settle">
          <img src="{{ 'cshop-day-evening.webp' | asset_url }}" alt="" width="1280" height="1600" loading="lazy">
          <span class="state__text"><b>Settle</b><small>Larger amounts</small><p>For when the day is done and your body knows it.</p></span>
        </button>
      </div>
      <div class="states__dots" aria-hidden="true"><i class="is-on"></i><i></i><i></i></div>
    </div>
    <p class="mech__line">One pouch can fit a brighter morning, a focused afternoon, or a slower evening at home.</p>
    <p class="mech__note">This is an explanation, not a dosing calculator. People respond differently. Start with the amount on the pouch and see how one gummy sits with you.</p>
  </div>
  <div class="wrap ugcrow">
    <div class="ugcrow__aside"><h3>Same pouch. Three different parts of the day.</h3><p>A morning coffee, a working afternoon, an evening on the couch, with one pouch moving between them.</p>
      <figure class="ugcrow__still ugcrow__still--wide"><img src="{{ 'cshop-day-social.webp' | asset_url }}" alt="Dandy pouch on a picnic table in the afternoon sun" width="1600" height="1986" loading="lazy"></figure></div>
    <figure class="ugc" id="ugc-04" data-slot="ugc-04" data-label="UGC-04 | Existing one-pouch, different-moments story">
      <div class="ugc__frame">
        <video class="ugc__video" playsinline muted loop preload="metadata" poster="{{ 'cshop-ugc-04-poster.jpg' | asset_url }}">
          <source src="{{ video_base }}/ugc-04.webm" type="video/webm">
          <source src="{{ video_base }}/ugc-04.mp4" type="video/mp4">
        </video>
        <img class="ugc__fallback" src="{{ 'cshop-ugc-04-poster.jpg' | asset_url }}" alt="" hidden>
        <p class="ugc__cap" aria-live="off"></p>
        {{ ugc_controls }}
        <span class="ugc__meta">UGC-04 | Existing one-pouch, different-moments story</span>
      </div>
      <figcaption>One pouch, kept around for more than one kind of day.</figcaption>
    </figure>
  </div>
</section>

