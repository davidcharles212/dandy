        <img class="ugc__fallback" src="{{ 'cshop-ugc-04-poster.jpg' | asset_url }}" alt="" hidden>
        <p class="ugc__cap" aria-live="off"></p>
        {{ play_button }}
        <span class="ugc__meta">UGC-04 | Existing one-pouch, different-moments story</span>
      </div>
    </figure>
  </div>
</section>

