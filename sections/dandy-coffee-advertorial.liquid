<script>
(function(){
  var bar=document.getElementById('bar'),hero=document.querySelector('.headline');
  if(!bar||!hero)return;
  function tick(){
    var past=window.scrollY>hero.offsetTop+hero.offsetHeight+200;
    var offer=document.getElementById('offer');
    var atOffer=offer&&offer.getBoundingClientRect().top<window.innerHeight-80;
    var on=past&&!atOffer;
    bar.classList.toggle('is-on',on);bar.setAttribute('aria-hidden',on?'false':'true');
    bar.querySelector('a').tabIndex=on?0:-1;
  }
  window.addEventListener('scroll',tick,{passive:true});window.addEventListener('resize',tick);tick();
})();
</script>

