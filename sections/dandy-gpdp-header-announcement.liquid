{%- render 'dandy-fonts', preload: true -%}

{%- liquid
  assign text = section.settings.text
  assign text_mobile = section.settings.text_mobile | default: section.settings.text
  assign scroll = section.settings.mobile_scroll
  assign has_link = false
  if section.settings.link != blank
    assign has_link = true
  endif
-%}

{%- if text != blank -%}
  <div
    class="dandy-header-announcement"
    style="--dandy-header-announcement-bg: {{ section.settings.background_color }}; --dandy-header-announcement-fg: {{ section.settings.text_color }}; --dandy-announcement-duration: {{ section.settings.mobile_scroll_speed | default: 18 }}s;"
    role="region"
    aria-label="Announcement"
  >
    {%- if has_link -%}<a class="dandy-header-announcement__link" href="{{ section.settings.link }}">{%- endif -%}
    {%- capture icon_html -%}
    {%- if section.settings.icon != blank -%}
      <span class="dandy-header-announcement__icon">
        {{-
          section.settings.icon
          | image_url: width: 72
          | image_tag: alt: '', loading: 'eager', width: 23, height: 18, class: 'dandy-header-announcement__icon-img'
        -}}
      </span>
    {%- elsif section.settings.show_default_icon -%}
      <span class="dandy-header-announcement__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="23" height="18" viewBox="0 0 23 18" fill="none" focusable="false"><path transform="translate(0.8236 0.1908)" fill-rule="evenodd" clip-rule="evenodd" d="M13.8782 0.035988L21.7005 3.81771C21.8305 3.88013 21.9064 4.00957 21.9066 4.14445L21.9075 13.1732C21.9075 13.3267 21.8118 13.4581 21.6766 13.5114L13.8782 17.2817C13.7744 17.3315 13.6586 17.3278 13.562 17.2817L5.73965 13.4999C5.6097 13.4375 5.5338 13.3081 5.53351 13.1732V12.4175H2.17523C1.97369 12.4175 1.8101 12.2546 1.8101 12.0538C1.8101 11.8531 1.97369 11.6901 2.17523 11.6901H8.24032H8.24981C8.44704 11.685 8.60545 11.524 8.60545 11.3264C8.60545 11.1257 8.44186 10.9628 8.24032 10.9628H5.53322V10.2211H0.365125C0.163588 10.2211 0 10.0581 0 9.8574C0 9.65666 0.163588 9.49372 0.365125 9.49372H6.43022H6.43971C6.63694 9.48856 6.79535 9.32763 6.79535 9.13004C6.79535 8.9293 6.63176 8.76636 6.43022 8.76636H5.53322L5.53294 8.02382H2.17523C1.97369 8.02382 1.8101 7.86087 1.8101 7.66013C1.8101 7.45939 1.97369 7.29645 2.17523 7.29645H8.24032H8.24981C8.44704 7.2913 8.60545 7.13036 8.60545 6.93277C8.60545 6.73203 8.44186 6.56909 8.24032 6.56909H5.53294L5.53265 4.14445C5.53265 3.99096 5.62839 3.85952 5.76351 3.80625L13.562 0.035988C13.6657 -0.0138393 13.7816 -0.0101166 13.8782 0.035988ZM7.08486 5.12123C6.90374 5.03447 6.82784 4.8174 6.91495 4.63699C7.00206 4.45658 7.21999 4.38098 7.40111 4.46775L13.7201 7.52297L20.0393 4.46775C20.2204 4.38098 20.4384 4.45658 20.5255 4.63699C20.6126 4.8174 20.5367 5.03447 20.3556 5.12123L14.0743 8.15812C14.0815 8.18647 14.0852 8.21597 14.0852 8.24632V15.6193C14.0852 15.8201 13.9216 15.983 13.7201 15.983C13.5185 15.983 13.355 15.8201 13.355 15.6193V8.24632C13.355 8.21597 13.3587 8.18647 13.3659 8.15812L7.08486 5.12123ZM17.4564 11.7989C17.296 11.679 17.2632 11.4516 17.3837 11.2918C17.5042 11.132 17.7324 11.0994 17.8929 11.2193L18.2065 11.4533L18.8126 9.4101C18.8692 9.21795 19.0716 9.10799 19.2645 9.1644C19.4574 9.22081 19.5678 9.42241 19.5112 9.61456L18.7568 12.158C18.7444 12.1984 18.7255 12.2374 18.6984 12.2732C18.578 12.433 18.3497 12.4656 18.1893 12.3456L17.4564 11.7989Z" fill="currentColor"/></svg>
      </span>
    {%- endif -%}
    {%- endcapture -%}
    <span class="dandy-header-announcement__icon-static">{{ icon_html }}</span>
    <span class="dandy-header-announcement__text dandy-header-announcement__text--desktop">{{ text }}</span>
    {%- if scroll -%}
      <span class="dandy-header-announcement__marquee" aria-hidden="true">
        <span class="dandy-header-announcement__track">
          <span class="dandy-header-announcement__item">{{ icon_html }}<span class="dandy-header-announcement__text">{{ text_mobile }}</span></span>
          <span class="dandy-header-announcement__item">{{ icon_html }}<span class="dandy-header-announcement__text">{{ text_mobile }}</span></span>
        </span>
      </span>
      <span class="visually-hidden dandy-header-announcement__text--sr">{{ text_mobile }}</span>
    {%- else -%}
      <span class="dandy-header-announcement__text dandy-header-announcement__text--mobile">{{ text_mobile }}</span>
    {%- endif -%}
    {%- if has_link -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .dandy-header-announcement-section {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .dandy-header-announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    min-height: 30px;
    margin: 0;
    padding: 4px 10px;
    border: 0;
    box-shadow: none;
    background: var(--dandy-header-announcement-bg, #f4512b);
    color: var(--dandy-header-announcement-fg, #fff9f0);
    font-family: var(--dandy-font-body, var(--font-body--family));
    font-optical-sizing: none;
    font-weight: 700;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0;
    text-transform: uppercase;
    text-align: center;
  }

  .dandy-header-announcement,
  .dandy-header-announcement__link {
    gap: 10px;
  }

  .dandy-header-announcement__link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .dandy-header-announcement__icon {
    display: inline-flex;
    flex: none;
    width: 18px;
    height: 14px;
  }

  .dandy-header-announcement__icon :is(svg, img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dandy-header-announcement__text--desktop {
    display: none;
  }

  .dandy-header-announcement__marquee {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 16px), transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 16px), transparent);
  }

  .dandy-header-announcement__track {
    display: flex;
    width: max-content;
    animation: dandy-announcement-scroll var(--dandy-announcement-duration, 18s) linear infinite;
  }

  .dandy-header-announcement__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-inline-end: 40px;
  }

  .dandy-header-announcement__track .dandy-header-announcement__text {
    white-space: nowrap;
  }

  .dandy-header-announcement__icon-static {
    display: none;
  }

  .dandy-header-announcement:hover .dandy-header-announcement__track {
    animation-play-state: paused;
  }

  @keyframes dandy-announcement-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dandy-header-announcement__track {
      animation: none;
    }
  }

  @media screen and (min-width: 750px) {
    .dandy-header-announcement {
      min-height: 40px;
      padding: 5.2px 13px;
      font-size: 18px;
    }

    .dandy-header-announcement,
    .dandy-header-announcement__link {
      gap: 13px;
    }

    .dandy-header-announcement__icon {
      width: 23px;
      height: 18px;
    }

    .dandy-header-announcement__text--desktop {
      display: block;
    }

    .dandy-header-announcement__icon-static {
      display: inline-flex;
    }

    .dandy-header-announcement__marquee,
    .dandy-header-announcement__text--mobile,
    .dandy-header-announcement__text--sr {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gummy PDP announcement",
  "tag": "div",
  "class": "dandy-header-announcement-section",
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Text (desktop)", "default": "FREE US SHIPPING ON 2+ POUCHES | 30-DAY GUARANTEE" },
    { "type": "inline_richtext", "id": "text_mobile", "label": "Text (mobile)", "info": "Leave empty to reuse the desktop text.", "default": "FREE US SHIPPING ON 2+ POUCHES | 100% PURE LEAF EXTRACT | ZERO SYNTHETICS | 30-DAY GUARANTEE" },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Auto-scroll on mobile", "default": true },
    { "type": "range", "id": "mobile_scroll_speed", "label": "Scroll duration", "min": 8, "max": 40, "step": 1, "unit": "s", "default": 18 },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Custom icon",
      "info": "Displayed at 23 × 18px (18 × 14px on mobile). Leave empty to use the default delivery icon."
    },
    { "type": "checkbox", "id": "show_default_icon", "label": "Show default delivery icon", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4512B" },
    { "type": "color", "id": "text_color", "label": "Text and icon", "default": "#FFF9F0" }
  ],
  "presets": [{ "name": "Dandy header announcement" }]
}
{% endschema %}