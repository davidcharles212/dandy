{%- render 'dandy-fonts' -%}

<div class="dpm" style="--dpm-bg: {{ section.settings.background_color }};">
  <div class="dpm__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="dpm__heading dpm__only-desktop">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.heading_mobile != blank -%}
      <h2 class="dpm__heading dpm__only-mobile">{{ section.settings.heading_mobile | escape | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="dpm__body dpm__only-desktop">{{ section.settings.body | escape }}</p>
    {%- endif -%}
    {%- if section.settings.body_mobile != blank -%}
      <p class="dpm__body dpm__only-mobile">{{ section.settings.body_mobile | escape }}</p>
    {%- endif -%}
  </div>

  <dandy-pdp-moments class="dpm__slider">
    <div class="dpm__viewport" data-dpm-viewport tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <article class="dpm__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- assign focal = block.settings.image.presentation.focal_point | default: '50% 50%' -%}
            {%- assign img_style = 'object-position: ' | append: focal -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '450, 675, 900, 1200, 1600', sizes: '(min-width: 1280px) 674px, (min-width: 750px) 90vw, 450px', alt: '', loading: 'lazy', class: 'dpm__img', style: img_style }}
          {%- endif -%}
          <div class="dpm__text">
            {%- if block.settings.title != blank -%}
              <h3 class="dpm__title">{{ block.settings.title | escape | newline_to_br }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="dpm__desc">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="dpm__nav">
      <button type="button" class="dpm__arrow" data-dpm-step="-1" aria-label="{{ 'accessibility.slideshow_previous' | t | escape }}">
        <svg width="35.8" height="35.8" viewBox="-1 -1 35.8 35.8" fill="none" aria-hidden="true" focusable="false" style="display:block;width:35.8px;height:35.8px;margin:-1px;overflow:visible"><circle cx="16.9" cy="16.9" r="16.9" fill="#F4512B"/><path d="M19.5 15.9249C20.0385 15.9249 20.475 16.3614 20.475 16.8999C20.475 17.4384 20.0385 17.8749 19.5 17.8749L19.5 16.8999L19.5 15.9249ZM11.0106 17.5893C10.6298 17.2086 10.6298 16.5912 11.0106 16.2105L17.2154 10.0056C17.5962 9.62485 18.2135 9.62485 18.5943 10.0056C18.9751 10.3864 18.9751 11.0037 18.5943 11.3845L13.0789 16.8999L18.5943 22.4153C18.9751 22.7961 18.9751 23.4134 18.5943 23.7942C18.2135 24.175 17.5962 24.175 17.2154 23.7942L11.0106 17.5893ZM19.5 16.8999L19.5 17.8749L11.7 17.8749L11.7 16.8999L11.7 15.9249L19.5 15.9249L19.5 16.8999Z" fill="#FFF9F0"/></svg>
      </button>
      <div class="dpm__track">
        <div class="dpm__rail" data-dpm-rail><span class="dpm__thumb" data-dpm-thumb></span></div>
      </div>
      <button type="button" class="dpm__arrow" data-dpm-step="1" aria-label="{{ 'accessibility.slideshow_next' | t | escape }}">
        <svg width="35.8" height="35.8" viewBox="-1 -1 35.8 35.8" fill="none" aria-hidden="true" focusable="false" style="display:block;width:35.8px;height:35.8px;margin:-1px;overflow:visible"><circle cx="16.9" cy="16.9" r="16.9" fill="#F4512B"/><path d="M14.3 15.9249C13.7616 15.9249 13.325 16.3614 13.325 16.8999C13.325 17.4384 13.7616 17.8749 14.3 17.8749L14.3 16.8999L14.3 15.9249ZM22.7895 17.5893C23.1702 17.2086 23.1702 16.5912 22.7895 16.2105L16.5846 10.0056C16.2039 9.62485 15.5865 9.62485 15.2058 10.0056C14.825 10.3864 14.825 11.0037 15.2058 11.3845L20.7212 16.8999L15.2058 22.4153C14.825 22.7961 14.825 23.4134 15.2058 23.7942C15.5865 24.175 16.2039 24.175 16.5846 23.7942L22.7895 17.5893ZM14.3 16.8999L14.3 17.8749L22.1 17.8749L22.1 16.8999L22.1 15.9249L14.3 15.9249L14.3 16.8999Z" fill="#FFF9F0"/></svg>
      </button>
    </div>
  </dandy-pdp-moments>
</div>

<script>
  (() => {
    if (customElements.get('dandy-pdp-moments')) return;
    const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    class DandyPdpMoments extends HTMLElement {
      connectedCallback() {
        this.viewport = this.querySelector('[data-dpm-viewport]');
        this.rail = this.querySelector('[data-dpm-rail]');
        this.thumb = this.querySelector('[data-dpm-thumb]');
        this.arrows = [...this.querySelectorAll('[data-dpm-step]')];
        if (!this.viewport) return;

        this.onScroll = () => {
          cancelAnimationFrame(this.raf);
          this.raf = requestAnimationFrame(() => this.update());
        };
        this.onClick = (event) => {
          const arrow = event.target.closest('[data-dpm-step]');
          if (!arrow || !this.contains(arrow)) return;
          const card = this.viewport.querySelector('.dpm__card');
          if (!card) return;
          const gap = parseFloat(getComputedStyle(this.viewport).columnGap) || 0;
          this.viewport.scrollBy({
            left: Number(arrow.dataset.dpmStep) * (card.getBoundingClientRect().width + gap),
            behavior: reduceMotion() ? 'auto' : 'smooth',
          });
        };

        this.viewport.addEventListener('scroll', this.onScroll, { passive: true });
        this.addEventListener('click', this.onClick);
        this.resizeObserver = new ResizeObserver(this.onScroll);
        this.resizeObserver.observe(this.viewport);
        this.update();
      }

      disconnectedCallback() {
        this.viewport?.removeEventListener('scroll', this.onScroll);
        this.removeEventListener('click', this.onClick);
        this.resizeObserver?.disconnect();
        cancelAnimationFrame(this.raf);
      }

      update() {
        const { scrollLeft, scrollWidth, clientWidth } = this.viewport;
        const max = Math.max(0, scrollWidth - clientWidth);
        if (this.rail && this.thumb) {
          const railWidth = this.rail.clientWidth;
          const width = Math.max(24, railWidth * Math.min(1, clientWidth / scrollWidth));
          this.thumb.style.width = `${width}px`;
          this.thumb.style.transform = `translateX(${(railWidth - width) * (max > 0 ? scrollLeft / max : 0)}px)`;
        }
        if (this.arrows.length === 2) {
          this.arrows[0].disabled = scrollLeft <= 1;
          this.arrows[1].disabled = scrollLeft >= max - 1;
        }
      }
    }

    customElements.define('dandy-pdp-moments', DandyPdpMoments);
  })();
</script>

{% stylesheet %}
  .dpm {
    position: relative;
    z-index: 1;
    padding: 42.5px 0 40px;
    background: var(--dpm-bg, #fff9f0);
    color: #241914;
    font-family: var(--dandy-font-body, sans-serif);
    font-optical-sizing: none;
    -webkit-font-smoothing: antialiased;
  }

  .dpm *,
  .dpm *::before,
  .dpm *::after {
    box-sizing: border-box;
  }

  .dpm :where(h2, h3, p) {
    margin: 0;
    padding: 0;
  }

  .dpm__only-desktop {
    display: none;
  }

  .dpm__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 16px;
  }

  .dpm .dpm__heading {
    margin: -4.57px 0 -5.06px;
    color: #241914;
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 44px;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dpm .dpm__body {
    margin: -4.58px 0;
    color: #241914;
    font-variation-settings: 'opsz' 32;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.8px;
    letter-spacing: -0.16px;
  }

  .dpm__slider {
    display: block;
    margin-top: 32.16px;
  }

  .dpm__viewport {
    display: flex;
    gap: 16px;
    margin-bottom: -4px;
    padding: 0 16px 4px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
  }

  .dpm__viewport::-webkit-scrollbar {
    display: none;
  }

  .dpm__viewport:focus-visible {
    outline: 2px solid #241914;
    outline-offset: 4px;
  }

  .dpm__card {
    position: relative;
    display: flex;
    flex: 0 0 225px;
    flex-direction: column;
    justify-content: flex-end;
    height: 357px;
    overflow: hidden;
    padding: 16px;
    border-radius: 8px;
    background: #241914;
    box-shadow: 4px 4px 0 #f4512b;
    color: #fff9f0;
    scroll-snap-align: start;
    isolation: isolate;
  }

  .dpm__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 45.36%, #000 100%);
    pointer-events: none;
  }

  .dpm__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border: 1px solid #f4512b;
    border-radius: inherit;
    pointer-events: none;
  }

  .dpm__img {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dpm__text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .dpm .dpm__title {
    margin: -2.28px 0 -2.53px;
    color: #fff9f0;
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 22px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dpm .dpm__desc {
    margin: -4.01px 0;
    color: #fff9f0;
    font-variation-settings: 'opsz' 32;
    font-weight: 400;
    font-size: 14px;
    line-height: 18.2px;
    letter-spacing: -0.14px;
  }

  .dpm__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    margin-top: 24px;
    padding: 0 16px;
  }

  .dpm .dpm__arrow {
    display: none;
    flex: none;
    width: 33.8px;
    height: 33.8px;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    box-shadow: none;
    line-height: 0;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .dpm .dpm__arrow:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .dpm .dpm__arrow:focus-visible {
    outline: 2px solid #241914;
    outline-offset: 2px;
  }

  .dpm__track {
    flex: 1 1 auto;
    width: 100%;
    height: 14px;
    padding: 4px 5px;
    border-radius: 32px;
    background: #d64827;
  }

  .dpm__rail {
    position: relative;
    height: 6px;
    overflow: hidden;
    border-radius: 32px;
    background: #a02508;
  }

  .dpm__thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 70px;
    height: 6px;
    border-radius: 32px;
    background: #fff9f0;
  }

  @media screen and (min-width: 750px) {
    .dpm {
      padding: 38.95px 32px 29.2px;
    }

    .dpm__only-mobile {
      display: none;
    }

    .dpm__only-desktop {
      display: block;
    }

    .dpm__intro {
      align-items: center;
      gap: 24px;
      max-width: 614px;
      margin: 0 auto;
      padding: 0;
      text-align: center;
    }

    .dpm .dpm__heading {
      margin: -5.48px 0 -6.07px;
      font-size: 48px;
      line-height: 52.8px;
    }

    .dpm .dpm__body {
      margin: -5.15px 0;
      color: rgb(36 25 20 / 0.8);
      font-size: 18px;
      line-height: 23.4px;
      letter-spacing: -0.18px;
    }

    .dpm__slider {
      max-width: 1408px;
      margin: 39.25px auto 0;
    }

    .dpm__viewport {
      gap: 20px;
      margin: 0 -5.2px -5.2px 0;
      padding: 0 5.2px 5.2px 0;
      scroll-padding-inline: 0;
    }

    .dpm__card {
      flex: 0 0 calc((100% - 20px) / 2);
      height: auto;
      aspect-ratio: 337 / 436;
      padding: 24px 24px 25px;
      box-shadow: 5.2px 5.2px 0 #f4512b;
    }

    .dpm__text {
      gap: 20px;
    }

    .dpm .dpm__title {
      margin: -2.97px 0 -3.29px;
      font-size: 26px;
      line-height: 28.6px;
    }

    .dpm .dpm__desc {
      margin: -4.58px 0;
      font-size: 16px;
      line-height: 20.8px;
      letter-spacing: -0.16px;
    }

    .dpm__nav {
      margin-top: 40px;
      padding: 0;
    }

    .dpm .dpm__arrow {
      display: block;
    }

    .dpm__track {
      flex: 0 0 328px;
      width: 328px;
    }

    .dpm__thumb {
      width: 148px;
    }
  }

  @media screen and (min-width: 1024px) {
    .dpm__card {
      flex-basis: calc((100% - 40px) / 3);
    }
  }

  @media screen and (min-width: 1280px) {
    .dpm__card {
      flex-basis: calc((100% - 60px) / 4);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dandy feel good",
  "tag": "section",
  "class": "dandy-pdp-moments-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (desktop)", "default": "Feel good. Get Into Everything" },
    { "type": "textarea", "id": "heading_mobile", "label": "Heading (mobile)", "default": "Feel good.\nGet into everything.", "info": "Press Enter to set the line break." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text (desktop)",
      "default": "Not a sugar-rush jolt. A more balanced way to bring some momentum to whatever the day has planned."
    },
    {
      "type": "textarea",
      "id": "body_mobile",
      "label": "Text (mobile)",
      "default": "The warm mood lift is what makes the energy, focus and social spark feel different."
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFF9F0" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "title", "label": "Title", "default": "Warm, euphoric lift", "info": "Press Enter to force a line break." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Feel lighter, brighter and genuinely excited to get into your day." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Dandy feel good",
      "blocks": [
        { "type": "card", "settings": { "title": "Warm, euphoric lift", "text": "Feel lighter, brighter and genuinely excited to get into your day." } },
        { "type": "card", "settings": { "title": "Everything feels\nmore engaging", "text": "Work, workouts, errands and plans become easier to get into." } },
        { "type": "card", "settings": { "title": "Clearer focus", "text": "When everything feels more interesting, staying locked in comes naturally." } },
        { "type": "card", "settings": { "title": "Social energy", "text": "Feel more open, talkative and ready to go do something." } },
        { "type": "card", "settings": { "title": "Physical ease", "text": "Take some of the edge off while staying awake, clear and present." } }
      ]
    }
  ]
}
{% endschema %}