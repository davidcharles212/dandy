{%- comment -%}
  Dandy announcement bar (Figma nodes 17102:251 desktop / 17102:2898 mobile).
  Lives in the header group. Desktop: 40px tall, Inter Bold 18px. Mobile (<750px): 30px, 14px.
{%- endcomment -%}
{%- render 'dandy-fonts', preload: true -%}

{%- liquid
  assign text = section.settings.text
  assign has_link = false
  if section.settings.link != blank
    assign has_link = true
  endif
-%}

{%- if text != blank -%}
  <div
    class="dandy-announcement"
    style="--dandy-announcement-bg: {{ section.settings.background_color }}; --dandy-announcement-fg: {{ section.settings.text_color }};"
    role="region"
    aria-label="Announcement"
  >
    {%- if has_link -%}<a class="dandy-announcement__link" href="{{ section.settings.link }}">{%- endif -%}
    {%- if section.settings.icon != blank -%}
      <span class="dandy-announcement__icon">
        {{-
          section.settings.icon
          | image_url: width: 72
          | image_tag: alt: '', loading: 'eager', width: 23, height: 18, class: 'dandy-announcement__icon-img'
        -}}
      </span>
    {%- elsif section.settings.show_default_icon -%}
      <span class="dandy-announcement__icon" aria-hidden="true">
        {{- 'dandy-icon-delivery.svg' | inline_asset_content -}}
      </span>
    {%- endif -%}
    <span class="dandy-announcement__text">{{ text }}</span>
    {%- if has_link -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .dandy-announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 4px 10px;
    background: var(--dandy-announcement-bg, #f4512b);
    color: var(--dandy-announcement-fg, #fff9f0);
    font-family: var(--dandy-font-body);
    font-optical-sizing: none;
    font-weight: 700;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0;
    text-transform: uppercase;
    text-align: center;
  }

  .dandy-announcement,
  .dandy-announcement__link {
    gap: 10px;
  }

  .dandy-announcement__link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .dandy-announcement__icon {
    display: inline-flex;
    flex: none;
    width: 18px;
    height: 14px;
  }

  .dandy-announcement__icon :is(svg, img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (min-width: 750px) {
    .dandy-announcement {
      min-height: 40px;
      padding: 5.2px 13px;
      font-size: 18px;
    }

    .dandy-announcement,
    .dandy-announcement__link {
      gap: 13px;
    }

    .dandy-announcement__icon {
      width: 23px;
      height: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dandy announcement bar",
  "tag": "aside",
  "class": "dandy-announcement-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Free shipping on 3+ packs" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Custom icon",
      "info": "Displayed at 23 × 18px (18 × 14px on mobile). Leave empty to use the default delivery icon."
    },
    { "type": "checkbox", "id": "show_default_icon", "label": "Show default delivery icon", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4512B" },
    { "type": "color", "id": "text_color", "label": "Text and icon", "default": "#FFF9F0" }
  ],
  "presets": [{ "name": "Dandy announcement bar" }]
}
{% endschema %}
