{%- render 'dandy-fonts' -%}
<style>
  @media screen and (min-width: 1024px) {
    .dpi .dpi__card { padding-bottom: 37px; }
    .dpi .dpi__product--desktop { top: auto; bottom: -2px; right: -2px; }
  }
</style>

<div class="dpi" style="--dpi-bg: {{ section.settings.background_color }}; --dpi-card: {{ section.settings.card_color }};">
  <div class="dpi__card">
    {%- if section.settings.product_image != blank -%}
      <div class="dpi__product dpi__product--desktop" aria-hidden="true">
        {{ section.settings.product_image | image_url: width: 2000 | image_tag: widths: '700, 1050, 1400, 2000', sizes: '514px', alt: '', loading: 'lazy' }}
      </div>
    {%- endif -%}

    {%- if section.settings.heading_small != blank or section.settings.heading_large != blank -%}
      <h2 class="dpi__heading">
        <span class="dpi__heading-small">{{ section.settings.heading_small | escape }}</span>
        <span class="dpi__heading-large">{{ section.settings.heading_large | escape }}</span>
      </h2>
    {%- endif -%}

    {%- if section.settings.hand_image != blank -%}
      <div class="dpi__hand" aria-hidden="true">
        {{ section.settings.hand_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '192px', alt: '', loading: 'lazy' }}
      </div>
    {%- endif -%}

    <ul class="dpi__items">
      {%- for i in (1..3) -%}
        {%- liquid
          assign title_key = 'item_' | append: i | append: '_title'
          assign text_key = 'item_' | append: i | append: '_text'
          assign image_key = 'item_' | append: i | append: '_image'
          assign item_title = section.settings[title_key]
          assign item_text = section.settings[text_key]
          assign item_image = section.settings[image_key]
        -%}
        {%- if item_title != blank or item_text != blank -%}
          <li class="dpi__item dpi__item--{{ i }}">
            <span class="dpi__tile" aria-hidden="true">
              {%- if item_image != blank -%}
                <span class="dpi__ing">
                  {{ item_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '143px', alt: '', loading: 'lazy' }}
                </span>
              {%- endif -%}
            </span>
            <span class="dpi__item-text">
              {%- if item_title != blank -%}
                <span class="dpi__item-title">{{ item_title | escape }}</span>
              {%- endif -%}
              {%- if item_text != blank -%}
                <span class="dpi__item-desc">{{ item_text | escape }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      {%- if section.settings.ingredients != blank -%}
        <button type="button" class="dpi__button" data-dpi-open aria-haspopup="dialog">
          <span class="dpi__button-label">{{ section.settings.button_label | escape }}</span>
          <span class="dpi__plus" aria-hidden="true"><svg viewBox="0 0 22.88 22.88" fill="none" focusable="false"><rect width="22.88" height="22.88" rx="11.44" fill="#F4512B"/><path d="M10.3482 16.6402V6.24023H12.5318V16.6402H10.3482ZM5.71997 12.4328V10.4477H17.16V12.4328H5.71997Z" fill="#FFF9F0"/></svg></span>
        </button>
      {%- else -%}
        <a class="dpi__button" href="{{ section.settings.button_link | default: '#' }}">
          <span class="dpi__button-label">{{ section.settings.button_label | escape }}</span>
          <span class="dpi__plus" aria-hidden="true"><svg viewBox="0 0 22.88 22.88" fill="none" focusable="false"><rect width="22.88" height="22.88" rx="11.44" fill="#F4512B"/><path d="M10.3482 16.6402V6.24023H12.5318V16.6402H10.3482ZM5.71997 12.4328V10.4477H17.16V12.4328H5.71997Z" fill="#FFF9F0"/></svg></span>
        </a>
      {%- endif -%}
    {%- endif -%}

    {%- assign product_mobile = section.settings.product_image_mobile | default: section.settings.product_image -%}
    {%- if product_mobile != blank -%}
      <div class="dpi__product dpi__product--mobile" aria-hidden="true">
        {{ product_mobile | image_url: width: 1800 | image_tag: widths: '600, 1200, 1800', sizes: '440px', alt: '', loading: 'lazy' }}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.ingredients != blank -%}
    <dialog class="dpi__dialog" data-dpi-dialog aria-label="{{ section.settings.button_label | escape }}">
      <div class="dpi__dialog-inner" tabindex="-1" autofocus>
        <button type="button" class="dpi__close" data-dpi-close aria-label="Close">
          <svg class="dpi__close-icon" viewBox="0 0 17.6 17.6" fill="none" aria-hidden="true" focusable="false"><rect width="17.6" height="17.6" rx="8.8" fill="#F4512B"/><path d="M4.40002 9.56359V8.03662H13.2V9.56359H4.40002Z" fill="#FFF9F0"/></svg>
        </button>
        <p class="dpi__dialog-title">{{ section.settings.button_label | escape }}</p>
        <div class="dpi__dialog-body">{{ section.settings.ingredients }}</div>
      </div>
    </dialog>
    <script>
      (() => {
        const root = document.currentScript.closest('.shopify-section') || document;
        const dialog = root.querySelector('[data-dpi-dialog]');
        const open = root.querySelector('[data-dpi-open]');
        if (!dialog || !open) return;
        open.addEventListener('click', () => dialog.showModal());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog || event.target.closest('[data-dpi-close]')) dialog.close();
        });
      })();
    </script>
  {%- endif -%}
</div>

<style>
  .dpi {
    position: relative;
    z-index: 1;
    padding: 0 16px 40px;
    background: var(--dpi-bg, #fff9f0);
    color: #fff9f0;
    font-family: var(--dandy-font-body, sans-serif);
    font-optical-sizing: none;
    -webkit-font-smoothing: antialiased;
  }

  .dpi *,
  .dpi *::before,
  .dpi *::after {
    box-sizing: border-box;
  }

  .dpi :where(h2, p, ul) {
    margin: 0;
    padding: 0;
  }

  .dpi :where(ul) {
    list-style: none;
  }

  .dpi__card {
    position: relative;
    display: flex;
    flex-direction: column;
    max-width: 560px;
    min-height: 799px;
    margin: 0 auto;
    overflow: hidden;
    padding: 24px 17px 0 16px;
    border-radius: 8px 8px 32px 8px;
    background: var(--dpi-card, #f4512b);
  }

  .dpi__product {
    position: absolute;
    pointer-events: none;
  }

  .dpi__product img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dpi__product--desktop {
    display: none;
  }

  .dpi__product--mobile {
    position: relative;
    flex: none;
    width: calc((100% + 33px) * 1.33973);
    height: auto;
    aspect-ratio: 439.43 / 371.22;
    margin: 12.54px 0 calc((100% + 33px) * -0.18524) calc(-16px - (100% + 33px) * 0.29476);
  }

  .dpi__hand {
    position: absolute;
    top: 4px;
    right: 0;
    width: 96px;
    height: 185px;
    pointer-events: none;
  }

  .dpi__hand img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dpi .dpi__heading {
    position: relative;
    display: flex;
    flex-direction: column;
    color: #fff9f0;
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dpi__heading-small {
    display: block;
    margin-top: -2.57px;
    font-size: 40px;
    line-height: 40px;
  }

  .dpi__heading-large {
    display: block;
    margin-bottom: -5.35px;
    font-size: 70px;
    line-height: 70px;
  }

  .dpi__items {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 43.92px;
  }

  .dpi .dpi__item {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 52px;
  }

  .dpi__tile {
    position: relative;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: linear-gradient(165.96deg, #cf4322 10%, #a6361b 121.1%);
  }

  .dpi__ing {
    position: absolute;
    display: block;
    pointer-events: none;
    transform-origin: 0 0;
  }

  .dpi__ing img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dpi__item--1 .dpi__ing {
    top: 14.7px;
    left: -25.1px;
    width: 87.95px;
    height: 52.93px;
    transform: rotate(-19.47deg);
  }

  .dpi__item--1 .dpi__ing img {
    object-position: 50% 100%;
  }

  .dpi__item--2 .dpi__ing {
    top: -3.66px;
    left: -18px;
    width: 79.2px;
    height: 66px;
    transform: rotate(-9.55deg);
  }

  .dpi__item--3 .dpi__ing {
    top: 66.43px;
    left: 50.8px;
    width: 83.02px;
    height: 55.34px;
    transform: rotate(-151.28deg);
  }

  .dpi__item-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 221px;
  }

  @media screen and (max-width: 1023px) {
    .dpi__item--3 .dpi__item-text {
      max-width: 229px;
    }
  }

  .dpi .dpi__item-title,
  .dpi .dpi__item-desc {
    display: block;
    color: #fff9f0;
    font-variation-settings: 'opsz' 32;
    letter-spacing: -0.16px;
  }

  .dpi .dpi__item-title {
    margin: -4.58px 0;
    font-weight: 700;
    font-size: 16px;
    line-height: 20.8px;
  }

  .dpi .dpi__item-desc {
    margin: -4.01px 0;
    font-weight: 400;
    font-size: 14px;
    line-height: 18.2px;
    letter-spacing: -0.14px;
  }

  .dpi .dpi__button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    height: 57px;
    margin: 29px 0 0;
    padding: 0 17.4px 0 20px;
    border: 0;
    border-radius: 8px;
    background: #fff9f0;
    box-shadow: 4px 4px 0 #a02508;
    color: #f4512b;
    text-decoration: none;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .dpi .dpi__button:focus-visible {
    outline: 2px solid #fff9f0;
    outline-offset: 4px;
  }

  .dpi__button-label {
    margin: -2.28px 0 -2.53px;
    color: #f4512b;
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 22px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dpi__plus {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 17.6px;
    height: 17.6px;
    border-radius: 50%;
    background: #f4512b;
  }

  .dpi .dpi__plus {
    background: none;
    border-radius: 0;
  }

  .dpi .dpi__plus svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dpi .dpi__plus {
    overflow: visible;
  }

  .dpi__dialog {
    box-sizing: border-box;
    width: min(360px, 100vw);
    max-width: 100vw;
    height: fit-content;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    overflow-y: auto;
    border: 0;
    border-radius: 9px;
    background: #fff9f0;
    box-shadow: none;
    color: #241914;
    font-family: var(--dandy-font-body, sans-serif);
    font-optical-sizing: none;
    -webkit-font-smoothing: antialiased;
  }

  .dpi__dialog::backdrop {
    background: rgb(36 25 20 / 0.5);
  }

  .dpi__dialog,
  .dpi__dialog-inner {
    outline: none;
  }

  .dpi__dialog-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px 16px;
  }

  .dpi .dpi__close {
    position: absolute;
    top: 29px;
    right: 16.4px;
    display: block;
    width: 17.6px;
    height: 17.6px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    box-shadow: none;
    line-height: 0;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
  }

  .dpi .dpi__close:focus {
    outline: none;
  }

  .dpi .dpi__close:focus-visible {
    outline: 2px solid #f4512b;
    outline-offset: 2px;
  }

  .dpi__close-icon {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dpi .dpi__dialog-title {
    margin: -2.74px 30px -3.03px 0;
    color: #f4512b;
    font-family: var(--dandy-font-display, sans-serif);
    font-weight: 400;
    font-size: 24px;
    line-height: 26.4px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dpi__dialog-body {
    margin-top: 32.37px;
  }

  .dpi .dpi__dialog-body p {
    margin: -4.58px 0;
    color: rgb(36 25 20 / 0.8);
    font-variation-settings: 'opsz' 32;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.8px;
    letter-spacing: -0.16px;
  }

  .dpi .dpi__dialog-body p + p {
    margin-top: 25.38px;
  }

  .dpi .dpi__dialog-body :is(strong, b) {
    font-weight: 700;
  }

  @media screen and (min-width: 1024px) {
    .dpi {
      padding: 40px 32px 70px;
    }

    .dpi__card {
      display: block;
      max-width: 1408px;
      min-height: 355px;
      overflow: visible;
      padding: 131px 40px 37px;
      clip-path: inset(-60px 0 0 0 round 0 0 32px 8px);
    }

    .dpi__product--mobile,
    .dpi__hand {
      display: none;
    }

    .dpi .dpi__heading {
      position: absolute;
      top: 36.92px;
      left: 40px;
      z-index: 1;
      display: block;
      white-space: nowrap;
    }

    .dpi__heading-small,
    .dpi__heading-large {
      display: inline;
      margin: 0;
      font-size: 48px;
      line-height: 48px;
    }

    .dpi__product--desktop {
      top: auto;
      bottom: -2px;
      right: -2px;
      display: block;
      width: 480px;
      height: 397px;
      overflow: hidden;
      border-radius: 0;
    }

    .dpi__product--desktop img {
      width: calc(100% / 0.93);
      height: calc(100% / 0.94);
      object-position: 0 0;
    }

    .dpi__items {
      display: grid;
      grid-template-columns: 466px auto;
      grid-template-rows: 70px 70px;
      row-gap: 47px;
      column-gap: 0;
      margin: 0;
    }

    .dpi .dpi__item {
      gap: 49px;
      min-height: 70px;
    }

    .dpi__item--1 {
      grid-column: 1;
      grid-row: 1;
    }

    .dpi__item--2 {
      grid-column: 1;
      grid-row: 2;
    }

    .dpi__item--3 {
      grid-column: 2;
      grid-row: 1;
    }

    .dpi__tile {
      width: 70px;
      height: 70px;
      border-radius: 10.4px;
    }

    .dpi__item--1 .dpi__ing {
      top: 18.53px;
      left: -40px;
      width: 142.62px;
      height: 85.82px;
    }

    .dpi__item--2 .dpi__ing {
      top: -10.49px;
      left: -34px;
      width: 129.1px;
      height: 107.58px;
    }

    .dpi__item--3 .dpi__ing {
      top: 105.07px;
      left: 71.77px;
      width: 129.62px;
      height: 86.41px;
    }

    .dpi__item-text {
      gap: 15.6px;
      max-width: 287.3px;
    }

    .dpi .dpi__item-title {
      margin: -5.72px 0;
      font-size: 20px;
      line-height: 26px;
      letter-spacing: -0.2px;
    }

    .dpi .dpi__item-desc {
      margin: -4.58px 0;
      font-size: 16px;
      line-height: 20.8px;
      letter-spacing: -0.16px;
    }

    .dpi .dpi__button {
      position: absolute;
      top: 243px;
      left: 506px;
      width: 383.5px;
      height: 74.1px;
      margin: 0;
      padding: 0 22.62px 0 26px;
      border-radius: 10.4px;
      box-shadow: 5.2px 5.2px 0 #a02508;
    }

    .dpi__button-label {
      margin: -2.97px 0 -3.29px;
      font-size: 26px;
      line-height: 28.6px;
    }

    .dpi__button .dpi__plus {
      width: 22.88px;
      height: 22.88px;
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1471px) {
    .dpi__product--desktop {
      width: clamp(0px, calc(100% - 952px), 478px);
      height: auto;
      aspect-ratio: 478 / 395;
      top: auto;
      bottom: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Dandy ingredients",
  "tag": "section",
  "class": "dandy-pdp-ingredients-section",
  "settings": [
    { "type": "text", "id": "heading_small", "label": "Heading line 1", "default": "What's in a" },
    { "type": "text", "id": "heading_large", "label": "Heading line 2", "default": "Dandy?" },
    { "type": "header", "content": "Ingredient 1" },
    { "type": "text", "id": "item_1_title", "label": "Title", "default": "KRATOM LEAF EXTRACT" },
    { "type": "textarea", "id": "item_1_text", "label": "Text", "default": "Exactly 35mg of mitragynine per gummy for a consistent experience." },
    { "type": "image_picker", "id": "item_1_image", "label": "Image" },
    { "type": "header", "content": "Ingredient 2" },
    { "type": "text", "id": "item_2_title", "label": "Title", "default": "REAL BERRY FLAVOR" },
    { "type": "textarea", "id": "item_2_text", "label": "Text", "default": "Natural mixed berry flavor with color from carrot and blueberry." },
    { "type": "image_picker", "id": "item_2_image", "label": "Image" },
    { "type": "header", "content": "Ingredient 3" },
    { "type": "text", "id": "item_3_title", "label": "Title", "default": "PLANT-BASED PECTIN" },
    { "type": "textarea", "id": "item_3_text", "label": "Text", "default": "A gelatin-free gummy base made with organic tapioca syrup and cane sugar." },
    { "type": "image_picker", "id": "item_3_image", "label": "Image" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Full ingredients list" },
    { "type": "richtext", "id": "ingredients", "label": "Full ingredients", "info": "Opens in a pop-up. Leave empty to use the link instead." },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "header", "content": "Product image" },
    { "type": "image_picker", "id": "product_image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "product_image_mobile", "label": "Image (mobile)", "info": "Optional. Uses the desktop image when empty." },
    { "type": "image_picker", "id": "hand_image", "label": "Hand (mobile)" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#F4512B" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFF9F0" }
  ],
  "presets": [{ "name": "Dandy ingredients" }]
}
{% endschema %}