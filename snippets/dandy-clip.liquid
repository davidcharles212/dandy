{%- comment -%}
  Phone clip: one poster, one round play button, tap to play with sound, tap again to pause; no replay, caption or sound controls.
  Params: name (asset base, e.g. 'cshop-ugc-01'), poster (asset filename), slot (id and caption key), tilt ('l'|'r'),
          label (dev-only meta), video (optional Shopify video object from a section setting), base (external base URL, optional).
  Captions: a <script type="application/json" id="dandy-captions"> keyed by slot, each cue [start, end, "verbatim text"].
{%- endcomment -%}
{%- if base != blank -%}
  {%- assign mov = base | append: '/' | append: name | append: '.mov' -%}
  {%- assign mp4 = base | append: '/' | append: name | append: '.mp4' -%}
{%- else -%}
  {%- assign mov = name | append: '.mov' | asset_url -%}
  {%- assign mp4 = name | append: '.mp4' | asset_url -%}
{%- endif -%}
<figure class="clip{% if tilt == 'l' %} clip--tilt-l{% elsif tilt == 'r' %} clip--tilt-r{% endif %}" id="{{ slot }}" data-slot="{{ slot }}">
  <div class="clip__frame">
    {%- if video != blank -%}
    {{ video | video_tag: image_size: '720x', playsinline: true, preload: 'metadata', controls: false, autoplay: false, loop: false, muted: false, class: 'clip__video' }}
    {%- else -%}
    <video class="clip__video" playsinline preload="metadata" poster="{{ poster | asset_url }}">
      <source src="{{ mov }}" type="video/quicktime">
      <source src="{{ mp4 }}" type="video/mp4">
    </video>
    {%- endif -%}
    <img class="clip__fallback" src="{{ poster | asset_url }}" alt="" hidden>
    <p class="clip__cap" aria-live="off"></p>
    <button class="clip__play" type="button" aria-label="Play video"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>
    {%- if label != blank %}<span class="clip__meta">{{ label }}</span>{% endif -%}
  </div>
</figure>
