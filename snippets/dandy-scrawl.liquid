{%- comment -%}
  The hand-drawn berry scrawl: one path everywhere so it reads as one hand. pathLength=1, drawn in by the nearest .is-in ancestor.
  Params: variant ('underline'|'strike'|'signature'), blush (true for the accent stroke on dark grounds).
  Underline: inside <mark class="hi">. Strike: inside .strip__word. Signature: inside <span class="scrawled">.
{%- endcomment -%}
{%- if variant == 'strike' -%}
<svg class="scrawl scrawl--strike{% if blush %} scrawl--blush{% endif %}" viewBox="0 0 320 16" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 9c38-5 76-4 114-3 46 1 88-4 134-2 22 1 42 2 64 4"/></svg>
{%- elsif variant == 'signature' -%}
<svg class="scrawl scrawl--signature{% if blush %} scrawl--blush{% endif %}" viewBox="0 0 320 16" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 10c38-6 76-5 114-4 46 1 88-5 134-3 22 1 42 3 64 6"/></svg>
{%- else -%}
<svg class="scrawl scrawl--underline{% if blush %} scrawl--blush{% endif %}" viewBox="0 0 320 16" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 10c38-6 76-5 114-4 46 1 88-5 134-3 22 1 42 3 64 6"/></svg>
{%- endif -%}
