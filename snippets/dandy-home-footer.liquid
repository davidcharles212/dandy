{% comment %}
  Dandy home footer (render with `count: <review count>`; defaults to 2,050): ink ground, four columns, legal block, payment marks. Self-contained;
  shared by the homepage and the reviews hub. Copy from blueprint section 6.9.
{% endcomment %}
<footer class="hf">
  <div class="wrap">
    <div class="hf__cols">
      <div class="hf__brand">
        <img class="hf__mark" src="{{ 'dandy-wordmark.svg' | asset_url }}" width="112" height="42" alt="Dandy" loading="lazy">
        <p class="hf__tag">Clean energy, easy unwinding, and honest botanical transparency. Formulated for adults 21+.</p>
        <p class="hf__contact"><a href="mailto:support@foreverdandy.com">support@foreverdandy.com</a><br>Mon to Fri, 9am to 5pm CT</p>
      </div>
      <nav class="hf__col" aria-labelledby="hf-shop">
        <h2 id="hf-shop">Shop</h2>
        <a href="/products/mixed-berry-kratom-gummies">Mixed Berry Gummies (35 mg)</a>
        <a href="/products/extract-capsules-50mg">Extract Capsules (50 mg and 90 mg)</a>
        <a href="/products/premium-kratom-leaf-powder">Premium Raw Leaf Powder</a>
        <a href="/products/mixed-berry-kratom-gummies">Starter sampler packs</a>
        <a href="/collections/all">All products</a>
      </nav>
      <nav class="hf__col" aria-labelledby="hf-science">
        <h2 id="hf-science">Transparency and science</h2>
        <a href="{%- assign hm_reviews_page = pages['reviews'] -%}{%- if hm_reviews_page.url != blank -%}{{ hm_reviews_page.url }}{%- else -%}/pages/contact?view=reviews{%- endif -%}">Customer reviews (4.8/5, {{ count | default: '2,050' }} verified)</a>
        <a href="/pages/contact?view=dandy2-kratom">What is kratom?</a>
        <a href="/pages/contact?view=dandy2-coa">Certificate of analysis (COA) lookup</a>
        <a href="/#dose">The dosage spectrum guide</a>
        <a href="/pages/contact?view=dandy2-shipping">State shipping restrictions</a>
        <a href="/pages/contact?view=dandy2-faq">Frequently asked questions</a>
      </nav>
      <nav class="hf__col" aria-labelledby="hf-company">
        <h2 id="hf-company">Company and trust</h2>
        <a href="/pages/contact?view=dandy2-about">About Dandy</a>
        <a href="/pages/contact?view=dandy2-returns">30-day money-back guarantee</a>
        <a href="/pages/contact?view=dandy2-shipping">Shipping and returns policy</a>
        <a href="/pages/contact?view=dandy2-subs">Subscription management and portal</a>
        <a href="/pages/contact?view=dandy2-terms">Terms of service</a>
        <a href="/pages/contact?view=dandy2-privacy">Privacy policy</a>
      </nav>
    </div>
    <div class="hf__legal">
      <p>21+ adults only. Keep out of reach of children. Read and follow all product label instructions carefully.</p>
      <p>Shipping restrictions: due to state and municipal statutory regulations, Dandy does not ship to Alabama, Arkansas, California, Connecticut, Indiana, Kansas, Louisiana, Mississippi, North Dakota, Nebraska, Rhode Island, Tennessee, Utah, Vermont, West Virginia, or Wisconsin. Please review our full <a href="/pages/contact?view=dandy2-shipping">shipping guide</a> before ordering.</p>
      <p>FDA disclaimer: these statements have not been evaluated by the Food and Drug Administration. These products are not intended to diagnose, treat, cure, or prevent any disease. Do not use if pregnant or nursing. Consult a healthcare professional prior to consumption if you have a medical condition or take prescription medication.</p>
      <div class="hf__end">
        <p>© {{ 'now' | date: '%Y' }} ForeverDandy Inc. All rights reserved.</p>
        {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="hf__pay" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            {%- if type == 'jcb' or type == 'diners_club' -%}{%- continue -%}{%- endif -%}
            <li>{{ type | payment_type_svg_tag: class: 'hf__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>
