{% comment %}
  DANDY 2026, side cart drawer.
  Rendered once per page via the chrome header. Reads the real Shopify cart and
  updates through the AJAX cart API. Because the catalog has no purchasable variants
  yet, append ?cartdemo=1 to any dandy2 URL to preview the populated design.
{% endcomment %}
<div class="d2cart" data-d2-cart hidden aria-hidden="true">
  <div class="d2cart__scrim" data-d2-cart-close></div>
  <div class="d2cart__panel" role="dialog" aria-modal="true" aria-label="Your bag">
    <header class="d2cart__head">
      <p class="d2cart__title">Your bag <span data-d2-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></p>
      <button type="button" class="d2cart__x" data-d2-cart-close aria-label="Close bag">×</button>
    </header>

    <div class="d2cart__nudge" data-d2-cart-nudge hidden>
      <p data-d2-cart-nudge-txt></p>
      <div class="d2cart__bar"><i data-d2-cart-bar></i></div>
    </div>

    <div class="d2cart__body" data-d2-cart-body>
      <p data-d2-cart-error role="alert" hidden></p>
      <div class="d2cart__empty" data-d2-cart-empty>
        <img src="{{ 'about-kratom-dandy2-rocky-peek.webp' | asset_url }}" alt="" width="560" height="468" aria-hidden="true">
        <p>Rocky checked. It’s empty.</p>
        <div class="d2cart__picks">
          <a href="/products/mixed-berry-kratom-gummies"><b>Gummies</b><span>from $39.99 a pouch</span></a>
          <a href="/products/premium-kratom-leaf-powder"><b>Powder</b><span>from $34.99</span></a>
          <a href="/products/extract-capsules"><b>Capsules</b><span>from $43.33 a jar</span></a>
        </div>
      </div>
      <ul class="d2cart__lines" data-d2-cart-lines hidden></ul>
    </div>

    <footer class="d2cart__foot" data-d2-cart-foot hidden>
      <div class="d2cart__row"><span>Subtotal</span><b data-d2-cart-total>$0.00</b></div>
      <p class="d2cart__ship"><b>Free standard shipping on orders over $99</b>, subscriptions, and 3- or 5-packs. Otherwise $5.95. Calculated at checkout.</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="cta">Checkout</button>
      </form>
      {% render 'about-kratom-chrome-trustbadges' %}
      <p class="d2cart__states">21+ only. We can’t ship to AL, AR, CA, CT, IN, KS, LA, MS, ND, NE, RI, TN, UT, VT, WV or WI, <a href="/pages/contact?view=dandy2-shipping">check before you pay</a>.</p>
    </footer>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const root = document.querySelector('[data-d2-cart]');
  if (!root) return;
  // The dedicated layout does not load the legacy PDP cart controller.
  const cartBase = {{ routes.cart_url | json }};
  const requestCart = async (url, options) => {
    const response = await fetch(url, options);
    if (!response.ok) throw new Error('Cart request failed: ' + response.status);
    return { cart: await response.json() };
  };
  const cartApi = {
    ensure: () => requestCart(cartBase + '.js'),
    change: (id, quantity) => requestCart(cartBase + '/change.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, quantity })
    })
  };
  const escapeHTML = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  const isDemo = new URLSearchParams(location.search).get('cartdemo') === '1';
  let pending = 0;
  const busy = () => root.querySelectorAll('button[name=checkout], [data-d2-inc], [data-d2-dec]').forEach(button => { button.disabled = pending > 0; });
  const money = c => '$' + (c / 100).toFixed(2);
  const el = s => root.querySelector(s);
  const lines = el('[data-d2-cart-lines]'), empty = el('[data-d2-cart-empty]'),
        foot = el('[data-d2-cart-foot]'), nudge = el('[data-d2-cart-nudge]');

  const updateCounts = (value) => {
    const count = Number(value) || 0;
    document.querySelectorAll('[data-d2-cart-count]').forEach(node => {
      node.textContent = String(count);
      node.hidden = count === 0;
    });
    document.querySelectorAll('[data-d2-cart-link]').forEach(link => {
      link.setAttribute('aria-label', count ? `Cart, ${count} item${count === 1 ? '' : 's'}` : 'Cart');
    });
  };

  const render = (cart) => {
    const items = cart.items || [];
    updateCounts(cart.item_count);
    const has = items.length > 0;
    empty.hidden = has; lines.hidden = !has; foot.hidden = !has;
    if (has) {
      lines.innerHTML = items.map(i => `
        <li class="d2line">
          <span class="d2line__img">${i.image ? `<img src="${escapeHTML(i.image.replace(/(\.[a-z]+)(\?|$)/i, '_160x$1$2'))}" alt="">` : ''}</span>
          <span class="d2line__bd">
            <span class="d2line__name">${escapeHTML(i.product_title)}</span>
            ${i.variant_title && !/default/i.test(i.variant_title) ? `<span class="d2line__var">${escapeHTML(i.variant_title)}</span>` : ''}
            ${i.selling_plan_allocation ? `<span class="d2line__plan">✓ ${escapeHTML(i.selling_plan_allocation.selling_plan.name)}</span>` : ''}
            <span class="d2line__row">
              <span class="d2qty">
                <button type="button" data-d2-dec="${escapeHTML(i.key)}" aria-label="Decrease">−</button>
                <b>${i.quantity}</b>
                <button type="button" data-d2-inc="${escapeHTML(i.key)}" aria-label="Increase">+</button>
              </span>
              <b class="d2line__price">${money(i.final_line_price)}</b>
            </span>
          </span>
        </li>`).join('');
      el('[data-d2-cart-total]').textContent = money(cart.total_price);
    }
    const gummies = items.filter(item => Number(item.product_id) === 8948156301490 && !item.selling_plan_allocation);
    const freePouch = gummies.some(item => Number(item.id) === 48043999068338);
    nudge.hidden = gummies.length === 0;
    if (gummies.length) {
      el('[data-d2-cart-nudge-txt]').innerHTML = freePouch
        ? '<b>Your free pouch is included</b> in your 3-pouch gummy pack.'
        : '<b>Buy 2, get 1 free</b> with the $119.98 3-pouch gummy pack.';
      el('[data-d2-cart-bar]').style.width = freePouch ? '100%' : '33%';
    }
    busy();
  };

  const refresh = async operation => {
    const focused = document.activeElement;
    const focusKey = focused?.dataset?.d2Inc || focused?.dataset?.d2Dec;
    const focusAttribute = focused?.dataset?.d2Inc ? 'data-d2-inc' : 'data-d2-dec';
    pending += 1;
    busy();
    el('[data-d2-cart-error]').hidden = true;
    try {
      const result = await operation();
      render(result.cart);
      document.dispatchEvent(new CustomEvent('d2:cart-updated', { detail: result.cart }));
    } catch (error) {
      console.error('Dandy cart update failed', error);
      el('[data-d2-cart-error]').textContent = 'We couldn’t update your bag. Please refresh and try again.';
      el('[data-d2-cart-error]').hidden = false;
    } finally {
      pending -= 1;
      busy();
      // Rendering replaces quantity buttons. Keep keyboard users inside the bag.
      if (focusKey && !root.hidden && !focused.isConnected && (document.activeElement === focused || document.activeElement === document.body)) {
        const replacement = [...root.querySelectorAll('[' + focusAttribute + ']')].find(button => button.getAttribute(focusAttribute) === focusKey);
        (replacement || el('button[data-d2-cart-close]')).focus();
      }
    }
  };
  // Opening or restoring the page must not race an in-flight cart mutation.
  const load = () => { if (!pending) return refresh(() => cartApi.ensure()); };

  let returnFocus;
  const open = (refresh = true) => {
    returnFocus = document.activeElement;
    root.hidden = false; root.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden';
    el('button[data-d2-cart-close]').focus();
    if (refresh) load();
  };
  const close = () => {
    root.hidden = true; root.setAttribute('aria-hidden', 'true'); document.body.style.overflow = '';
    if (returnFocus?.isConnected) returnFocus.focus();
  };
  root.addEventListener('keydown', event => {
    if (event.key !== 'Tab') return;
    const controls = [...root.querySelectorAll('a[href], button:not(:disabled), input:not(:disabled)')].filter(node => node.offsetParent !== null);
    const first = controls[0], last = controls[controls.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });
  root.querySelectorAll('[data-d2-cart-close]').forEach(b => b.addEventListener('click', close));
  addEventListener('keydown', e => { if (e.key === 'Escape' && !root.hidden) close(); });
  document.addEventListener('d2:cart-open', () => open());
  addEventListener('pageshow', () => { if (!isDemo) load(); });

  // header cart icon opens the drawer instead of navigating
  document.querySelectorAll('.d2head__cart').forEach(a => a.addEventListener('click', e => { e.preventDefault(); open(); }));

  // quantity controls
  root.addEventListener('click', e => {
    const inc = e.target.closest('[data-d2-inc]'), dec = e.target.closest('[data-d2-dec]');
    if (!inc && !dec) return;
    if (pending) return;
    const id = (inc || dec).dataset.d2Inc || (inc || dec).dataset.d2Dec;
    const cur = Number((inc || dec).parentElement.querySelector('b').textContent);
    const qty = inc ? cur + 1 : Math.max(0, cur - 1);
    refresh(() => cartApi.change(id, qty));
  });

  // preview the populated design while the catalog is still empty
  if (isDemo) {
    render({ item_count: 2, total_price: 10798, items: [
      { product_title: 'Mixed Berry Gummies', variant_title: '30-count', quantity: 1, final_line_price: 4799,
        image: null, selling_plan_allocation: { selling_plan: { name: 'Every 30 days · save 20%' } } },
      { product_title: 'Raw Leaf Powder', variant_title: '250 g', quantity: 1, final_line_price: 5499, image: null }
    ]});
    open(false);
  } else { load(); }
});
</script>
