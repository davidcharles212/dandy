{% doc %}
  Renders the product image gallery while preserving a genuine Shopify-media path.

  @param {product} product - Product whose media can render.
  @param {string} format - Fallback product format.
  @param {string} gallery_id - Unique gallery ID.
  @param {string} fallback_alt - Accessible fallback description.
  @param {boolean} [use_supplied_gallery] - Use the approved Dandy gummy source imagery.
{% enddoc %}

{% assign image_media = product.media | where: 'media_type', 'image' %}

<dandy-gallery class="dandy-gallery" id="DandyGallery-{{ gallery_id }}">
  <div class="dandy-gallery__stage">
    {% if use_supplied_gallery %}
      <div class="dandy-gallery__slide dandy-gallery__slide--pack" data-gallery-slide="media-1">
        <img src="{{ 'dandy-gummy-30.png' | asset_url }}" width="1000" height="1000" alt="{{ fallback_alt | escape }}" loading="eager" fetchpriority="high">
      </div>
      <div class="dandy-gallery__slide" data-gallery-slide="media-2" hidden>
        <picture>
          <source type="image/webp" srcset="{{ 'dandy-gummy-use-720.webp' | asset_url }} 720w, {{ 'dandy-gummy-use-1200.webp' | asset_url }} 1200w">
          <img src="{{ 'dandy-gummy-use-1200.jpg' | asset_url }}" width="1200" height="1200" alt="A person holding a Dandy mixed berry gummy pouch and gummy" loading="lazy">
        </picture>
      </div>
      <div class="dandy-gallery__slide" data-gallery-slide="media-3" hidden>
        <picture>
          <source type="image/webp" srcset="{{ 'dandy-gummy-closeup-720.webp' | asset_url }} 720w, {{ 'dandy-gummy-closeup-1200.webp' | asset_url }} 1200w">
          <img src="{{ 'dandy-gummy-closeup-1200.jpg' | asset_url }}" width="1200" height="1200" alt="A mixed berry gummy above an open Dandy pouch" loading="lazy">
        </picture>
      </div>
      <div class="dandy-gallery__slide dandy-gallery__slide--facts" data-gallery-slide="media-4" hidden>
        <picture>
          <source type="image/webp" srcset="{{ 'dandy-gummy-facts-720.webp' | asset_url }} 720w, {{ 'dandy-gummy-facts-1200.webp' | asset_url }} 1200w">
          <img src="{{ 'dandy-gummy-facts-1200.jpg' | asset_url }}" width="1200" height="1200" alt="Dandy gummy supplement facts panel" loading="lazy">
        </picture>
      </div>
    {% elsif image_media.size > 0 %}
      {% for media in image_media limit: 4 %}
        {% liquid
          assign image_loading = 'lazy'
          assign image_priority = 'auto'
          if forloop.first
            assign image_loading = 'eager'
            assign image_priority = 'high'
          endif
        %}
        <div class="dandy-gallery__slide" data-gallery-slide="media-{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %}>
          {{ media.preview_image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 1024px) 52vw, 100vw', loading: image_loading, fetchpriority: image_priority, alt: media.alt }}
        </div>
      {% endfor %}
    {% elsif format == 'powder' %}
      <div class="dandy-gallery__slide dandy-gallery__slide--pack" data-gallery-slide="media-1">
        <img src="{{ 'dandy-powder-100.png' | asset_url }}" width="1000" height="1000" alt="{{ fallback_alt | escape }}" loading="eager">
      </div>
    {% else %}
      <div class="dandy-gallery__slide dandy-gallery__slide--pack" data-gallery-slide="media-1">
        <img src="{{ 'dandy-gummy-30.png' | asset_url }}" width="1000" height="1000" alt="{{ fallback_alt | escape }}" loading="eager">
      </div>
    {% endif %}
  </div>

  <div class="dandy-gallery__thumbs" role="group" aria-label="Product media gallery">
    {% if use_supplied_gallery %}
      <button type="button" class="dandy-gallery__thumb" data-gallery-target="media-1" aria-current="true" aria-label="Show product pouch">
        <img src="{{ 'dandy-gummy-30.png' | asset_url }}" width="120" height="120" alt="">
      </button>
      <button type="button" class="dandy-gallery__thumb" data-gallery-target="media-2" aria-current="false" aria-label="Show gummy in use">
        <img src="{{ 'dandy-gummy-use-720.webp' | asset_url }}" width="120" height="120" alt="">
      </button>
      <button type="button" class="dandy-gallery__thumb" data-gallery-target="media-3" aria-current="false" aria-label="Show gummy closeup">
        <img src="{{ 'dandy-gummy-closeup-720.webp' | asset_url }}" width="120" height="120" alt="">
      </button>
      <button type="button" class="dandy-gallery__thumb" data-gallery-target="media-4" aria-current="false" aria-label="Show supplement facts">
        <img src="{{ 'dandy-gummy-facts-720.webp' | asset_url }}" width="120" height="120" alt="">
      </button>
    {% elsif image_media.size > 0 %}
      {% for media in image_media limit: 4 %}
        <button type="button" class="dandy-gallery__thumb" data-gallery-target="media-{{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show product image {{ forloop.index }}">
          {{ media.preview_image | image_url: width: 160 | image_tag: width: 120, height: 120, loading: 'lazy', alt: '' }}
        </button>
      {% endfor %}
    {% else %}
      <button type="button" class="dandy-gallery__thumb" data-gallery-target="media-1" aria-current="true" aria-label="Show product pouch">
        <span>01</span>
      </button>
    {% endif %}
  </div>
</dandy-gallery>
