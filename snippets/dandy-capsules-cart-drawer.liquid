{%- comment -%} The Dandy side cart (Ecom Landers drawer). Rendered by the capsule PDP header and, since 2026-09-13, by snippets/dandy2-chrome-header.liquid on every dandy2 page; snippets/dandy2-cart-drawer.liquid is the retired older bag. {%- endcomment -%}

{{ 'dandy2-cart-drawer.css' | asset_url | stylesheet_tag }}
<div
  class="dcart"
  data-d2-cart
  data-root-url="{{ routes.root_url }}"
  data-change-url="{{ routes.cart_change_url }}.js"
  data-cart-url="{{ routes.cart_url }}.js"
  data-add-url="{{ routes.cart_add_url }}.js"
  hidden
  aria-hidden="true"
>
  <div class="dcart__scrim" data-d2-cart-close></div>
  <div class="dcart__panel" role="dialog" aria-modal="true" aria-labelledby="DcartTitle" data-dcart-panel>
    {% render 'dandy2-cart-drawer-inner' %}
  </div>
  <p class="dcart-sr" aria-live="polite" data-dcart-status></p>
</div>
<script src="{{ 'dandy2-cart-drawer.js' | asset_url }}" defer></script>
