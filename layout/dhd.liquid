<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  {%- render 'dandy-bundle-gate' -%}
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page_title }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="robots" content="noindex">
  <meta property="og:title" content="{{ page_title | escape }}">
  {%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
  <meta property="og:image" content="{{ 'dhd-hero-morning-r20.webp' | asset_url }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700;8..60,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {{ 'dhd.css' | asset_url | stylesheet_tag }}
  {%- comment -%} Reveal motion is opt-in from the script’s side. The class arms the hidden state; if dhd.js has not
      reported in within 3 seconds (blocked, failed, or slow CDN) the class comes off and the article renders in full,
      so paid traffic can never meet a blank page. No JavaScript at all: the class is never set. {%- endcomment -%}
  <script>document.documentElement.classList.add('dhd-js');setTimeout(function(){if(!window.__dhdReady){document.documentElement.classList.remove('dhd-js');}},3000);</script>
  {{ content_for_header }}
  {%- comment -%} Whop ads pixel (account biz_9EucgaXdTemeix). Source: docs.whop.com/developer/ads/platforms/shopify. Lives in layout/theme.liquid before </head>. {%- endcomment -%}
  <script>
  !function(w,d,s,u,n,a,b){if(w[n])return;a=w[n]={q:[],t:+new Date,s:[],o:u,track:function(){a.q.push([+new Date].concat([].slice.call(arguments)))},setScope:function(){a.s=[].slice.call(arguments).filter(function(x){return typeof x==="string"});a.q.push([+new Date,"setScope"].concat(a.s))},scope:function(){var c=[].slice.call(arguments);return{track:function(){a.q.push([+new Date].concat([].slice.call(arguments)).concat([{__scope:c}]))}}}};b=d.createElement(s);b.async=1;b.src=u+"/s.js";d.getElementsByTagName(s)[0].parentNode.insertBefore(b,d.getElementsByTagName(s)[0])}(window,document,"script","https://t.whop.tw","whop");
  whop.setScope("biz_9EucgaXdTemeix");
  whop.track("page");
  </script>
</head>
<body class="dhd-body">
  {{ content_for_layout }}
  <script src="{{ 'dandy-kit.js' | asset_url }}" defer></script>
  <script src="{{ 'dhd.js' | asset_url }}" defer></script>
  {% if request.path == '/pages/jack' %}
    <script src="{{ 'dandy-jack-tracking.js' | asset_url }}" defer></script>
  {% endif %}
</body>
</html>
