<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  {%- render 'dandy-bundle-gate' -%}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>About Dandy | Kratom, without the games.</title>
  <meta name="description" content="Kratom, honestly. Explore Dandy's gummies, extract capsules and raw leaf powder, published potency reports, and the story behind Rocky.">
  <link rel="canonical" href="https://foreverdandy.com/pages/about">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://foreverdandy.com">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800;900&amp;family=Barlow:wght@400;600;700&amp;display=swap" rel="stylesheet">
  {{ 'dandy-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'dandy2.css' | asset_url | stylesheet_tag }}
  {{ 'dandy-about.css' | asset_url | stylesheet_tag }}
